<!-- Font Awesome CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<main class="class-page" data-year-id="<%= selectedYearId || '' %>">
    <header class="class-header">
        <span class="class-eyebrow glv-page-label"><i class="fa-solid fa-layer-group"></i> Quản lý lớp học</span>
        <h1>Danh sách thiếu nhi</h1>
        <p>Xem hồ sơ, phụ huynh và bí tích của các em trong lớp được phân công.</p>
        <label class="class-search" for="class-student-search"><i class="fa-solid fa-magnifying-glass"></i> Tìm kiếm thiếu nhi
            <input id="class-student-search" type="search" data-table-search="[data-class-student-row]" data-search-groups="[data-class-card]" data-search-empty="#class-search-empty" placeholder="Tên hoặc mã số..." autocomplete="off">
        </label>
    </header>

    <% if (error) { %><p class="detail-error"><i class="fa-solid fa-circle-exclamation"></i> <%= error %></p><% } %>
    <% if (!classes.length) { %>
        <div class="empty-state"><i class="fa-solid fa-triangle-exclamation"></i> Bạn chưa được phân công lớp trong niên khóa này.</div>
    <% } else { %>
        <div class="class-list">
            <% classes.forEach(classItem => { %>
                <section class="class-card" data-class-card>
                    <div class="class-card-header">
                        <h2><i class="fa-solid fa-school"></i> <%= classItem.ten_khoi %> - <%= classItem.ten_lop %></h2>
                        <span><i class="fa-solid fa-users"></i> <%= classItem.student_count %> thiếu nhi</span>
                    </div>
                    <% if (!classItem.students.length) { %>
                        <div class="empty-state">Lớp chưa có danh sách thiếu nhi.</div>
                    <% } else { %>
                        <div class="table-wrap">
                            <table class="student-table">
                                <thead><tr><th>Họ và tên</th><th>Mã số</th><th>Ngày sinh</th><th>Trạng thái</th><th></th></tr></thead>
                                <tbody>
                                    <% classItem.students.forEach(student => { %>
                                        <tr data-class-student-row data-search="<%= `${student.mstn || ''} ${student.ten_thanh || ''} ${student.ho_va_ten_lot || ''} ${student.ten || ''}`.toLowerCase() %>">
                                            <td data-label="Họ và tên"><strong><%= [student.ten_thanh, student.ho_va_ten_lot, student.ten].filter(Boolean).join(' ') %></strong></td>
                                            <td data-label="Mã số"><%= student.mstn || '-' %></td>
                                            <td data-label="Ngày sinh">
                                                <% 
                                                    let formattedDob = '-';
                                                    if (student.ngay_sinh) {
                                                        const parts = String(student.ngay_sinh).slice(0, 10).split('-');
                                                        if (parts.length === 3) formattedDob = `${parts[2]}/${parts[1]}/${parts[0]}`;
                                                    }
                                                %>
                                                <%= formattedDob %>
                                            </td>
                                            <td data-label="Trạng thái" class="student-status <%= student.trang_thai === 'Đang học' ? '' : 'is-inactive' %>"><%= student.trang_thai %></td>
                                            <td class="student-actions">
                                                <button class="detail-button" type="button" data-student-id="<%= student.id_tn %>"><i class="fa-solid fa-id-card"></i> Xem chi tiết</button>
                                                <button class="status-button" type="button" data-status-id="<%= student.id_tn %>" data-current-status="<%= student.trang_thai %>"><i class="fa-solid fa-user-pen"></i> Cập nhật trạng thái</button>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } %>
                </section>
            <% }) %>
        </div>
        <%- include('../partials/pagination', {
            mode: 'client',
            currentPage: 1,
            totalPages: Math.max(Math.ceil(classes.reduce((count, classItem) => count + classItem.students.length, 0) / 25), 1),
            totalItems: classes.reduce((count, classItem) => count + classItem.students.length, 0),
            pageSize: 25,
            rows: '[data-class-student-row]',
            groups: '[data-class-card]'
        }) %>
        <div class="empty-state search-hidden" id="class-search-empty">Không tìm thấy thiếu nhi phù hợp.</div>
    <% } %>
</main>

<script src="/js/table-search.js" defer></script>

<%- include('../partials/student-profile-modal', {
    modalClass: 'student-modal',
    modalId: 'student-modal',
    bodyId: 'modal-body',
    titleId: 'modal-title',
    modalElement: 'dialog',
    showHistory: false,
    allowEdit: true,
    closeClass: 'modal-button secondary',
    cancelId: 'modal-cancel'
}) %>

<dialog class="student-modal status-modal" id="status-modal">
    <div class="modal-header">
        <div><span><i class="fa-solid fa-user-gear"></i> Cập nhật hồ sơ</span><h2 id="status-modal-title">Trạng thái thiếu nhi</h2></div>
        <button class="modal-close status-modal-close" type="button" aria-label="Đóng">&times;</button>
    </div>
    <div class="modal-body">
        <label class="detail-field"><span>Trạng thái</span><select id="status-value"><option>Đang học</option><option>Chuyển xứ</option><option>Nghỉ học</option></select></label>
        <p class="detail-error" id="status-error" hidden></p>
    </div>
    <div class="modal-footer">
        <button class="modal-button secondary status-modal-close" type="button">Hủy</button>
        <button class="modal-button primary" id="status-save" type="button"><i class="fa-solid fa-floppy-disk"></i> Lưu trạng thái</button>
    </div>
</dialog>

<script src="/js/glv/glv-danh-sach-lop.js" defer></script>