<main class="glv-dashboard">
  <header class="dashboard-hero">
    <div>
      <h1>
        Xin chào, <%= [user.ten_thanh, user.ten].filter(Boolean).join(' ') || 'Giáo lý viên' %>
      </h1>

      <p>
        <%= year ? `Niên khóa ${year.nien_khoa}` : 'Chưa có niên khóa được phân công' %>
      </p>

      <% if (classes && classes.length > 0) { %>
        <p class="header-classes">
          <strong>Lớp phụ trách:</strong>
          <%= classes.map(c => `${c.ten_khoi} - ${c.ten_lop}`).join(' | ') %>
        </p>
      <% } %>
    </div>

    <a class="dashboard-action" href="/glv/diem-danh/qr">
      <i class="fa-solid fa-qrcode"></i>
      Quét QR điểm danh
    </a>
  </header>

  <% if (!classes.length) { %>
    <section class="dashboard-empty">
      <i class="fa-solid fa-school"></i>
      <h2>Chưa có lớp phụ trách</h2>
      <p>Bạn chưa được phân công lớp trong niên khóa hiện tại.</p>
    </section>
  <% } else { %>

    <%
      // Tính tổng thống kê thiếu nhi, nam, nữ
      const stats = {
        totalThieuNhi: classes.reduce((sum, c) => sum + c.student_count, 0),
        maleCount: classes.reduce((sum, c) => sum + c.male_count, 0),
        femaleCount: classes.reduce((sum, c) => sum + c.female_count, 0)
      };
    %>

    <!-- Phần thống kê tổng hợp -->
    <section class="dashboard-section">
      <div class="section-heading">
        <div>
          <span class="dashboard-eyebrow">Tổng quan</span>
          <h2>Thống kê thiếu nhi</h2>
        </div>
      </div>

      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-icon">
            <i class="fa-solid fa-child-reaching"></i>
          </div>

          <div class="stat-info">
            <h3>Tổng số Thiếu nhi</h3>
            <p class="stat-number"><%= stats.totalThieuNhi %></p>
            <span class="stat-desc">Trong các lớp của tôi</span>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon">
            <i class="fa-solid fa-mars text-sky-500"></i>
          </div>

          <div class="stat-info">
            <h3>Nam</h3>
            <p class="stat-number"><%= stats.maleCount %></p>
            <span class="stat-desc">Thiếu nhi nam</span>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon">
            <i class="fa-solid fa-venus text-rose-500"></i>
          </div>

          <div class="stat-info">
            <h3>Nữ</h3>
            <p class="stat-number"><%= stats.femaleCount %></p>
            <span class="stat-desc">Thiếu nhi nữ</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Phần điểm danh và cảnh báo -->
    <section class="dashboard-section dashboard-two-col">
      <article class="dashboard-panel attendance-panel">
        <div class="panel-heading">
          <div>
            <span class="dashboard-eyebrow">Theo dõi hôm nay</span>
            <h2>Điểm danh gần nhất</h2>
          </div>

          <i class="fa-solid fa-calendar-day"></i>
        </div>

        <% if (!attendance) { %>
          <div class="panel-empty">
            Chưa có buổi điểm danh nào được ghi nhận.
          </div>
        <% } else { %>

          <div class="attendance-focus">
            <div class="attendance-date">
              <strong>
                <%= new Date(attendance.ngay_diem_danh).toLocaleDateString('vi-VN') %>
              </strong>
              <span><%= attendance.loai_buoi %></span>
            </div>

            <span class="attendance-badge <%= attendance.marked_count === attendance.total_count
              ? 'attendance-badge--complete'
              : 'attendance-badge--incomplete' %>">
              Đã lưu <%= attendance.marked_count %>/<%= attendance.total_count %>
            </span>
          </div>

          <div class="attendance-numbers">
            <div>
              <strong><%= attendance.present_count %></strong>
              <span>Có mặt</span>
            </div>

            <div>
              <strong><%= attendance.absent_count %></strong>
              <span>Vắng</span>
            </div>
          </div>

        <% } %>

        <a class="panel-link" href="/glv/diem-danh">
          <i class="fa-solid fa-arrow-right"></i>
          Mở trang điểm danh
        </a>
      </article>

      <article class="dashboard-panel alerts-panel">
        <div class="panel-heading">
          <div>
            <span class="dashboard-eyebrow">Cần quan tâm</span>
            <h2>Cảnh báo trong lớp</h2>
          </div>

          <i class="fa-solid fa-bell"></i>
        </div>

        <div class="alert-tabs" role="tablist" aria-label="Nhóm cảnh báo">
          <button type="button" class="alert-tab is-active" id="attendance-alert-tab" role="tab"
            aria-selected="true" aria-controls="attendance-alert-panel" tabindex="0">
            Chuyên cần <span><%= attendanceAlerts.length %></span>
          </button>
          <button type="button" class="alert-tab" id="discipline-alert-tab" role="tab"
            aria-selected="false" aria-controls="discipline-alert-panel" tabindex="-1">
            Kỷ luật <span><%= disciplineAlerts.length %></span>
          </button>
          <button type="button" class="alert-tab" id="score-alert-tab" role="tab"
            aria-selected="false" aria-controls="score-alert-panel" tabindex="-1">
            Học tập <span><%= scoreAlerts.length %></span>
          </button>
        </div>

        <section class="alert-tab-panel" id="attendance-alert-panel" role="tabpanel"
          aria-labelledby="attendance-alert-tab" tabindex="0">
          <% if (!attendanceAlerts.length) { %>
            <p class="panel-empty">Chưa có em nào có điểm chuyên cần dưới 5.</p>
          <% } else { %>
            <div class="alert-table-wrap">
              <table class="alert-table">
                <thead>
                  <tr><th>Mã TN</th><th>Họ tên</th><th>Điểm chuyên cần</th></tr>
                </thead>
                <tbody>
                  <% attendanceAlerts.forEach(item => { %>
                    <tr>
                      <td><%= item.mstn || '-' %></td>
                      <td><%= item.ho_ten %></td>
                      <td><%= item.diem_chuyen_can %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </section>

        <section class="alert-tab-panel" id="discipline-alert-panel" role="tabpanel"
          aria-labelledby="discipline-alert-tab" tabindex="0" hidden>
          <% if (!disciplineAlerts.length) { %>
            <p class="panel-empty">Chưa có em nào có điểm kỷ luật trung bình dưới 7.</p>
          <% } else { %>
            <div class="alert-table-wrap">
              <table class="alert-table">
                <thead>
                  <tr><th>Mã TN</th><th>Họ tên</th><th>Điểm kỷ luật trung bình</th></tr>
                </thead>
                <tbody>
                  <% disciplineAlerts.forEach(item => { %>
                    <tr>
                      <td><%= item.mstn || '-' %></td>
                      <td><%= item.ho_ten %></td>
                      <td><%= item.diem_ky_luat %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </section>

        <section class="alert-tab-panel" id="score-alert-panel" role="tabpanel"
          aria-labelledby="score-alert-tab" tabindex="0" hidden>
          <% if (!scoreAlerts.length) { %>
            <p class="panel-empty">Chưa có em nào có điểm học tập dưới 5.</p>
          <% } else { %>
            <div class="alert-table-wrap">
              <table class="alert-table">
                <thead>
                  <tr><th>Mã TN</th><th>Họ tên</th><th>Điểm học tập</th></tr>
                </thead>
                <tbody>
                  <% scoreAlerts.forEach(item => { %>
                    <tr>
                      <td><%= item.mstn || '-' %></td>
                      <td><%= item.ho_ten %></td>
                      <td><%= item.diem_hoc_tap %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </section>
      </article>
    </section>

  <% } %>
</main>
<script src="/js/glv/glv-dashboard.js" defer></script>