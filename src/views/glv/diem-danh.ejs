<!-- Font Awesome CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<link rel="stylesheet" href="/css/reset.css">
<link rel="stylesheet" href="/css/glv/glv-diem-danh.css">

<main class="attendance-page">
    <header class="class-header">
        <span class="class-eyebrow"><i class="fa-solid fa-layer-group"></i> Quản lý lớp học</span>
        <h1>Điểm danh thiếu nhi</h1>
    </header>

    <% if (!classes.length) { %>
        <div class="attendance-empty"><i class="fa-solid fa-triangle-exclamation"></i> Bạn chưa được phân công lớp trong niên khóa này.</div>
    <% } else { %>
        <form class="attendance-toolbar" method="GET" action="/glv/diem-danh" id="attendance-filter">
            <div class="attendance-field">
                <label for="attendance-search"><i class="fa-solid fa-magnifying-glass"></i> Tìm kiếm thiếu nhi</label>
                <input id="attendance-search" type="search" placeholder="Tên hoặc mã số..." autocomplete="off">
            </div>
            <div class="attendance-field">
                <label for="attendance-class"><i class="fa-solid fa-school"></i> Lớp</label>
                <select id="attendance-class" name="id_lop" required>
                    <% classes.forEach(item => { %>
                        <option value="<%= item.id_lop %>" <%= item.id_lop === selectedClassId ? 'selected' : '' %>><%= item.ten_khoi %> - <%= item.ten_lop %></option>
                    <% }) %>
                </select>
            </div>
            <div class="attendance-field">
                <label for="attendance-type"><i class="fa-solid fa-clock"></i> Loại buổi</label>
                <select id="attendance-type" name="loai_buoi" required>
                    <% if (!sessionTypes.length) { %>
                        <option value="">Ngày không khớp lịch</option>
                    <% } %>
                    <% sessionTypes.forEach(type => { %>
                        <option value="<%= type %>" <%= type === sessionType ? 'selected' : '' %>><%= type %></option>
                    <% }) %>
                </select>
            </div>
            <div class="attendance-field">
                <label for="attendance-date"><i class="fa-solid fa-calendar-day"></i> Ngày điểm danh</label>
                <input id="attendance-date" type="date" name="ngay_diem_danh" value="<%= selectedDate %>" required>
            </div>
            <button class="attendance-save-button" type="submit"><i class="fa-solid fa-filter"></i> Xem danh sách</button>
        </form>

        <% if (scanMode) { %>
            <section class="qr-attendance-panel" aria-labelledby="qr-attendance-title">
                <div class="qr-panel-heading">
                    <div>
                        <span class="class-eyebrow"><i class="fa-solid fa-camera"></i> Điểm danh tức thì</span>
                        <h2 id="qr-attendance-title">Quét mã QR từng thiếu nhi</h2>
                        <p>Quét xong mã nào, hệ thống sẽ ghi nhận mã đó ngay.</p>
                    </div>
                    <button class="attendance-save-button qr-stop-button" id="qr-stop-button" type="button" disabled><i class="fa-solid fa-stop"></i> Dừng camera</button>
                </div>
                <div class="qr-scanner-layout">
                    <div id="qr-reader" class="qr-reader"></div>
                    <div class="qr-scan-status" id="qr-scan-status"><i class="fa-solid fa-circle-info"></i> Đang khởi tạo camera...</div>
                </div>
                <div id="qr-toast" class="qr-toast" role="status" aria-live="polite"></div>
            </section>
            <script src="/vendor/html5-qrcode/html5-qrcode.min.js"></script>
        <% } %>

        <form method="POST" action="/glv/diem-danh/save">
            <input type="hidden" name="nien_khoa" value="<%= selectedYearId %>">
            <input type="hidden" name="id_lop" value="<%= selectedClassId %>">
            <input type="hidden" name="loai_buoi" value="<%= sessionType %>">
            <input type="hidden" name="ngay_diem_danh" value="<%= selectedDate %>">
            
            <div class="attendance-summary">
                <span><i class="fa-solid fa-circle-info"></i> <strong><%= classes.find(item => item.id_lop === selectedClassId)?.ten_lop %></strong> · <%= sessionType || 'Chưa chọn loại buổi' %> · <strong><%= selectedDate %></strong></span>
                <button class="attendance-save-button" type="submit" <%= !sessionType ? 'disabled' : '' %>><i class="fa-solid fa-floppy-disk"></i> Lưu điểm danh</button>
            </div>

            <% if (!students.length) { %>
                <div class="attendance-empty"><i class="fa-solid fa-user-slash"></i> Lớp chưa có thiếu nhi đang học.</div>
            <% } else { %>
                <div class="attendance-table-wrap">
                    <table class="attendance-table">
                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Mã TN</th>
                                <th>Tên Thánh & Họ Tên</th>
                                <th>Trạng thái</th>
                                <th>Điểm danh</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% students.forEach((student, index) => { %>
                                <tr data-attendance-row data-search="<%= `${student.mstn || ''} ${student.ten_thanh || ''} ${student.ho_va_ten_lot || ''} ${student.ten || ''}`.toLowerCase() %>">
                                    <td><%= index + 1 %></td>
                                    <td><%= student.mstn || '-' %></td>
                                    <td><strong><%= [student.ten_thanh, student.ho_va_ten_lot, student.ten].filter(Boolean).join(' ') %></strong></td>
                                    <td class="attendance-status <%= student.trang_thai === 'Đang học' ? '' : 'inactive' %>"><%= student.trang_thai %></td>
                                    <td>
                                        <fieldset class="attendance-options">
                                            <legend class="visually-hidden">Trạng thái điểm danh</legend>
                                            <label><input type="radio" name="attendance[<%= index %>][trang_thai]" value="Có mặt" <%= student.da_luu && student.trang_thai_diem_danh === 'Có mặt' ? 'checked' : '' %>><span>Có mặt</span></label>
                                            <label><input type="radio" name="attendance[<%= index %>][trang_thai]" value="Đi sớm" <%= student.da_luu && student.trang_thai_diem_danh === 'Đi sớm' ? 'checked' : '' %>><span>Đi sớm</span></label>
                                            <label><input type="radio" name="attendance[<%= index %>][trang_thai]" value="Vắng phép" <%= student.da_luu && student.trang_thai_diem_danh === 'Vắng phép' ? 'checked' : '' %>><span>Vắng phép</span></label>
                                            <label><input type="radio" name="attendance[<%= index %>][trang_thai]" value="Vắng không phép" <%= student.da_luu && student.trang_thai_diem_danh === 'Vắng không phép' ? 'checked' : '' %>><span>Vắng không phép</span></label>
                                        </fieldset>
                                        <input type="hidden" name="attendance[<%= index %>][id_tn]" value="<%= student.id_tn %>">
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </form>
    <% } %>
</main>

<script>
(() => {
    const search = document.getElementById('attendance-search');
    const normalize = value => String(value || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    const type = document.getElementById('attendance-type');
    const date = document.getElementById('attendance-date');
    const filter = document.getElementById('attendance-filter');
    const classSelect = document.getElementById('attendance-class');
    const targetDays = { 'Lễ Thứ 3': 2, 'Lễ Thứ 5': 4, 'Lễ Chúa Nhật': 0, 'Học Giáo Lý': 0 };
    const smartDate = sessionType => { const current = new Date(); current.setDate(current.getDate() - ((current.getDay() - targetDays[sessionType] + 7) % 7)); return `${current.getFullYear()}-${String(current.getMonth() + 1).padStart(2, '0')}-${String(current.getDate()).padStart(2, '0')}`; };
    type?.addEventListener('change', () => { date.value = smartDate(type.value); filter.submit(); });
    date?.addEventListener('change', () => { filter.submit(); });
    classSelect?.addEventListener('change', () => { filter.submit(); });
    search?.addEventListener('input', () => { const keyword = normalize(search.value.trim()); document.querySelectorAll('[data-attendance-row]').forEach(row => { row.classList.toggle('search-hidden', Boolean(keyword) && !normalize(row.dataset.search).includes(keyword)); }); });
})();
</script>

<% if (scanMode && selectedClassId && sessionType) { %>
<script>
(() => {
    const readerElement = document.getElementById('qr-reader');
    const statusElement = document.getElementById('qr-scan-status');
    const stopButton = document.getElementById('qr-stop-button');
    const toast = document.getElementById('qr-toast');
    const scanUrl = '/glv/diem-danh/scan';
    let scanner;
    let requestInFlight = false;
    let lastCode = '';
    let lastScanAt = 0;
    let toastTimer;

    const showToast = (message, type) => {
        toast.textContent = message;
        toast.className = `qr-toast is-visible ${type}`;
        window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => { toast.className = 'qr-toast'; }, 2600);
    };

    const setStatus = (message, isError = false) => {
        statusElement.innerHTML = `<i class="fa-solid ${isError ? 'fa-circle-exclamation' : 'fa-camera'}"></i> ${message}`;
        statusElement.classList.toggle('is-error', isError);
    };

    const sendScan = async decodedText => {
        const now = Date.now();
        if (requestInFlight || (decodedText === lastCode && now - lastScanAt < 3500)) return;
        requestInFlight = true;
        lastCode = decodedText;
        lastScanAt = now;
        setStatus('Đang gửi kết quả quét...');

        try {
            const response = await fetch(scanUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({
                    qr_value: decodedText,
                    nien_khoa: '<%= selectedYearId %>',
                    id_lop: '<%= selectedClassId %>',
                    loai_buoi: '<%= sessionType %>',
                    ngay_diem_danh: '<%= selectedDate %>'
                })
            });
            const result = await response.json();
            if (!response.ok || !result.success) throw new Error(result.message || 'QR không hợp lệ.');
            showToast(`Đã điểm danh ${result.status}: ${result.student.name}`, 'success');
            setStatus(`Đã ghi nhận ${result.status}. Mời quét mã tiếp theo.`);
        } catch (error) {
            showToast(error.message || 'Quét QR thất bại.', 'error');
            setStatus('Mã vừa quét chưa được ghi nhận. Mời thử lại.', true);
        } finally {
            requestInFlight = false;
        }
    };

    const startScanner = async () => {
        if (!window.Html5Qrcode) {
            setStatus('Không tải được thư viện quét QR.', true);
            showToast('Không thể khởi tạo camera.', 'error');
            return;
        }
        scanner = new Html5Qrcode('qr-reader');
        try {
            await scanner.start(
                { facingMode: 'environment' },
                { fps: 10, qrbox: { width: 250, height: 250 } },
                sendScan,
                () => {}
            );
            stopButton.disabled = false;
            setStatus('Camera đang sẵn sàng. Đưa mã QR vào khung quét.');
        } catch (error) {
            setStatus('Không thể mở camera. Hãy cấp quyền camera và dùng HTTPS hoặc localhost.', true);
            showToast('Không thể mở camera.', 'error');
        }
    };

    stopButton.addEventListener('click', async () => {
        if (!scanner) return;
        await scanner.stop();
        stopButton.disabled = true;
        setStatus('Camera đã dừng. Tải lại trang để quét tiếp.');
    });

    startScanner();
})();
</script>
<% } %>