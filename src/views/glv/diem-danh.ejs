<style>
    .attendance-date-context {
        width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-top: -2.5rem;
        border-radius: 3rem 3rem 0 0;
        border-bottom-width: 0;
    }
    #attendance-context-sticky {
        position: sticky;
        top: 68px;
        z-index: 20;
        width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-top: -1.5rem;
        border-radius: 0 0 3rem 3rem;
        border-top-width: 0;
    }
    #attendance-picker-dialog {
        position: fixed;
        inset: auto 0 0;
        width: 100%;
        max-width: none;
        max-height: min(80vh, 38rem);
        max-height: min(80dvh, 38rem);
        margin: 0;
        padding: 0;
        overflow-y: auto;
        border: 0;
        border-radius: 1.5rem 1.5rem 0 0;
        background: #fff;
        box-shadow: 0 -12px 40px rgb(15 23 42 / 18%);
        animation: attendance-sheet-in 180ms ease-out;
    }
    #attendance-picker-dialog::backdrop { background: rgb(15 23 42 / 50%); }
    @keyframes attendance-sheet-in {
        from { transform: translateY(1.5rem); opacity: 0.8; }
        to { transform: translateY(0); opacity: 1; }
    }
    @media (min-width: 640px) and (max-width: 1024px) {
        #attendance-picker-dialog {
            right: auto;
            left: 50%;
            width: min(36rem, calc(100vw - 2rem));
            border-radius: 1.5rem 1.5rem 0 0;
            transform: translateX(-50%);
        }
    }
    @media (min-width: 1025px) {
        #attendance-picker-dialog { display: none; }
        #attendance-save-form .attendance-options {
            min-width: 29rem;
            flex-wrap: nowrap;
            gap: 0;
            padding: 0.25rem;
            border-radius: 0.75rem;
            background: #f1f5f9;
        }
        #attendance-save-form .attendance-options label {
            min-height: 2.5rem;
            flex: 1 1 auto;
            justify-content: center;
            padding: 0.5rem 0.65rem;
            border: 1px solid transparent;
            border-radius: 0.5rem;
            background: transparent;
            color: #475569;
            font-size: 0.8125rem;
            white-space: nowrap;
        }
        #attendance-save-form .attendance-options label:has(input:checked) {
            border-color: #e2e8f0;
            background: #fff;
            color: #1d4ed8;
            box-shadow: 0 1px 2px rgb(15 23 42 / 10%);
        }
        #attendance-save-form .attendance-options label:has(input:focus-visible) {
            outline: 2px solid #3b82f6;
            outline-offset: 2px;
        }
        #attendance-save-form .attendance-options input {
            position: absolute;
            width: 1px;
            height: 1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            clip-path: inset(50%);
        }
    }
    @media (min-width: 640px) {
        .attendance-date-context { margin-top: -3rem; }
    }
    @media (min-width: 768px) { #attendance-context-desktop-controls { display: flex; } }
    @media (min-width: 1025px) {
        #attendance-context-sticky {
            top: 98px;
            width: calc(100vw - 280px);
            margin-left: calc(50% - 50vw + 140px);
        }
        .attendance-date-context {
            width: calc(100vw - 280px);
            margin-left: calc(50% - 50vw + 140px);
            margin-top: -3rem;
        }
    }
</style>
<main class="min-h-screen bg-slate-50 text-slate-800 flex flex-col antialiased pb-16 [&_.search-hidden]:hidden!">

    <div class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col gap-6">
    <% if (!classes.length) { %>
        <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center text-slate-500 shadow-sm"><i class="fa-solid fa-triangle-exclamation mr-2 text-amber-500"></i> Bạn chưa được phân công lớp trong niên khóa này.</div>
    <% } else { %>
        <% const attendanceSavedCount = students.filter(student => student.da_luu).length; %>
        <% const attendanceSaved = students.length > 0 && attendanceSavedCount === students.length; %>
        <form id="attendance-filter" method="GET" action="/glv/diem-danh" class="contents">
            <input type="hidden" name="nien_khoa" value="<%= selectedYearId %>">
            <input id="attendance-class" type="hidden" name="id_lop" value="<%= selectedClassId %>">
            <div class="attendance-date-context border border-slate-200 bg-white px-4 py-4 shadow-sm sm:px-6 sm:py-5 lg:px-8">
                <div class="flex flex-col gap-2 md:flex-row md:items-end">
                    <div id="attendance-context-desktop-controls" class="hidden items-end gap-3">
                        <div class="flex flex-col gap-1">
                            <label for="attendance-date" class="text-xs font-semibold text-slate-600">Ngày điểm danh</label>
                            <input id="attendance-date" name="ngay_diem_danh" type="date" value="<%= selectedDate %>" max="<%= todayKey %>"
                                class="h-11 rounded-lg border border-slate-200 bg-slate-100 px-3 text-sm font-medium text-slate-700 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20">
                        </div>
                        <div class="flex flex-col gap-1">
                            <label for="attendance-type" class="text-xs font-semibold text-slate-600">Loại buổi</label>
                            <select id="attendance-type" name="loai_buoi" class="h-11 max-w-48 rounded-lg border border-slate-200 bg-slate-100 px-3 text-sm font-medium text-slate-700 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20">
                                <% if (!sessionTypes.length) { %><option value="">Ngày không khớp lịch</option><% } %>
                                <% sessionTypes.forEach(type => { %>
                                    <option value="<%= type %>" <%= type === sessionType ? 'selected' : '' %>><%= type %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-2 md:hidden">
                        <div class="min-w-0">
                            <label for="attendance-date-mobile" class="mb-1 block text-xs font-semibold text-slate-600">Ngày điểm danh</label>
                            <input id="attendance-date-mobile" type="date" value="<%= selectedDate %>" max="<%= todayKey %>"
                                class="h-10 w-full rounded-lg border border-slate-200 bg-slate-100 px-3 text-sm font-medium text-slate-700 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20">
                        </div>
                        <div class="min-w-0">
                            <label for="attendance-type-mobile" class="mb-1 block text-xs font-semibold text-slate-600">Loại buổi</label>
                            <select id="attendance-type-mobile" class="h-10 w-full rounded-lg border border-slate-200 bg-slate-100 px-3 text-sm font-medium text-slate-700 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20">
                                <% if (!sessionTypes.length) { %><option value="">Ngày không khớp lịch</option><% } %>
                                <% sessionTypes.forEach(type => { %>
                                    <option value="<%= type %>" <%= type === sessionType ? 'selected' : '' %>><%= type %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <section id="attendance-context-sticky" class="sticky border border-slate-200 bg-white px-4 pb-4 shadow-sm sm:px-6 sm:pb-5 lg:px-8" aria-label="Trạng thái và thao tác điểm danh">
                <div class="flex justify-end">
                    <div id="attendance-save-status" class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs font-medium md:gap-2 md:px-3 md:py-1.5 md:text-sm [&.is-saved]:border-emerald-200 [&.is-saved]:bg-emerald-50 [&.is-saved]:text-emerald-700 [&.is-unsaved]:border-amber-200 [&.is-unsaved]:bg-amber-50 [&.is-unsaved]:text-amber-700 <%= attendanceSaved ? 'is-saved' : 'is-unsaved' %>">
                        <i class="fa-solid <%= attendanceSaved ? 'fa-circle-check' : 'fa-clock' %>" aria-hidden="true"></i>
                        <span id="attendance-save-status-text">Đã lưu <%= attendanceSavedCount %>/<%= students.length %></span>
                    </div>
                </div>
                <div class="mt-3 flex items-center gap-2">
                    <label for="attendance-search" class="sr-only">Tìm tên hoặc mã số</label>
                    <div class="relative min-w-0 flex-1">
                        <i class="fa-solid fa-magnifying-glass pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-slate-400" aria-hidden="true"></i>
                        <input id="attendance-search" type="search" placeholder="Tìm tên hoặc mã số..." autocomplete="off"
                            data-table-search="[data-attendance-row]" data-search-empty="#attendance-search-empty"
                            class="h-10 w-full rounded-xl border border-slate-200 bg-white py-2 pl-10 pr-3.5 text-sm text-slate-800 placeholder:text-slate-400 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20">
                    </div>
                    <button class="inline-flex h-10 shrink-0 items-center justify-center gap-2 rounded-xl border border-emerald-200 bg-emerald-50 px-3 text-sm font-semibold text-emerald-700 transition-colors hover:bg-emerald-100 disabled:cursor-not-allowed disabled:opacity-50 md:px-3.5"
                        type="button" id="mark-remaining-attendance"
                        aria-label="Đánh dấu có mặt cho các dòng chưa có bản ghi"
                        title="Đánh dấu có mặt cho các dòng chưa có bản ghi"
                        <%= attendanceSaved ? 'disabled' : '' %>>
                        <span class="md:hidden">Có mặt</span>
                        <span class="hidden md:inline">Đánh dấu có mặt</span>
                    </button>
                    <button class="inline-flex h-10 w-10 shrink-0 items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white text-slate-600 transition-colors hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50 md:w-auto md:px-3.5"
                        type="button" id="print-monthly-attendance" aria-label="In điểm danh" title="In điểm danh"
                        <%= !selectedClassId || !selectedDate ? 'disabled' : '' %>>
                        <i class="fa-solid fa-print" aria-hidden="true"></i>
                        <span class="hidden md:inline">In điểm danh</span>
                    </button>
                </div>
            </section>

        </form>

        <form method="POST" action="/glv/diem-danh/save" id="attendance-save-form"
            class="flex flex-col gap-6 flex-1"
            data-save-url="/glv/diem-danh/entry-save"
            data-year-id="<%= selectedYearId %>"
            data-class-id="<%= selectedClassId %>"
            data-session-type="<%= sessionType %>"
            data-attendance-date="<%= selectedDate %>">
            <input type="hidden" name="nien_khoa" value="<%= selectedYearId %>">
            <input type="hidden" name="id_lop" value="<%= selectedClassId %>">
            <input type="hidden" name="loai_buoi" value="<%= sessionType %>">
            <input type="hidden" name="ngay_diem_danh" value="<%= selectedDate %>">
            
            <% if (!students.length) { %>
                <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center text-slate-500"><i class="fa-solid fa-user-slash mr-2 text-slate-400"></i> Lớp chưa có thiếu nhi đang học.</div>
            <% } else { %>
                <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm max-[600px]:overflow-visible max-[600px]:border-0 max-[600px]:bg-transparent max-[600px]:shadow-none">
                    <table class="w-full min-w-175 border-collapse max-[600px]:min-w-0 max-[600px]:block">
                        <thead class="max-[600px]:hidden">
                            <tr class="bg-slate-50 text-[11px] font-bold uppercase tracking-wider text-slate-500">
                                <th class="w-14 border-b border-slate-200 px-3.5 py-3 text-center">STT</th>
                                <th class="border-b border-slate-200 px-3.5 py-3 text-left">MSTN</th>
                                <th class="border-b border-slate-200 px-3.5 py-3 text-left">Họ và tên</th>
                                <th class="border-b border-slate-200 px-3.5 py-3 text-left">Điểm danh</th>
                            </tr>
                        </thead>
                        <tbody class="text-sm max-[600px]:block">
                            <% students.forEach((student, index) => { %>
                                <tr data-attendance-row data-student-id="<%= student.id_tn %>" data-saved="<%= student.da_luu ? 'true' : 'false' %>" data-search="<%= `${student.mstn || ''} ${student.ten_thanh || ''} ${student.ho_va_ten_lot || ''} ${student.ten || ''}`.toLowerCase() %>" class="max-[600px]:mb-3 max-[600px]:block max-[600px]:rounded-xl max-[600px]:border max-[600px]:border-slate-200 max-[600px]:bg-white max-[600px]:px-3 max-[600px]:py-2 max-[600px]:transition-colors max-[600px]:hover:bg-slate-50/50">
                                    <td class="border-b border-slate-100 px-3.5 py-3 text-center text-slate-400 max-[600px]:hidden"><%= index + 1 %></td>
                                    <td class="border-b border-slate-100 px-3.5 py-3 max-[600px]:mb-2 max-[600px]:block max-[600px]:border-0 max-[600px]:px-0 max-[600px]:py-0 max-[600px]:text-xs max-[600px]:font-semibold max-[600px]:text-slate-500"><span class="hidden h-6 w-6 items-center justify-center rounded-full bg-slate-100 text-xs font-bold text-slate-500 max-[600px]:inline-flex"><%= index + 1 %></span><span class="max-[600px]:ml-2"><%= student.mstn || '-' %></span></td>
                                    <td class="border-b border-slate-100 px-3.5 py-3 max-[600px]:mb-2 max-[600px]:block max-[600px]:border-0 max-[600px]:px-0 max-[600px]:py-0"><strong class="text-sm font-bold leading-snug text-slate-900"><%= [student.ten_thanh, student.ho_va_ten_lot, student.ten].filter(Boolean).join(' ') %></strong></td>
                                    <td class="border-b border-slate-100 px-3.5 py-3 max-[600px]:block max-[600px]:border-0 max-[600px]:px-0 max-[600px]:py-0"><!--<span class="mb-2 hidden text-xs font-medium text-slate-500 max-[600px]:block">Điểm danh</span>-->
                                        <button type="button" data-attendance-picker-trigger
                                            class="mb-2 inline-flex min-h-11 w-full items-center justify-between rounded-xl border border-slate-200 bg-slate-50 px-3 text-left text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:border-blue-300 hover:bg-blue-50 max-[600px]:mb-0 min-[1025px]:hidden"
                                            aria-haspopup="dialog" aria-controls="attendance-picker-dialog"
                                            aria-label="Chọn trạng thái điểm danh cho <%= [student.ten_thanh, student.ho_va_ten_lot, student.ten].filter(Boolean).join(' ') %>">
                                            <span data-attendance-picker-label><%= student.trang_thai_diem_danh || 'Chọn trạng thái' %></span>
                                            <i class="fa-solid fa-chevron-down text-xs text-slate-400" aria-hidden="true"></i>
                                        </button>
                                        <fieldset class="attendance-options m-0 hidden min-w-115 flex-wrap gap-2 border-0 p-0 min-[1025px]:flex">
                                            <legend class="sr-only">Trạng thái điểm danh</legend>
                                            <label class="inline-flex cursor-pointer items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-600 has-checked:border-blue-600 has-checked:bg-blue-50 has-checked:font-bold has-checked:text-blue-700 max-[600px]:min-h-10"><input type="radio" name="attendance[<%= index %>][trang_thai]" value="Có mặt" <%= student.trang_thai_diem_danh === 'Có mặt' ? 'checked' : '' %>><span>Có mặt</span></label>
                                            <label class="inline-flex cursor-pointer items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-600 has-checked:border-blue-600 has-checked:bg-blue-50 has-checked:font-bold has-checked:text-blue-700 max-[600px]:min-h-10"><input type="radio" name="attendance[<%= index %>][trang_thai]" value="Đi sớm" <%= student.da_luu && student.trang_thai_diem_danh === 'Đi sớm' ? 'checked' : '' %>><span>Đi sớm</span></label>
                                            <label class="inline-flex cursor-pointer items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-600 has-checked:border-amber-500 has-checked:bg-amber-50 has-checked:font-bold has-checked:text-amber-700 max-[600px]:min-h-10"><input type="radio" name="attendance[<%= index %>][trang_thai]" value="Đi trễ" <%= student.da_luu && student.trang_thai_diem_danh === 'Đi trễ' ? 'checked' : '' %>><span>Đi trễ</span></label>
                                            <label class="inline-flex cursor-pointer items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-600 has-checked:border-blue-600 has-checked:bg-blue-50 has-checked:font-bold has-checked:text-blue-700 max-[600px]:min-h-10"><input type="radio" name="attendance[<%= index %>][trang_thai]" value="Vắng phép" <%= student.da_luu && student.trang_thai_diem_danh === 'Vắng phép' ? 'checked' : '' %>><span>Vắng phép</span></label>
                                            <label class="inline-flex cursor-pointer items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-600 has-checked:border-blue-600 has-checked:bg-blue-50 has-checked:font-bold has-checked:text-blue-700 max-[600px]:min-h-10"><input type="radio" name="attendance[<%= index %>][trang_thai]" value="Vắng không phép" <%= student.da_luu && student.trang_thai_diem_danh === 'Vắng không phép' ? 'checked' : '' %>><span>Vắng không phép</span></label>
                                        </fieldset>
                                        <input type="hidden" name="attendance[<%= index %>][id_tn]" value="<%= student.id_tn %>">
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
            <div class="search-hidden rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center text-slate-500" id="attendance-search-empty">Không tìm thấy thiếu nhi phù hợp.</div>
        </form>

        <dialog id="attendance-picker-dialog" aria-labelledby="attendance-picker-title">
            <div class="mx-auto mt-3 h-1.5 w-10 rounded-full bg-slate-300" aria-hidden="true"></div>
            <div class="flex items-start justify-between gap-4 px-5 pb-4 pt-5">
                <div>
                    <h2 id="attendance-picker-title" class="text-lg font-bold text-slate-900">Chọn trạng thái</h2>
                    <p data-attendance-picker-student class="mt-1 text-sm text-slate-500"></p>
                </div>
                <button type="button" data-close-attendance-picker
                    class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-600 hover:bg-slate-200"
                    aria-label="Đóng">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
            <div class="grid gap-2 px-5 pb-5">
                <% ['Có mặt', 'Đi sớm', 'Đi trễ', 'Vắng phép', 'Vắng không phép'].forEach(value => { %>
                    <button type="button" data-attendance-picker-option data-value="<%= value %>"
                        class="flex min-h-12 items-center justify-between rounded-xl border border-slate-200 bg-white px-4 text-left text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50">
                        <span><%= value %></span>
                        <i class="fa-solid fa-check invisible" aria-hidden="true"></i>
                    </button>
                <% }) %>
            </div>
            <div class="h-[env(safe-area-inset-bottom)] bg-white"></div>
        </dialog>

        <%- include('../partials/pagination', {
            mode: 'client',
            currentPage: 1,
            totalPages: Math.max(Math.ceil(students.length / 25), 1),
            totalItems: students.length,
            pageSize: 25,
            rows: '[data-attendance-row]'
        }) %>

        <dialog class="m-auto max-h-[calc(100vh-2.5rem)] w-[calc(100vw-2rem)] max-w-110 rounded-2xl border-0 p-0 text-slate-800 shadow-2xl backdrop:bg-slate-900/60 backdrop:backdrop-blur-sm" id="attendance-print-modal" aria-labelledby="attendance-print-modal-title">
            <div class="flex items-start justify-between gap-4 border-b border-slate-200 px-6 pb-4 pt-5">
                <div>
                    <span class="text-[10px] font-extrabold uppercase tracking-widest text-blue-600">Điểm danh</span>
                    <h2 class="mt-1 text-xl font-bold text-slate-900" id="attendance-print-modal-title">In điểm danh</h2>
                </div>
                <button class="rounded-full p-1 text-2xl leading-none text-slate-500 hover:bg-slate-100 hover:text-slate-800" type="button" data-close-attendance-print aria-label="Đóng">&times;</button>
            </div>
            <div class="grid gap-2 px-6 py-5">
                <label class="text-sm font-bold text-slate-700" for="attendance-print-month">Chọn tháng cần in</label>
                <select class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm text-slate-800 focus:border-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500/20" id="attendance-print-month">
                    <% for (let month = 1; month <= 12; month += 1) { %>
                        <option value="<%= month %>" <%= selectedDate && Number(selectedDate.slice(5, 7)) === month ? 'selected' : '' %>>Tháng <%= month %></option>
                    <% } %>
                </select>
                <p class="m-0 mt-1 text-sm text-slate-500">Niên khóa đang chọn sẽ được dùng để xác định năm của tháng in.</p>
            </div>
            <div class="flex justify-end gap-3 border-t border-slate-200 px-6 py-4">
                <button class="inline-flex min-h-10 items-center justify-center rounded-xl bg-slate-100 px-4 py-2 font-semibold text-slate-700 hover:bg-slate-200" type="button" data-close-attendance-print>Hủy</button>
                <button class="inline-flex min-h-10 items-center justify-center gap-2 rounded-xl bg-blue-600 px-4 py-2 font-semibold text-white hover:bg-blue-700" type="button" id="confirm-monthly-attendance-print">
                    <i class="fa-solid fa-print"></i> Xác nhận in
                </button>
            </div>
        </dialog>
    <% } %>
    </div>
</main>

<script src="/js/table-search.js" defer></script>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/glv/glv-diem-danh.js" defer></script>
