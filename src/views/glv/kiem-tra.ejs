<!-- Font Awesome CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<link rel="stylesheet" href="/css/reset.css">
<link rel="stylesheet" href="/css/glv/glv-kiem-tra.css">

<main class="test-page">
    <header class="class-header">
        <span class="class-eyebrow"><i class="fa-solid fa-layer-group"></i> Quản lý lớp học</span>
        <h1>Điểm kiểm tra thiếu nhi</h1>
    </header>

    <% if (!classes.length || !examCount) { %>
        <div class="empty-state"><i class="fa-solid fa-triangle-exclamation"></i> Chưa có lớp được phân công hoặc chưa cấu hình số bài kiểm tra.</div>
    <% } else { %>
        <form class="test-toolbar" method="GET" action="/glv/kiem-tra">
            <div class="test-field">
                <label for="student-search"><i class="fa-solid fa-magnifying-glass"></i> Tìm kiếm thiếu nhi</label>
                <input id="student-search" type="search" data-table-search="[data-student-row]" data-search-empty="#student-search-empty" placeholder="Tên hoặc mã số..." autocomplete="off">
            </div>
            <div class="test-field">
                <label for="test-number"><i class="fa-solid fa-pen-to-square"></i> Bài kiểm tra</label>
                <select id="test-number" name="bai_kiem_tra">
                    <% for (let number = 1; number <= examCount; number += 1) { %>
                        <option value="<%= number %>" <%= number === selectedExam ? 'selected' : '' %>>Bài kiểm tra <%= number %></option>
                    <% } %>
                </select>
            </div>

            <div class="test-field">
                <label for="test-date"><i class="fa-solid fa-calendar-days"></i> Ngày kiểm tra</label>
                <input id="test-date" type="date" name="ngay_kiem_tra" value="<%= selectedDate ?? '' %>" onchange="document.getElementById('score-exam-date').value = this.value">
            </div>
        </form>

        <form method="POST" action="/glv/kiem-tra/save" id="score-form"
            data-save-url="/glv/kiem-tra/entry-save"
            data-year-id="<%= selectedYearId %>"
            data-class-id="<%= selectedClassId %>"
            data-exam-number="<%= selectedExam %>">
            <input type="hidden" name="nien_khoa" value="<%= selectedYearId %>">
            <input type="hidden" name="id_lop" value="<%= selectedClassId %>">
            <input type="hidden" name="bai_kiem_tra" value="<%= selectedExam %>">
            <input id="score-exam-date" type="hidden" name="ngay_kiem_tra" value="<%= selectedDate ?? '' %>">
            
            <div class="test-summary">
                <span><i class="fa-solid fa-circle-info"></i> <strong><%= classes.find(item => item.id_lop === selectedClassId)?.ten_lop %></strong> · Bài kiểm tra <strong><%= selectedExam %></strong></span>
                <span class="score-save-status <%= students.length && students.every(student => student.da_luu) ? 'is-saved' : 'is-unsaved' %>" id="score-save-status">
                    <i class="fa-solid <%= students.length && students.every(student => student.da_luu) ? 'fa-circle-check' : 'fa-clock' %>"></i>
                    <span id="score-save-status-text"><%= students.length && students.every(student => student.da_luu) ? 'Đã lưu' : 'Chưa lưu' %></span>
                </span>
                <button
                    class="print-score-button"
                    type="button"
                    id="open-exam-print"
                    data-class-id="<%= selectedClassId || '' %>"
                    data-exam-count="<%= examCount %>"
                    <%= !selectedClassId || !students.length ? 'disabled' : '' %>>
                    <i class="fa-solid fa-print"></i> In điểm kiểm tra
                </button>
                <button class="save-score-button" type="submit"><i class="fa-solid fa-floppy-disk"></i> Lưu điểm</button>
            </div>

            <% if (!students.length) { %>
                <div class="empty-state"><i class="fa-solid fa-user-slash"></i> Lớp chưa có thiếu nhi.</div>
            <% } else { %>
                <div class="test-table-wrap">
                    <table class="test-table">
                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Mã số</th>
                                <th>Họ và tên</th>
                                <th>Trạng thái</th>
                                <th>Điểm</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% students.forEach((student, index) => { %>
                                <tr data-student-row data-student-id="<%= student.id_tn %>" data-search="<%= `${student.mstn || ''} ${student.ten_thanh || ''} ${student.ho_va_ten_lot || ''} ${student.ten || ''}`.toLowerCase() %>">
                                    <td><%= index + 1 %></td>
                                    <td><%= student.mstn || '-' %></td>
                                    <td><strong><%= [student.ten_thanh, student.ho_va_ten_lot, student.ten].filter(Boolean).join(' ') %></strong></td>
                                    <td class="test-status <%= student.trang_thai === 'Đang học' ? '' : 'inactive' %>"><%= student.trang_thai %></td>
                                    <td>
                                        <input class="score-input" type="number" name="scores[<%= index %>][diem_so]" min="0" max="10" step="0.01" value="<%= student.diem_so ?? '' %>" placeholder="0">
                                        <input type="hidden" name="scores[<%= index %>][id_tn]" value="<%= student.id_tn %>">
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
            <div class="empty-state search-hidden" id="student-search-empty">Không tìm thấy thiếu nhi phù hợp.</div>
        </form>

        <%- include('../partials/pagination', {
            mode: 'client',
            currentPage: 1,
            totalPages: Math.max(Math.ceil(students.length / 25), 1),
            totalItems: students.length,
            pageSize: 25,
            rows: '[data-student-row]'
        }) %>

        <dialog class="exam-print-modal" id="exam-print-modal" aria-labelledby="exam-print-modal-title">
            <div class="exam-print-modal-heading">
                <div>
                    <span class="class-eyebrow">Điểm kiểm tra</span>
                    <h2 id="exam-print-modal-title">In điểm kiểm tra</h2>
                </div>
                <button class="exam-print-modal-close" type="button" data-close-exam-print aria-label="Đóng">&times;</button>
            </div>
            <div class="exam-print-modal-content">
                <label for="exam-print-from">Chọn khoảng bài kiểm tra cần in</label>
                <div class="exam-print-range">
                    <select id="exam-print-from" aria-label="Bắt đầu từ bài kiểm tra">
                        <% for (let number = 1; number <= examCount; number += 1) { %>
                            <option value="<%= number %>" <%= number === selectedExam ? 'selected' : '' %>>Từ bài <%= number %></option>
                        <% } %>
                    </select>
                    <select id="exam-print-to" aria-label="Kết thúc đến bài kiểm tra">
                        <% for (let number = 1; number <= examCount; number += 1) { %>
                            <option value="<%= number %>" <%= number === examCount ? 'selected' : '' %>>Đến bài <%= number %></option>
                        <% } %>
                    </select>
                </div>
                <p id="exam-print-range-hint">Chọn khoảng cần in trong số bài kiểm tra của niên khóa.</p>
            </div>
            <div class="exam-print-modal-actions">
                <button class="exam-print-modal-cancel" type="button" data-close-exam-print>Hủy</button>
                <button class="exam-print-modal-confirm" type="button" id="confirm-exam-print">
                    <i class="fa-solid fa-print"></i> Xác nhận in
                </button>
            </div>
        </dialog>
    <% } %>
</main>

<script src="/js/table-search.js" defer></script>
<script src="/js/glv/glv-kiem-tra.js" defer></script>