<%
    const savedScoreCount = students.filter(student => student.da_luu).length;
    const isScoreSaved = students.length > 0 && savedScoreCount === students.length;
    const scoreSaveStatusClasses = isScoreSaved
        ? 'bg-emerald-50 text-emerald-700 border border-emerald-200'
        : 'bg-amber-50 text-amber-700 border border-amber-200';
    const scoreSaveIcon = isScoreSaved ? 'fa-circle-check' : 'fa-clock';
%>
<style>
    @media (min-width: 768px) {
        #exam-context-desktop-controls { display: flex; }
    }
    #exam-collapsed-status { display: none; }
    #exam-context-sticky.is-scroll-collapsed #open-exam-print { display: none; }
    #exam-context-sticky.is-scroll-collapsed #exam-collapsed-status { display: inline-flex; }
</style>
<main class="min-h-screen bg-slate-50 text-slate-800 flex flex-col antialiased selection:bg-blue-500 selection:text-white pb-16">

    <div class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col gap-6">
        
        <% if (!classes.length || !examCount) { %>
            <!-- Empty state for unassigned classes or configuration -->
            <div class="bg-white rounded-2xl p-12 text-center border border-slate-200 shadow-sm text-slate-500">
                <i class="fa-solid fa-triangle-exclamation text-3xl mb-2 text-amber-500"></i>
                <p class="font-medium text-slate-700 text-base">Chưa có lớp được phân công hoặc chưa cấu hình số bài kiểm tra.</p>
            </div>
        <% } else { %>

            <form id="exam-context-form" method="GET" action="/glv/kiem-tra" class="contents">
                <input type="hidden" name="nien_khoa" value="<%= selectedYearId %>">
                <input type="hidden" name="id_lop" value="<%= selectedClassId %>">

            <section id="exam-context-sticky" data-scroll-sticky class="border border-slate-200 bg-white px-4 py-4 shadow-sm sm:px-6 sm:py-5 lg:px-8" aria-label="Bộ lọc và thao tác bài kiểm tra">
                <div class="flex flex-col items-stretch gap-2 md:flex-row md:items-end" data-scroll-collapse>
                    <div class="exam-date-context min-w-0 flex-1" aria-label="Chọn bài và ngày kiểm tra">
                    <div class="flex flex-col gap-2 md:flex-row md:items-center">
                        <div id="exam-context-desktop-controls" class="hidden items-end gap-3">
                            <div class="flex flex-col gap-1">
                                <label for="test-number" class="text-xs font-semibold text-slate-600">Bài kiểm tra</label>
                                <select id="test-number" name="bai_kiem_tra" class="h-11 rounded-lg border border-slate-200 bg-slate-100 px-3 text-sm font-medium text-slate-700 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20">
                                    <% for (let number = 1; number <= examCount; number += 1) { %>
                                        <option value="<%= number %>" <%= number === selectedExam ? 'selected' : '' %>>Bài số <%= number %></option>
                                    <% } %>
                                </select>
                            </div>
                            <div class="flex flex-col gap-1">
                                <label for="test-date" class="text-xs font-semibold text-slate-600">Ngày kiểm tra</label>
                                <input id="test-date" name="ngay_kiem_tra" type="date" value="<%= selectedDate ?? '' %>"
                                    class="h-11 rounded-lg border border-slate-200 bg-slate-100 px-3 text-sm font-medium text-slate-700 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20">
                            </div>
                        </div>
                        <div class="grid min-w-0 flex-1 grid-cols-1 gap-2 md:hidden">
                            <div class="min-w-0">
                                <label for="test-number-mobile" class="mb-1 block text-xs font-semibold text-slate-600">Bài kiểm tra</label>
                                <select id="test-number-mobile" class="h-10 w-full rounded-lg border border-slate-200 bg-slate-100 px-3 text-sm font-medium text-slate-700 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20">
                                    <% for (let number = 1; number <= examCount; number += 1) { %>
                                        <option value="<%= number %>" <%= number === selectedExam ? 'selected' : '' %>>Bài số <%= number %></option>
                                    <% } %>
                                </select>
                            </div>
                            <div class="min-w-0">
                                <label for="test-date-mobile" class="mb-1 block text-xs font-semibold text-slate-600">Ngày kiểm tra</label>
                                <input id="test-date-mobile" type="date" value="<%= selectedDate ?? '' %>"
                                    class="h-10 w-full rounded-lg border border-slate-200 bg-slate-100 px-3 text-sm font-medium text-slate-700 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20">
                            </div>
                        </div>
                    </div>
                    </div>
                    <div class="shrink-0 self-start md:self-end md:mb-2 md:-translate-y-2">
                        <div id="score-save-status" class="inline-flex shrink-0 items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs font-medium md:gap-2 md:px-3 md:py-1.5 md:text-sm <%= scoreSaveStatusClasses %>">
                            <i class="fa-solid <%= scoreSaveIcon %>" aria-hidden="true"></i>
                            <span id="score-save-status-text">Đã lưu <%= savedScoreCount %>/<%= students.length %></span>
                        </div>
                    </div>
                </div>
                    <div class="mt-3 flex items-center gap-2 border-t border-slate-100 pt-3" data-scroll-content>
                        <label for="student-search" class="sr-only">Tìm tên hoặc mã số</label>
                        <div class="relative min-w-0 flex-1">
                            <i class="fa-solid fa-magnifying-glass pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-slate-400" aria-hidden="true"></i>
                            <input id="student-search" type="search" placeholder="Tìm tên hoặc mã số..." autocomplete="off"
                                data-table-search="[data-student-row]" data-search-empty="#student-search-empty"
                                class="h-10 w-full rounded-xl border border-slate-200 bg-white py-2 pl-10 pr-3.5 text-sm text-slate-800 placeholder:text-slate-400 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20">
                        </div>
                        <button class="inline-flex h-10 w-10 shrink-0 items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white text-slate-600 transition-colors hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50 md:w-auto md:px-3.5"
                            type="button"
                            id="open-exam-print"
                            data-class-id="<%= selectedClassId || '' %>"
                            data-exam-count="<%= examCount %>"
                            aria-label="In điểm kiểm tra"
                            title="In điểm kiểm tra"
                            <%= !selectedClassId || !students.length ? 'disabled' : '' %>>
                            <i class="fa-solid fa-print" aria-hidden="true"></i>
                            <span class="hidden md:inline">In điểm kiểm tra</span>
                        </button>
                        <span id="exam-collapsed-status"
                            class="h-10 items-center justify-center rounded-full border px-3 text-sm font-semibold <%= isScoreSaved ? 'border-emerald-200 bg-emerald-50 text-emerald-700' : 'border-amber-200 text-amber-700' %>"
                            aria-label="Đã lưu <%= savedScoreCount %> trên <%= students.length %>"
                            aria-live="polite"><%= savedScoreCount %>/<%= students.length %></span>
                    </div>
            </section>
            </form>

            <!-- Main Score Input Form -->
            <form method="POST" action="/glv/kiem-tra/save" id="score-form"
                data-save-url="/glv/kiem-tra/entry-save"
                data-year-id="<%= selectedYearId %>"
                data-class-id="<%= selectedClassId %>"
                data-exam-number="<%= selectedExam %>"
                class="flex flex-col gap-6 flex-1">
                
                <input type="hidden" name="nien_khoa" value="<%= selectedYearId %>">
                <input type="hidden" name="id_lop" value="<%= selectedClassId %>">
                <input type="hidden" name="bai_kiem_tra" value="<%= selectedExam %>">
                <input id="score-exam-date" type="hidden" name="ngay_kiem_tra" value="<%= selectedDate ?? '' %>">
                
                <% if (!students.length) { %>
                    <!-- Empty Class Roster State -->
                    <div class="bg-white rounded-2xl p-16 text-center border border-slate-200 shadow-sm text-slate-500 flex-1 flex flex-col items-center justify-center">
                        <i class="fa-solid fa-user-slash text-4xl mb-3 text-slate-300"></i>
                        <p class="font-semibold text-slate-700 text-base">Lớp chưa có thiếu nhi trong danh sách.</p>
                    </div>
                <% } else { %>
                    <!-- Score List Container with Hybrid Responsive Layout -->
                    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden flex-1 flex flex-col max-md:overflow-visible max-md:border-0 max-md:bg-transparent max-md:shadow-none">
                        <!-- Desktop Table View (Visible on Medium screens and up) -->
                        <div class="hidden md:block overflow-x-auto flex-1" data-score-layout="desktop">
                            <table class="w-full table-fixed text-left border-collapse min-w-175">
                                <colgroup>
                                    <col style="width: 8%">
                                    <col style="width: 14%">
                                    <col style="width: 54%">
                                    <col style="width: 24%">
                                </colgroup>
                                <thead>
                                    <tr class="bg-slate-50/75 border-b border-slate-200 text-slate-500 text-[11px] font-bold uppercase tracking-wider">
                                        <th class="py-3.5 px-4 text-center w-16">STT</th>
                                        <th class="py-3.5 px-4 w-32">MSTN</th>
                                        <th class="py-3.5 px-4">Họ và tên</th>
                                        <th class="py-3.5 px-4 w-40 text-center">Điểm số (0 - 10)</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100 text-sm">
                                    <% students.forEach((student, index) => { %>
                                        <tr data-student-row data-student-id="<%= student.id_tn %>" data-saved="<%= student.da_luu ? 'true' : 'false' %>" data-search="<%= `${student.mstn || ''} ${student.ten_thanh || ''} ${student.ho_va_ten_lot || ''} ${student.ten || ''}`.toLowerCase() %>"
                                            class="hover:bg-blue-50/30 transition-colors group">
                                            <td class="py-3.5 px-4 text-center text-slate-400 font-medium"><%= index + 1 %></td>
                                            <td class="py-3.5 px-4"><%= student.mstn || '-' %></td>
                                            <td class="py-3.5 px-4 font-semibold text-slate-900">
                                                <%= [student.ten_thanh, student.ho_va_ten_lot, student.ten].filter(Boolean).join(' ') %>
                                            </td>
                                            <td class="py-3.5 px-4 text-center">
                                                <input class="score-input w-24 px-3 py-1.5 text-center font-bold text-slate-800 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition-all shadow-2xs disabled:cursor-not-allowed disabled:opacity-50" 
                                                    type="number" name="scores[<%= index %>][diem_so]" min="0" max="10" step="0.01" value="<%= student.diem_so ?? '' %>">
                                                <input type="hidden" name="scores[<%= index %>][id_tn]" value="<%= student.id_tn %>">
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>

                        <!-- Mobile Card List View (Visible on small screens below md, eliminating horizontal scrolling) -->
                        <div class="md:hidden space-y-3" data-score-layout="mobile">
                            <% students.forEach((student, index) => { %>
                                <div data-student-row data-student-id="<%= student.id_tn %>" data-saved="<%= student.da_luu ? 'true' : 'false' %>" data-search="<%= `${student.mstn || ''} ${student.ten_thanh || ''} ${student.ho_va_ten_lot || ''} ${student.ten || ''}`.toLowerCase() %>"
                                    class="flex flex-col gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 transition-colors hover:bg-slate-50/50">
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center space-x-2">
                                            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-slate-100 text-xs font-bold text-slate-500"><%= index + 1 %></span>
                                            <span class="text-xs font-semibold text-slate-500"><%= student.mstn || '-' %></span>
                                        </div>
                                    </div>
                                    <div class="text-sm font-bold leading-snug text-slate-900">
                                        <%= [student.ten_thanh, student.ho_va_ten_lot, student.ten].filter(Boolean).join(' ') %>
                                    </div>
                                    <div class="flex items-center justify-between gap-3">
                                        <label for="score-mob-<%= index %>" class="text-xs font-bold text-slate-500 uppercase">Điểm:</label>
                                        <input id="score-mob-<%= index %>" class="score-input min-w-0 flex-1 px-3 py-2 text-center font-bold text-slate-800 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition-all shadow-2xs text-base disabled:cursor-not-allowed disabled:opacity-50"
                                            type="number" name="scores[<%= index %>][diem_so]" min="0" max="10" step="0.01" value="<%= student.diem_so ?? '' %>">
                                        <input type="hidden" name="scores[<%= index %>][id_tn]" value="<%= student.id_tn %>">
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                        
                        <!-- Empty Search Result State -->
                        <div id="student-search-empty" class="hidden p-12 text-center text-slate-400">
                            <i class="fa-solid fa-user-slash text-3xl mb-2 text-slate-300"></i>
                            <p class="font-medium text-slate-600">Không tìm thấy thiếu nhi phù hợp với từ khóa.</p>
                        </div>
                    </div>
                <% } %>
            </form>

            <!-- Pagination Support Partial -->
            <%- include('../partials/pagination', {
                mode: 'client',
                currentPage: 1,
                totalPages: Math.max(Math.ceil(students.length / 25), 1),
                totalItems: students.length,
                pageSize: 25,
                rows: '[data-student-row]',
                rowGroupAttribute: 'data-student-id'
            }) %>

            <!-- Print Modal Dialog -->
            <dialog class="m-auto max-h-[calc(100vh-2.5rem)] w-[calc(100vw-2rem)] p-0 rounded-2xl shadow-2xl border-0 max-w-md backdrop:bg-slate-900/60 backdrop:blur-sm overflow-hidden" id="exam-print-modal" aria-labelledby="exam-print-modal-title">
                <div class="p-6 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
                    <div>
                        <span class="text-[10px] font-extrabold uppercase tracking-wider text-blue-600">Báo cáo & Thống kê</span>
                        <h3 id="exam-print-modal-title" class="text-lg font-bold text-slate-900 mt-0.5">In điểm kiểm tra</h3>
                    </div>
                    <button class="w-8 h-8 rounded-full bg-slate-200/60 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition-colors" type="button" data-close-exam-print aria-label="Đóng">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
                <div class="p-6 space-y-4">
                    <div class="space-y-1.5">
                        <label for="exam-print-from" class="text-xs font-bold uppercase tracking-wider text-slate-500 block">Chọn khoảng bài kiểm tra cần in</label>
                        <div class="grid grid-cols-2 gap-3">
                            <select id="exam-print-from" aria-label="Bắt đầu từ bài kiểm tra"
                                class="px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600">
                                <% for (let number = 1; number <= examCount; number += 1) { %>
                                    <option value="<%= number %>" <%= number === selectedExam ? 'selected' : '' %>>Từ bài <%= number %></option>
                                <% } %>
                            </select>
                            <select id="exam-print-to" aria-label="Kết thúc đến bài kiểm tra"
                                class="px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600">
                                <% for (let number = 1; number <= examCount; number += 1) { %>
                                    <option value="<%= number %>" <%= number === examCount ? 'selected' : '' %>>Đến bài <%= number %></option>
                                <% } %>
                            </select>
                        </div>
                    </div>
                    <p id="exam-print-range-hint" class="text-xs text-slate-500 bg-blue-50/60 p-3 rounded-xl border border-blue-100/60 leading-relaxed">
                        <i class="fa-solid fa-circle-info text-blue-600 mr-1"></i> Bảng điểm in sẽ được định dạng chuẩn A4 ngang, bao gồm đầy đủ cột điểm các bài kiểm tra đã chọn của lớp.
                    </p>
                </div>
                <div class="p-4 px-6 bg-slate-50/80 border-t border-slate-100 flex justify-end gap-3">
                    <button class="px-4 py-2.5 rounded-xl border border-slate-200 bg-white text-slate-700 font-semibold text-sm hover:bg-slate-50 transition-all" type="button" data-close-exam-print>Hủy</button>
                    <button class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm transition-all shadow-md shadow-blue-500/20 flex items-center gap-2" type="button" id="confirm-exam-print">
                        <i class="fa-solid fa-print"></i> Xác nhận in
                    </button>
                </div>
            </dialog>

        <% } %>
    </div>
</main>

<!-- Scripts -->
<script src="/js/table-search.js" defer></script>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/glv/glv-kiem-tra.js" defer></script>
<script>
    (() => {
        const examSelector = document.getElementById('test-number');
        const mobileExamSelector = document.getElementById('test-number-mobile');
        const dateInput = document.getElementById('test-date');
        const mobileDateInput = document.getElementById('test-date-mobile');
        const desktopViewport = window.matchMedia('(min-width: 768px)');

        if (!examSelector || !mobileExamSelector || !dateInput || !mobileDateInput) return;

        examSelector.addEventListener('change', () => {
            dateInput.disabled = true;
        });
        mobileExamSelector.addEventListener('change', () => {
            examSelector.value = mobileExamSelector.value;
            examSelector.dispatchEvent(new Event('change', { bubbles: true }));
        });
        mobileDateInput.addEventListener('change', () => {
            document.dispatchEvent(new CustomEvent('exam-date-save', {
                detail: {
                    date: mobileDateInput.value,
                    exam: mobileExamSelector.value
                }
            }));
        });
        dateInput.addEventListener('change', () => {
            if (desktopViewport.matches) {
                document.dispatchEvent(new CustomEvent('exam-date-save', {
                    detail: { date: dateInput.value, exam: examSelector.value }
                }));
            }
        });
    })();
</script>