<style>
    #score-toolbar-context {
        width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-top: -3rem;
        margin-bottom: -1.5rem;
        border-radius: 3rem 3rem 0 0;
        border-bottom-width: 0;
    }
    #score-filter-sticky {
        position: sticky;
        top: 90px;
        z-index: 20;
        width: 100vw;
        margin-left: calc(50% - 50vw);
        border-radius: 0 0 3rem 3rem;
        border-top-width: 0;
    }
    @media (min-width: 640px) { #score-toolbar-context { margin-top: -3.5rem; } }
    @media (min-width: 1025px) {
        #score-toolbar-context {
            width: calc(100vw - 280px);
            margin-left: calc(50% - 50vw + 140px);
            margin-top: -3.5rem;
        }
        #score-filter-sticky {
            top: 90px;
            width: calc(100vw - 280px);
            margin-left: calc(50% - 50vw + 140px);
        }
    }
    #score-page .score-mobile-card { display: none; }
    @media (max-width: 800px) {
        #score-page .class-list {
            width: 100%;
            min-width: 0;
            gap: 0.5rem;
            margin-inline: 0;
        }
        #score-page .class-card {
            width: 100%;
            min-width: 0;
            overflow: visible;
            border: 0;
            border-radius: 0;
            background: transparent;
            box-shadow: none;
        }
        #score-page .table-wrap {
            width: 100%;
            min-width: 0;
            overflow: visible;
            border: 0;
            background: transparent;
            box-shadow: none;
        }
        #score-page .score-table { display: block; min-width: 0; }
        #score-page .score-table thead { display: none; }
        #score-page .score-table tbody {
            display: grid;
            width: 100%;
            min-width: 0;
            gap: 0.5rem;
        }
        #score-page .score-table tr {
            display: block;
            width: 100%;
            min-width: 0;
            box-sizing: border-box;
            margin: 0;
            border: 1px solid #e2e8f0;
            border-radius: 0.75rem;
            background: #fff;
            padding: 0;
            transition: background-color 150ms ease;
        }
        #score-page .score-table tr:hover { background: #f8fafc; }
        #score-page .score-table td.score-desktop-cell { display: none; }
        #score-page .score-table td.score-mobile-card {
            display: block;
            width: 100%;
            box-sizing: border-box;
            border: 0;
            padding: 0.5rem 0.75rem;
            white-space: normal;
        }
        #score-page .score-mobile-header {
            margin-bottom: 0.5rem;
        }
        #score-page .score-mobile-identity { min-width: 0; }
        #score-page .score-mobile-meta {
            display: flex;
            flex-wrap: nowrap;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 0.25rem;
        }
        #score-page .score-mobile-number {
            display: inline-flex;
            width: 1.5rem;
            height: 1.5rem;
            align-items: center;
            justify-content: center;
            border-radius: 9999px;
            background: #f1f5f9;
            color: #64748b;
            font-size: 0.75rem;
            font-weight: 700;
        }
        #score-page .score-mobile-mstn {
            min-width: 0;
            overflow: hidden;
            color: #64748b;
            font-size: 0.75rem;
            font-weight: 600;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        #score-page .score-mobile-status {
            flex: 0 0 auto;
            margin-left: auto;
            border-radius: 9999px;
            background: #ecfdf5;
            padding: 0.25rem 0.625rem;
            color: #047857;
            font-size: 0.6875rem;
            font-weight: 700;
            line-height: 1rem;
        }
        #score-page .score-mobile-status.is-inactive {
            background: #fffbeb;
            color: #b45309;
        }
        #score-page .score-mobile-name {
            display: block;
            color: #0f172a;
            font-size: 0.875rem;
            font-weight: 700;
            line-height: 1.25rem;
            overflow-wrap: anywhere;
            white-space: normal;
        }
        #score-page .score-mobile-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            overflow: hidden;
            border: 1px solid #e2e8f0;
            border-radius: 0.75rem;
            background: #f8fafc;
        }
        #score-page .score-mobile-metric {
            min-width: 0;
            padding: 0.5rem 0.25rem;
            text-align: center;
        }
        #score-page .score-mobile-metric + .score-mobile-metric {
            border-left: 1px solid rgb(226 232 240 / 60%);
        }
        #score-page .score-mobile-metric-label {
            display: block;
            margin-bottom: 0.375rem;
            color: #64748b;
            font-family: "Roboto Local", Arial, sans-serif;
            font-size: 0.6875rem;
            font-weight: 800;
            line-height: 1.1;
            text-transform: uppercase;
        }
        #score-page .score-mobile-metric-value {
            color: #334155;
            font-size: 0.8125rem;
            font-weight: 700;
            line-height: 1rem;
        }
        #score-page .score-mobile-metric-total {
            border: 1px solid #dbeafe;
            border-radius: 0.625rem;
            background: #eff6ff;
        }
        #score-page .score-mobile-metric-total .score-mobile-metric-label { color: #2563eb; }
        #score-page .score-mobile-metric-total .score-mobile-metric-value {
            color: #1d4ed8;
            font-weight: 800;
        }
        #score-page .score-mobile-actions {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-top: 0.5rem;
            padding-top: 0.375rem;
            border-top: 1px solid #f1f5f9;
        }
        #score-page .score-mobile-actions .result-select {
            width: auto;
            min-height: 2rem;
            padding: 0.25rem 0.5rem;
            font-size: 0.75rem;
        }
        #score-page .score-mobile-actions .status-save-button {
            width: auto;
            min-height: 2rem;
            margin: 0;
            padding: 0.375rem 0.625rem;
            font-size: 0.75rem;
            white-space: nowrap;
        }
        #score-page .score-mobile-actions .result-locked { font-size: 0.6875rem; }
    }
</style>
<main class="min-h-screen bg-slate-50 text-slate-800 flex flex-col antialiased pb-16" id="score-page" data-academic-year="<%= academicYear %>" data-year-id="<%= selectedYearId %>">
    <% const scoreClassSummaries = [...new Map(scores.map(student => [student.id_lop, { ten_lop: student.ten_lop, ten_khoi: student.ten_khoi }])).values()]; %>

    <div class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col gap-6">
        <div id="score-toolbar-context" class="border border-slate-200 bg-white px-4 pt-4 sm:px-6 sm:pt-5 lg:px-8">
            <div class="mx-auto flex w-full max-w-7xl items-center justify-end gap-2 pb-3">
                <button
                    class="inline-flex h-10 shrink-0 items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-3 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50"
                    type="button" id="filter-retained-students" data-score-toolbar-button aria-pressed="false"
                    aria-label="Lọc học sinh ở lại lớp" title="Lọc học sinh ở lại lớp">
                    <i class="fa-solid fa-filter" aria-hidden="true"></i>
                    <span class="md:hidden" data-retained-filter-label-mobile>Ở lại</span>
                    <span class="hidden md:inline" data-retained-filter-label-desktop>Lọc ở lại</span>
                </button>
                <button
                    class="inline-flex h-10 shrink-0 items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-3 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50"
                    type="button" id="rank-student-scores" data-score-toolbar-button aria-pressed="false"
                    aria-label="Xếp hạng điểm trong từng lớp" title="Xếp hạng điểm trong từng lớp">
                    <i class="fa-solid fa-ranking-star" aria-hidden="true"></i>
                    <span class="md:hidden" data-score-ranking-label-mobile>Xếp hạng</span>
                    <span class="hidden md:inline" data-score-ranking-label-desktop>Xếp hạng điểm</span>
                </button>
            </div>
        </div>
        <section id="score-filter-sticky" class="sticky border border-slate-200 bg-white px-4 pb-4 shadow-sm sm:px-6 sm:pb-5 lg:px-8" aria-label="Tìm kiếm và in bảng điểm">
            <div class="mx-auto flex w-full max-w-7xl items-center gap-2">
                <label for="score-student-search" class="sr-only">Tìm tên hoặc mã số</label>
                <div class="relative min-w-0 flex-1">
                    <i class="fa-solid fa-magnifying-glass pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-slate-400" aria-hidden="true"></i>
                    <input id="score-student-search" type="search" data-table-search="[data-score-row]" data-search-groups="[data-score-card]" data-search-empty="#score-student-search-empty" placeholder="Tìm tên hoặc mã số..." autocomplete="off"
                        class="h-10 w-full rounded-xl border border-slate-200 bg-white py-2 pl-10 pr-3.5 text-sm text-slate-800 placeholder:text-slate-400 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20">
                </div>
                <button
                    class="inline-flex h-10 w-10 shrink-0 items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white text-slate-600 transition-colors hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50 md:w-auto md:px-3.5"
                    type="button"
                    id="open-score-print"
                    aria-label="In bảng điểm"
                    title="In bảng điểm"
                    <%= !scores.length ? 'disabled' : '' %>>
                    <i class="fa-solid fa-print" aria-hidden="true"></i>
                    <span class="hidden md:inline">In bảng điểm</span>
                </button>
            </div>
        </section>

    <dialog class="score-print-modal" id="score-print-modal" aria-labelledby="score-print-title">
        <div class="score-print-heading">
            <div>
                <span class="class-eyebrow">Bảng điểm</span>
                <h2 id="score-print-title">In bảng điểm</h2>
            </div>
            <button class="score-print-close" type="button" data-close-score-print aria-label="Đóng">&times;</button>
        </div>
        <div class="score-print-tabs" role="tablist" aria-label="Phạm vi bảng điểm">
            <button class="score-print-tab is-active" id="score-print-class-tab" type="button" role="tab" aria-selected="true" aria-controls="score-print-class-panel" data-score-print-tab="score-print-class-panel">
                <i class="fa-solid fa-school"></i> Lớp
            </button>
            <button class="score-print-tab" id="score-print-student-tab" type="button" role="tab" aria-selected="false" aria-controls="score-print-student-panel" data-score-print-tab="score-print-student-panel" tabindex="-1">
                <i class="fa-solid fa-user"></i> Cá nhân
            </button>
        </div>
        <div class="score-print-panel" id="score-print-class-panel" role="tabpanel" aria-labelledby="score-print-class-tab">
            <p>
                Bảng điểm trung bình của
                <% if (scoreClassSummaries.length) { %>
                    <% scoreClassSummaries.forEach((classItem, index) => { %><%= index ? ', lớp ' : 'lớp ' %><%= classItem.ten_lop %>, Khối <%= classItem.ten_khoi %><% }); %>
                <% } else { %>
                    các lớp được phân công.
                <% } %>
            </p>
        </div>
        <div class="score-print-panel" id="score-print-student-panel" role="tabpanel" aria-labelledby="score-print-student-tab" hidden>
            <span class="score-print-field-label">Chọn thiếu nhi</span>
            <div class="score-student-multiselect" id="score-student-multiselect">
                <button class="score-student-multiselect-toggle" type="button" id="score-student-multiselect-toggle" aria-expanded="false" aria-controls="score-student-multiselect-options">
                    <span id="score-student-multiselect-label">Chọn thiếu nhi</span>
                    <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                </button>
                <div class="score-student-multiselect-options" id="score-student-multiselect-options" role="group" aria-label="Chọn một hoặc nhiều thiếu nhi" hidden>
                    <input class="score-student-search" id="score-print-student-search" type="search" placeholder="Tên thánh họ và tên..." autocomplete="off" aria-label="Tìm thiếu nhi">
                    <div class="score-student-option-list" id="score-student-option-list">
                        <% scores.forEach(student => { %>
                            <label class="score-student-option" data-student-name="<%= [student.ten_thanh, student.ho_va_ten_lot, student.ten].filter(Boolean).join(' ') %>">
                                <input type="checkbox" value="<%= student.id_tn %>" data-class-id="<%= student.id_lop %>" data-score-student-option>
                                <span><%= [student.ten_thanh, student.ho_va_ten_lot, student.ten].filter(Boolean).join(' ') %></span>
                            </label>
                        <% }) %>
                    </div>
                    <p class="score-student-no-results" id="score-student-no-results" hidden>Không tìm thấy thiếu nhi phù hợp.</p>
                </div>
            </div>
        </div>
        <div class="score-print-actions">
            <button class="score-print-cancel" type="button" data-close-score-print>Hủy</button>
            <button class="score-print-confirm" type="button" id="confirm-score-print"><i class="fa-solid fa-print"></i> In bảng điểm</button>
        </div>
    </dialog>

    <% if (!scores.length) { %>
        <div class="empty-state"><i class="fa-solid fa-circle-exclamation"></i> Chưa có dữ liệu điểm trong các lớp được phân công.</div>
    <% } else { %>
        <div class="class-list">
            <% let currentClass = null; %>
            <% scores.forEach((student, index) => { %>
                <% const classKey = `${student.id_lop}-${student.ten_lop}`; %>
                <% const classStudentNumber = scores.filter(item => item.id_lop === student.id_lop).indexOf(student) + 1; %>
                <% if (currentClass !== classKey) { %>
                    <% if (currentClass !== null) { %></tbody></table></div></section><% } %>
                    <% currentClass = classKey; %>
                    <section class="class-card" data-score-card>
                        <div class="table-wrap">
                            <table class="student-table score-table">
                                <thead><tr><th>STT</th><th>Mã số</th><th>Họ và tên</th><th>Học tập</th><th>Chuyên cần</th><th>Kỷ luật</th><th>Tổng</th><th>Tình trạng</th><th></th></tr></thead>
                                <tbody>
                <% } %>
                <tr
                    data-score-row
                    data-student-id="<%= student.id_tn %>"
                    data-class-id="<%= student.id_lop %>"
                    data-class-name="<%= student.ten_lop %>"
                    data-grade-name="<%= student.ten_khoi %>"
                    data-mstn="<%= student.mstn || '' %>"
                    data-saint-name="<%= student.ten_thanh || '' %>"
                    data-last-names="<%= student.ho_va_ten_lot || '' %>"
                    data-first-name="<%= student.ten || '' %>"
                    data-learning-score="<%= student.diem_hoc_tap ?? '' %>"
                    data-discipline-score="<%= student.diem_ky_luat ?? '' %>"
                    data-attendance-score="<%= student.diem_chuyen_can ?? '' %>"
                    data-total-score="<%= student.diem_tong ?? '' %>"
                    data-score-sort-order="<%= index %>"
                    data-search="<%= `${student.mstn || ''} ${student.ten_thanh || ''} ${student.ho_va_ten_lot || ''} ${student.ten || ''}`.toLowerCase() %>"
                >
                    <td class="score-desktop-cell" data-score-student-number><%= classStudentNumber %></td>
                    <td class="score-desktop-cell"><%= student.mstn || '-' %></td>
                    <td class="score-desktop-cell"><strong><%= [student.ten_thanh, student.ho_va_ten_lot, student.ten].filter(Boolean).join(' ') %></strong></td>
                    <td class="score-desktop-cell" data-score-field="learning"><%= student.diem_hoc_tap ?? '-' %></td>
                    <td class="score-desktop-cell" data-score-field="attendance"><%= student.diem_chuyen_can ?? '-' %></td>
                    <td class="score-desktop-cell" data-score-field="discipline"><%= student.diem_ky_luat ?? '-' %></td>
                    <td class="score-desktop-cell" data-score-field="total"><strong><%= student.diem_tong ?? '-' %></strong></td>
                    <td class="score-desktop-cell student-status <%= student.tinh_trang === 'Đang học' || student.tinh_trang === 'Lên lớp' ? '' : 'is-inactive' %>" data-result-cell><%= student.tinh_trang || '-' %></td>
                    <td class="score-desktop-cell">
                        <% if (student.has_summary && student.trang_thai_phan_lop === 'Đang học') { %>
                            <select class="result-select" data-result-select data-student-id="<%= student.id_tn %>" aria-label="Kết quả của <%= student.ten %>">
                                <option value="Lên lớp" <%= student.tinh_trang === 'Lên lớp' ? 'selected' : '' %>>Lên lớp</option>
                                <option value="Ở lại lớp" <%= student.tinh_trang === 'Ở lại lớp' ? 'selected' : '' %>>Ở lại lớp</option>
                            </select>
                            <button type="button" class="status-save-button" data-result-save data-student-id="<%= student.id_tn %>"><i class="fa-solid fa-floppy-disk"></i> Lưu</button>
                        <% } else { %>
                            <span class="result-locked"><%= student.has_summary ? 'Không áp dụng' : 'Chưa tổng kết' %></span>
                        <% } %>
                    </td>
                    <td class="score-mobile-card" colspan="9">
                        <div class="score-mobile-header">
                            <div class="score-mobile-identity">
                                <div class="score-mobile-meta">
                                    <span class="score-mobile-number" data-score-student-number><%= classStudentNumber %></span>
                                    <span class="score-mobile-mstn"><%= student.mstn || '-' %></span>
                                    <span class="score-mobile-status <%= student.tinh_trang === 'Đang học' || student.tinh_trang === 'Lên lớp' ? '' : 'is-inactive' %>" data-result-cell><%= student.tinh_trang || '-' %></span>
                                </div>
                                <strong class="score-mobile-name"><%= [student.ten_thanh, student.ho_va_ten_lot, student.ten].filter(Boolean).join(' ') %></strong>
                            </div>
                        </div>
                        <div class="score-mobile-grid">
                            <div class="score-mobile-metric" data-score-field="learning">
                                <span class="score-mobile-metric-label">Học tập</span>
                                <strong class="score-mobile-metric-value"><%= student.diem_hoc_tap ?? '-' %></strong>
                            </div>
                            <div class="score-mobile-metric" data-score-field="attendance">
                                <span class="score-mobile-metric-label">C.cần</span>
                                <strong class="score-mobile-metric-value"><%= student.diem_chuyen_can ?? '-' %></strong>
                            </div>
                            <div class="score-mobile-metric" data-score-field="discipline">
                                <span class="score-mobile-metric-label">Kỷ luật</span>
                                <strong class="score-mobile-metric-value"><%= student.diem_ky_luat ?? '-' %></strong>
                            </div>
                            <div class="score-mobile-metric score-mobile-metric-total" data-score-field="total">
                                <span class="score-mobile-metric-label">Tổng</span>
                                <strong class="score-mobile-metric-value"><%= student.diem_tong ?? '-' %></strong>
                            </div>
                        </div>
                        <div class="score-mobile-actions">
                            <% if (student.has_summary && student.trang_thai_phan_lop === 'Đang học') { %>
                                <select class="result-select" data-result-select data-student-id="<%= student.id_tn %>" aria-label="Kết quả của <%= student.ten %>">
                                    <option value="Lên lớp" <%= student.tinh_trang === 'Lên lớp' ? 'selected' : '' %>>Lên lớp</option>
                                    <option value="Ở lại lớp" <%= student.tinh_trang === 'Ở lại lớp' ? 'selected' : '' %>>Ở lại lớp</option>
                                </select>
                                <button type="button" class="status-save-button" data-result-save data-student-id="<%= student.id_tn %>"><i class="fa-solid fa-floppy-disk"></i> Lưu</button>
                            <% } else { %>
                                <span class="result-locked"><%= student.has_summary ? 'Không áp dụng' : 'Chưa tổng kết' %></span>
                            <% } %>
                        </div>
                    </td>
                </tr>
                <% if (index === scores.length - 1) { %></tbody></table></div></section><% } %>
            <% }) %>
        </div>
        <%- include('../partials/pagination', {
            mode: 'client',
            currentPage: 1,
            totalPages: Math.max(Math.ceil(scores.length / 25), 1),
            totalItems: scores.length,
            pageSize: 25,
            rows: '[data-score-row]',
            groups: '[data-score-card]',
            sortAttribute: 'data-score-sort-order'
        }) %>
        <div class="empty-state search-hidden" id="score-student-search-empty">Không tìm thấy thiếu nhi phù hợp.</div>
        <div class="empty-state" id="score-retained-empty" hidden>Không có em nào ở lại lớp phù hợp.</div>
    <% } %>
    </div>
</main>

<script src="/js/table-search.js" defer></script>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/glv/glv-bang-diem.js" defer></script>