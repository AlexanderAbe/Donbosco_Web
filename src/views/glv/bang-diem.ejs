<main class="min-h-screen bg-slate-50 text-slate-800 flex flex-col antialiased pb-16" id="score-page" data-academic-year="<%= academicYear %>" data-year-id="<%= selectedYearId %>">
    <% const scoreClassSummaries = [...new Map(scores.map(student => [student.id_lop, { ten_lop: student.ten_lop, ten_khoi: student.ten_khoi }])).values()]; %>
    <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-xs">
        <div class="max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-blue-600 flex items-center justify-center text-white shadow-md shadow-blue-500/20">
                    <i class="fa-solid fa-chart-column text-lg"></i>
                </div>
                <div>
                    <span class="glv-page-label text-sm font-semibold text-blue-600 block">Quản lý lớp học</span>
                    <h1 class="text-base sm:text-lg font-bold text-slate-900 leading-tight">Bảng điểm thiếu nhi</h1>
                </div>
            </div>
        </div>
    </header>

    <div class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col gap-6">
        <p class="text-sm text-slate-500">Điểm số được cập nhật tính tới thời điểm hiện tại.</p>

        <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm grid grid-cols-1 sm:grid-cols-2 gap-4 items-end">
            <div class="space-y-1.5">
                <label for="score-student-search" class="text-xs font-bold uppercase tracking-wider text-slate-500 flex items-center gap-1.5">
                    <i class="fa-solid fa-magnifying-glass text-blue-600"></i> Tìm kiếm thiếu nhi
                </label>
                <input id="score-student-search" type="search" data-table-search="[data-score-row]" data-search-groups="[data-score-card]" data-search-empty="#score-student-search-empty" placeholder="Tên hoặc mã số..." autocomplete="off"
                    class="w-full px-3.5 py-2.5 text-sm bg-slate-50/50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition-all">
            </div>
            <button class="inline-flex w-fit items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm transition-all shadow-md shadow-blue-500/25 active:scale-[0.98]" type="button" id="open-score-print">
                <i class="fa-solid fa-print"></i> In bảng điểm
            </button>
        </div>

    <dialog class="score-print-modal" id="score-print-modal" aria-labelledby="score-print-title">
        <div class="score-print-heading">
            <div>
                <span class="class-eyebrow">Bảng điểm</span>
                <h2 id="score-print-title">In bảng điểm</h2>
            </div>
            <button class="score-print-close" type="button" data-close-score-print aria-label="Đóng">&times;</button>
        </div>
        <div class="score-print-tabs" role="tablist" aria-label="Phạm vi bảng điểm">
            <button class="score-print-tab is-active" id="score-print-class-tab" type="button" role="tab" aria-selected="true" aria-controls="score-print-class-panel" data-score-print-tab="score-print-class-panel">
                <i class="fa-solid fa-school"></i> Lớp
            </button>
            <button class="score-print-tab" id="score-print-student-tab" type="button" role="tab" aria-selected="false" aria-controls="score-print-student-panel" data-score-print-tab="score-print-student-panel" tabindex="-1">
                <i class="fa-solid fa-user"></i> Cá nhân
            </button>
        </div>
        <div class="score-print-panel" id="score-print-class-panel" role="tabpanel" aria-labelledby="score-print-class-tab">
            <p>
                Bảng điểm trung bình của
                <% if (scoreClassSummaries.length) { %>
                    <% scoreClassSummaries.forEach((classItem, index) => { %><%= index ? ', lớp ' : 'lớp ' %><%= classItem.ten_lop %>, Khối <%= classItem.ten_khoi %><% }); %>
                <% } else { %>
                    các lớp được phân công.
                <% } %>
            </p>
        </div>
        <div class="score-print-panel" id="score-print-student-panel" role="tabpanel" aria-labelledby="score-print-student-tab" hidden>
            <span class="score-print-field-label">Chọn thiếu nhi</span>
            <div class="score-student-multiselect" id="score-student-multiselect">
                <button class="score-student-multiselect-toggle" type="button" id="score-student-multiselect-toggle" aria-expanded="false" aria-controls="score-student-multiselect-options">
                    <span id="score-student-multiselect-label">Chọn thiếu nhi</span>
                    <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                </button>
                <div class="score-student-multiselect-options" id="score-student-multiselect-options" role="group" aria-label="Chọn một hoặc nhiều thiếu nhi" hidden>
                    <input class="score-student-search" id="score-print-student-search" type="search" placeholder="Tên thánh họ và tên..." autocomplete="off" aria-label="Tìm thiếu nhi">
                    <div class="score-student-option-list" id="score-student-option-list">
                        <% scores.forEach(student => { %>
                            <label class="score-student-option" data-student-name="<%= [student.ten_thanh, student.ho_va_ten_lot, student.ten].filter(Boolean).join(' ') %>">
                                <input type="checkbox" value="<%= student.id_tn %>" data-class-id="<%= student.id_lop %>" data-score-student-option>
                                <span><%= [student.ten_thanh, student.ho_va_ten_lot, student.ten].filter(Boolean).join(' ') %></span>
                            </label>
                        <% }) %>
                    </div>
                    <p class="score-student-no-results" id="score-student-no-results" hidden>Không tìm thấy thiếu nhi phù hợp.</p>
                </div>
            </div>
        </div>
        <div class="score-print-actions">
            <button class="score-print-cancel" type="button" data-close-score-print>Hủy</button>
            <button class="score-print-confirm" type="button" id="confirm-score-print"><i class="fa-solid fa-print"></i> In bảng điểm</button>
        </div>
    </dialog>

    <% if (!scores.length) { %>
        <div class="empty-state"><i class="fa-solid fa-circle-exclamation"></i> Chưa có dữ liệu điểm trong các lớp được phân công.</div>
    <% } else { %>
        <div class="class-list">
            <% let currentClass = null; %>
            <% scores.forEach((student, index) => { %>
                <% const classKey = `${student.id_lop}-${student.ten_lop}`; %>
                <% if (currentClass !== classKey) { %>
                    <% if (currentClass !== null) { %></tbody></table></div></section><% } %>
                    <% currentClass = classKey; %>
                    <section class="class-card" data-score-card>
                        <div class="class-card-header">
                            <h2><i class="fa-solid fa-school"></i> <%= student.ten_khoi %> - <%= student.ten_lop %></h2>
                        </div>
                        <div class="table-wrap">
                            <table class="student-table score-table">
                                <thead><tr><th>STT</th><th>Mã số</th><th>Họ và tên</th><th>Học tập</th><th>Chuyên cần</th><th>Kỷ luật</th><th>Tổng</th><th>Tình trạng</th><th></th></tr></thead>
                                <tbody>
                <% } %>
                <tr
                    data-score-row
                    data-student-id="<%= student.id_tn %>"
                    data-class-id="<%= student.id_lop %>"
                    data-class-name="<%= student.ten_lop %>"
                    data-grade-name="<%= student.ten_khoi %>"
                    data-mstn="<%= student.mstn || '' %>"
                    data-saint-name="<%= student.ten_thanh || '' %>"
                    data-last-names="<%= student.ho_va_ten_lot || '' %>"
                    data-first-name="<%= student.ten || '' %>"
                    data-learning-score="<%= student.diem_hoc_tap ?? '' %>"
                    data-discipline-score="<%= student.diem_ky_luat ?? '' %>"
                    data-attendance-score="<%= student.diem_chuyen_can ?? '' %>"
                    data-total-score="<%= student.diem_tong ?? '' %>"
                    data-search="<%= `${student.mstn || ''} ${student.ten_thanh || ''} ${student.ho_va_ten_lot || ''} ${student.ten || ''}`.toLowerCase() %>"
                >
                    <td><%= scores.filter(item => item.id_lop === student.id_lop).indexOf(student) + 1 %></td>
                    <td><%= student.mstn || '-' %></td>
                    <td><strong><%= [student.ten_thanh, student.ho_va_ten_lot, student.ten].filter(Boolean).join(' ') %></strong></td>
                    <td data-score-field="learning"><%= student.diem_hoc_tap ?? '-' %></td>
                    <td data-score-field="attendance"><%= student.diem_chuyen_can ?? '-' %></td>
                    <td data-score-field="discipline"><%= student.diem_ky_luat ?? '-' %></td>
                    <td data-score-field="total"><strong><%= student.diem_tong ?? '-' %></strong></td>
                    <td class="student-status <%= student.tinh_trang === 'Đang học' || student.tinh_trang === 'Lên lớp' ? '' : 'is-inactive' %>" data-result-cell><%= student.tinh_trang || '-' %></td>
                    <td>
                        <% if (student.has_summary && student.trang_thai_phan_lop === 'Đang học') { %>
                            <select class="result-select" data-result-select data-student-id="<%= student.id_tn %>" aria-label="Kết quả của <%= student.ten %>">
                                <option value="Lên lớp" <%= student.tinh_trang === 'Lên lớp' ? 'selected' : '' %>>Lên lớp</option>
                                <option value="Ở lại lớp" <%= student.tinh_trang === 'Ở lại lớp' ? 'selected' : '' %>>Ở lại lớp</option>
                            </select>
                            <button type="button" class="status-save-button" data-result-save data-student-id="<%= student.id_tn %>"><i class="fa-solid fa-floppy-disk"></i> Lưu</button>
                        <% } else { %>
                            <span class="result-locked"><%= student.has_summary ? 'Không áp dụng' : 'Chưa tổng kết' %></span>
                        <% } %>
                    </td>
                </tr>
                <% if (index === scores.length - 1) { %></tbody></table></div></section><% } %>
            <% }) %>
        </div>
        <%- include('../partials/pagination', {
            mode: 'client',
            currentPage: 1,
            totalPages: Math.max(Math.ceil(scores.length / 25), 1),
            totalItems: scores.length,
            pageSize: 25,
            rows: '[data-score-row]',
            groups: '[data-score-card]'
        }) %>
        <div class="empty-state search-hidden" id="score-student-search-empty">Không tìm thấy thiếu nhi phù hợp.</div>
    <% } %>
    </div>
</main>

<script src="/js/table-search.js" defer></script>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/glv/glv-bang-diem.js" defer></script>