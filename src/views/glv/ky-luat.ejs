<style>
    .discipline-month-context {
        width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-top: -2.5rem;
        border-radius: 3rem 3rem 0 0;
        border-bottom-width: 0;
    }
    #discipline-filter-sticky {
        position: sticky;
        top: 68px;
        z-index: 20;
        width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-top: -1.5rem;
        border-radius: 0 0 3rem 3rem;
        border-top-width: 0;
    }
    #discipline-save-status.discipline-save-status--saved {
        background-color: #ecfdf5;
        color: #047857;
        border-color: #a7f3d0;
    }
    #discipline-save-status.discipline-save-status--pending {
        background-color: #fffbeb;
        color: #b45309;
        border-color: #fde68a;
    }
    @media (max-width: 768px) {
        #discipline-score-form .discipline-score-entry {
            display: grid;
            grid-template-columns: auto minmax(0, 1fr);
            align-items: center;
            gap: 0.75rem;
        }
        #discipline-score-form [data-discipline-layout="mobile"] .discipline-input {
            width: 100%;
            max-width: none;
        }
    }
    @media (min-width: 640px) {
        .discipline-month-context {
            margin-top: -3rem;
        }
    }
    @media (min-width: 1025px) {
        #discipline-filter-sticky {
            top: 98px;
            width: calc(100vw - 280px);
            margin-left: calc(50% - 50vw + 140px);
        }
        .discipline-month-context {
            width: calc(100vw - 280px);
            margin-left: calc(50% - 50vw + 140px);
            margin-top: -3rem;
        }
        #discipline-month { width: 14rem; }
    }
</style>
<main class="min-h-screen bg-slate-50 text-slate-800 flex flex-col antialiased pb-16 [&_.search-hidden]:hidden!">

    <div class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col gap-6">
    <% if (!classes.length) { %>
        <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center text-slate-500 shadow-sm"><i class="fa-solid fa-triangle-exclamation mr-2 text-amber-500"></i> Bạn chưa được phân công lớp trong niên khóa này.</div>
    <% } else { %>
        <form id="discipline-filter" class="contents" method="GET" action="/glv/ky-luat">
            <div class="discipline-month-context border border-slate-200 bg-white px-4 py-4 shadow-sm sm:px-6 sm:py-5 lg:px-8">
                <div class="min-w-0 md:w-56">
                    <label for="discipline-month" class="mb-1 block text-xs font-semibold text-slate-600">Kỷ luật</label>
                    <select id="discipline-month" name="thang" class="h-10 w-full rounded-lg border border-slate-200 bg-slate-100 px-3 text-sm font-medium text-slate-700 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20 md:h-11">
                        <% for (let month = 1; month <= 12; month += 1) { %>
                            <option value="<%= month %>" <%= month === selectedMonth ? 'selected' : '' %>>Tháng <%= month %></option>
                        <% } %>
                    </select>
                </div>
            </div>
            <section id="discipline-filter-sticky" class="sticky border border-slate-200 bg-white px-4 pb-4 shadow-sm sm:px-6 sm:pb-5 lg:px-8 flex flex-col gap-3" aria-label="Trạng thái và thao tác kỷ luật">
                <% const disciplineSavedCount = students.filter(student => student.da_luu).length; %>
                <div class="flex justify-end md:ml-auto">
                    <span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs font-medium <%= students.length && disciplineSavedCount === students.length ? 'discipline-save-status--saved' : 'discipline-save-status--pending' %>" id="discipline-save-status">
                        <i class="fa-solid <%= students.length && disciplineSavedCount === students.length ? 'fa-circle-check' : 'fa-clock' %>"></i>
                        <span id="discipline-save-status-text">Đã lưu <%= disciplineSavedCount %>/<%= students.length %></span>
                    </span>
                </div>
            <div class="flex items-center gap-2">
                <label for="discipline-search" class="sr-only">Tìm tên hoặc mã số</label>
                <div class="relative min-w-0 flex-1">
                    <i class="fa-solid fa-magnifying-glass pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-slate-400" aria-hidden="true"></i>
                    <input id="discipline-search" type="search" data-table-search="[data-discipline-row]" data-search-empty="#discipline-search-empty" placeholder="Tìm tên hoặc mã số..." autocomplete="off"
                        class="h-10 w-full rounded-xl border border-slate-200 bg-white py-2 pl-10 pr-3.5 text-sm text-slate-800 placeholder:text-slate-400 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20">
                </div>
                <button
                    class="inline-flex h-10 w-10 shrink-0 items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white text-slate-600 transition-colors hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50 md:w-auto md:px-3.5"
                    type="button"
                    id="print-discipline-year"
                    data-class-id="<%= selectedClassId || '' %>"
                    aria-label="In điểm kỷ luật"
                    title="In điểm kỷ luật"
                    <%= !selectedClassId || !students.length ? 'disabled' : '' %>>
                    <i class="fa-solid fa-print" aria-hidden="true"></i>
                    <span class="hidden md:inline">In điểm kỷ luật</span>
                </button>
            </section>
        </form>

        <form method="POST" action="/glv/ky-luat/save" id="discipline-score-form" class="flex flex-col gap-6 flex-1"
            data-save-url="/glv/ky-luat/entry-save"
            data-year-id="<%= selectedYearId %>"
            data-class-id="<%= selectedClassId %>"
            data-month="<%= selectedMonth %>">
            <input type="hidden" name="nien_khoa" value="<%= selectedYearId %>">
            <input type="hidden" name="id_lop" value="<%= selectedClassId %>">
            <input type="hidden" name="thang" value="<%= selectedMonth %>">
            
            <% if (!students.length) { %>
                <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center text-slate-500"><i class="fa-solid fa-user-slash mr-2 text-slate-400"></i> Lớp chưa có thiếu nhi.</div>
            <% } else { %>
                <div class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm max-md:overflow-visible max-md:border-0 max-md:bg-transparent max-md:shadow-none">
                    <div class="hidden overflow-x-auto md:block" data-discipline-layout="desktop">
                        <table class="w-full min-w-175 table-fixed border-collapse text-left text-sm">
                            <colgroup>
                                <col style="width: 8%">
                                <col style="width: 14%">
                                <col style="width: 54%">
                                <col style="width: 24%">
                            </colgroup>
                            <thead>
                                <tr class="border-b border-slate-200 bg-slate-50/75 text-[11px] font-bold uppercase tracking-wider text-slate-500">
                                    <th class="w-16 px-4 py-3.5 text-center">STT</th>
                                    <th class="w-32 px-4 py-3.5">MSTN</th>
                                    <th class="px-4 py-3.5">Họ và tên</th>
                                    <th class="w-40 px-4 py-3.5 text-center">Điểm kỷ luật</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                <% students.forEach((student, index) => { %>
                                    <tr data-discipline-row data-student-id="<%= student.id_tn %>" data-saved="<%= student.da_luu ? 'true' : 'false' %>" data-search="<%= `${student.mstn || ''} ${student.ten_thanh || ''} ${student.ho_va_ten_lot || ''} ${student.ten || ''}`.toLowerCase() %>" class="group transition-colors hover:bg-blue-50/30">
                                        <td class="px-4 py-3.5 text-center font-medium text-slate-400"><%= index + 1 %></td>
                                        <td class="px-4 py-3.5"><%= student.mstn || '-' %></td>
                                        <td class="px-4 py-3.5 font-semibold text-slate-900"><%= [student.ten_thanh, student.ho_va_ten_lot, student.ten].filter(Boolean).join(' ') %></td>
                                        <td class="px-4 py-3.5 text-center">
                                            <input class="discipline-input w-24 rounded-xl border border-slate-200 bg-slate-50 px-3 py-1.5 text-center font-bold text-slate-800 shadow-2xs transition-all focus:border-blue-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 disabled:cursor-not-allowed disabled:opacity-50"
                                                type="number" name="scores[<%= index %>][diem]" min="0" max="10" step="0.01" value="<%= student.diem ?? '' %>">
                                            <input type="hidden" name="scores[<%= index %>][id_tn]" value="<%= student.id_tn %>">
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <div class="space-y-3 md:hidden" data-discipline-layout="mobile">
                        <% students.forEach((student, index) => { %>
                            <div data-discipline-row data-student-id="<%= student.id_tn %>" data-saved="<%= student.da_luu ? 'true' : 'false' %>" data-search="<%= `${student.mstn || ''} ${student.ten_thanh || ''} ${student.ho_va_ten_lot || ''} ${student.ten || ''}`.toLowerCase() %>" class="flex flex-col gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 transition-colors hover:bg-slate-50/50">
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center space-x-2">
                                        <span class="flex h-6 w-6 items-center justify-center rounded-full bg-slate-100 text-xs font-bold text-slate-500"><%= index + 1 %></span>
                                        <span class="text-xs font-semibold text-slate-500"><%= student.mstn || '-' %></span>
                                    </div>
                                </div>
                                <div class="text-sm font-bold leading-snug text-slate-900"><%= [student.ten_thanh, student.ho_va_ten_lot, student.ten].filter(Boolean).join(' ') %></div>
                                <div class="discipline-score-entry">
                                    <label for="discipline-score-mob-<%= index %>" class="text-xs font-bold uppercase text-slate-500">Điểm:</label>
                                    <input id="discipline-score-mob-<%= index %>" class="discipline-input min-w-0 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-center text-base font-bold text-slate-800 shadow-2xs transition-all focus:border-blue-600 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 disabled:cursor-not-allowed disabled:opacity-50"
                                        type="number" name="scores[<%= index %>][diem]" min="0" max="10" step="0.01" value="<%= student.diem ?? '' %>">
                                    <input type="hidden" name="scores[<%= index %>][id_tn]" value="<%= student.id_tn %>">
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            <% } %>
            <div class="search-hidden rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center text-slate-500" id="discipline-search-empty">Không tìm thấy thiếu nhi phù hợp.</div>
        </form>

        <%- include('../partials/pagination', {
            mode: 'client',
            currentPage: 1,
            totalPages: Math.max(Math.ceil(students.length / 25), 1),
            totalItems: students.length,
            pageSize: 25,
            rows: '[data-discipline-row]',
            rowGroupAttribute: 'data-student-id'
        }) %>

        <dialog class="m-auto max-h-[calc(100vh-2.5rem)] w-[calc(100vw-2rem)] max-w-115 rounded-2xl border-0 p-0 text-slate-800 shadow-2xl backdrop:bg-slate-900/60 backdrop:backdrop-blur-sm" id="discipline-print-modal" aria-labelledby="discipline-print-modal-title">
            <div class="flex items-start justify-between gap-4 border-b border-slate-200 px-6 pb-4 pt-5">
                <div>
                    <span class="text-[10px] font-extrabold uppercase tracking-widest text-blue-600">Điểm kỷ luật</span>
                    <h2 class="mt-1 text-xl font-bold text-slate-900" id="discipline-print-modal-title">In điểm kỷ luật cả niên khóa</h2>
                </div>
                <button class="rounded-full p-1 text-2xl leading-none text-slate-500 hover:bg-slate-100 hover:text-slate-800" type="button" data-close-discipline-print aria-label="Đóng">&times;</button>
            </div>
            <div class="px-6 py-5 leading-relaxed text-slate-600">
                <p class="m-0">Sẽ in toàn bộ điểm 12 tháng của lớp trong niên khóa <strong class="text-slate-900"><%= academicYear %></strong>. Tháng được sắp xếp từ tháng 9 đến tháng 8.</p>
            </div>
            <div class="flex justify-end gap-3 border-t border-slate-200 px-6 py-4">
                <button class="inline-flex min-h-10 items-center justify-center rounded-xl bg-slate-100 px-4 py-2 font-semibold text-slate-700 hover:bg-slate-200" type="button" data-close-discipline-print>Hủy</button>
                <button class="inline-flex min-h-10 items-center justify-center gap-2 rounded-xl bg-blue-600 px-4 py-2 font-semibold text-white hover:bg-blue-700 disabled:cursor-not-allowed disabled:opacity-60" type="button" id="confirm-discipline-print">
                    <i class="fa-solid fa-print"></i> Xác nhận in
                </button>
            </div>
        </dialog>
    <% } %>
</div>
</main>

<script src="/js/table-search.js" defer></script>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/glv/glv-ky-luat.js" defer></script>