<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hỗ Trợ Mật Khẩu - Hệ Thống Quản Lý</title>
    <link rel="icon" type="image/png" href="/imgs/Logo.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/reset.css">
    <!-- Liên kết đến file CSS riêng biệt -->
    <link rel="stylesheet" href="/css/forgot-password.css">
</head>
<body>
    <!-- Toast thông báo hệ thống -->
    <%- include('partials/toast') %>

    <div class="auth-page-wrapper">
        <main class="auth-card">
            
            <!-- Header trang -->
            <header class="auth-header">
                <div class="auth-logo-wrapper">
                    <!-- Thay đổi src="/imgs/Logo.png" theo đúng đường dẫn file logo thực tế của bạn -->
                    <img src="/imgs/Logo.png" alt="Logo Xứ Đoàn Don Bosco" class="auth-logo-img">
                </div>
                <h1>Hỗ Trợ Mật Khẩu</h1>
                <p class="auth-description">
                    Hệ thống bảo mật yêu cầu xác thực thủ công để cấp lại mật khẩu mới. Vui lòng nhắn tin trực tiếp qua Zalo cho Quản trị viên dưới đây:
                </p>
            </header>

            <!-- Khu vực hiển thị danh sách Quản trị viên -->
            <section class="admin-list-section">
                <% if (adminList && adminList.length > 0) { %>
                    <div class="admin-cards-container">
                        <% adminList.forEach(admin => { %>
                            <div class="admin-info-card">
                                <div class="admin-info-left">
                                    <div class="admin-avatar-icon">
                                        <i class="fa-solid fa-user-shield"></i>
                                    </div>
                                    <div class="admin-details">
                                        <span class="admin-name"><%= admin.ho_ten %></span>
                                        <!-- Bạn có thể thay thế số điện thoại Zalo tương ứng từ cơ sở dữ liệu nếu có, ví dụ: admin.sdt -->
                                        <span class="admin-zalo">Zalo hỗ trợ nội bộ</span>
                                    </div>
                                </div>
                                <span class="zalo-badge">
                                    <i class="fa-solid fa-comment-dots"></i> Zalo Only
                                </span>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="admin-empty-box">
                        <p>Chưa có thông tin quản trị viên. Vui lòng liên hệ ban điều hành.</p>
                    </div>
                <% } %>
            </section>

            <!-- Khu vực quay lại -->
            <nav class="auth-footer-action">
                <a href="/auth/login" class="btn-back">
                    <i class="fa-solid fa-arrow-left"></i> Quay lại trang đăng nhập
                </a>
            </nav>

            <!-- Chân trang -->
            <footer class="auth-footer">
                <p>Hệ thống quản lý nội bộ • Xứ Đoàn Don Bosco</p>
            </footer>

        </main>
    </div>
</body>
</html>