<link rel="stylesheet" href="/css/reset.css">
<link rel="stylesheet" href="/css/bdh/bdh-thieu-nhi.css">
<link rel="stylesheet" href="/css/student-profile-modal.css">

<div class="tn-page" data-year-id="<%= selectedYearId %>">
    <div class="page-toolbar">
        <div class="page-heading-wrapper" style="display: flex; justify-content: space-between; align-items: center; width: 100%; margin-bottom: 15px;">
            <div class="page-heading">
                <h1>Danh sách Thiếu Nhi</h1>
                <p>Tra cứu theo niên khóa, khối, lớp và thông tin cơ bản.</p>
            </div>
            <div class="page-actions">
                <button type="button" class="btn btn-view" id="btnOpenCaDoan" <%= !selectedYearId ? 'disabled' : '' %>>
                    Chọn thành viên ca đoàn
                </button>
                <button type="button" class="btn btn-primary" id="btnOpenImport">
                    + Import Thiếu Nhi
                </button>
            </div>
        </div>
        
        <form method="GET" action="/bdh/thieu-nhi" class="filter-form">
            <div class="field-group search-field">
                <label for="tn-search">Tìm kiếm</label>
                <input id="tn-search" type="search" name="search" value="<%= search %>" placeholder="Tên, thánh danh, mã số, phụ huynh...">
            </div>
            <div class="field-group">
                <label for="tn-year">Niên khóa</label>
                <select id="tn-year" name="nien_khoa" onchange="this.form.submit()">
                    <% years.forEach(year => { %>
                        <option value="<%= year.id_cau_hinh_nam_hoc %>" <%= year.id_cau_hinh_nam_hoc === selectedYearId ? 'selected' : '' %>><%= year.nien_khoa %></option>
                    <% }) %>
                </select>
            </div>
            <div class="field-group">
                <label for="tn-khoi">Khối</label>
                <select id="tn-khoi" name="id_khoi">
                    <option value="">Tất cả khối</option>
                    <% khoiList.forEach(khoi => { %>
                        <option value="<%= khoi.id_khoi %>" <%= khoi.id_khoi === selectedKhoiId ? 'selected' : '' %>><%= khoi.ten_khoi %></option>
                    <% }) %>
                </select>
            </div>
            <div class="field-group">
                <label for="tn-lop">Lớp</label>
                <select id="tn-lop" name="id_lop">
                    <option value="">Tất cả lớp</option>
                    <% lopList.forEach(lop => { %>
                        <option value="<%= lop.id_lop %>" data-khoi="<%= lop.id_khoi %>" <%= lop.id_lop === selectedLopId ? 'selected' : '' %>><%= lop.ten_khoi %> - <%= lop.ten_lop %></option>
                    <% }) %>
                </select>
            </div>
            <div class="field-group">
                <label for="tn-gender">Giới tính</label>
                <select id="tn-gender" name="gioi_tinh">
                    <option value="">Tất cả</option>
                    <option value="Nam" <%= selectedGender === 'Nam' ? 'selected' : '' %>>Nam</option>
                    <option value="Nữ" <%= selectedGender === 'Nữ' ? 'selected' : '' %>>Nữ</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Lọc</button>
        </form>
    </div>

    <section class="section-card">
    <div class="section-header">
        <h2>Danh sách thiếu nhi</h2>
        <span><%= total %> em</span>
    </div>
    <% if (updatedCaDoan) { %>
        <div class="tn-notice" role="status">Đã cập nhật thành viên ca đoàn.</div>
    <% } %>
    <% if (!students.length) { %>
        <div class="empty-state">Không tìm thấy dữ liệu phù hợp.</div>
    <% } else { %>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Họ và tên</th>
                        <th>Ngày sinh</th>
                        <th>Giới tính</th> <!-- Đã bổ sung chuẩn theo header -->
                        <th>Mã số</th>
                        <th>Lớp</th>
                        <th>Khối</th>
                        <th>Trạng thái</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <% students.forEach(student => { %>
                        <tr>
                            <td><strong><%= student.ho_ten %></strong></td>
                            <td><%= student.ngay_sinh %></td>
                            <td><%= student.gioi_tinh || 'Chưa rõ' %></td> <!-- Thêm ô này để khớp cột Giới tính -->
                            <td><%= student.mstn || 'Chưa có' %></td>
                            <td><%= student.ten_lop || 'Chưa có' %></td>
                            <td><%= student.ten_khoi || 'Chưa có' %></td>
                            <td><%= student.trang_thai || 'Đang học' %></td>
                            <td><button type="button" class="btn btn-view view-student" data-id="<%= student.id_tn %>">Xem chi tiết</button></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
        <%- include('../partials/pagination', {
            mode: 'server',
            currentPage: page,
            totalPages,
            totalItems: total,
            pageSize: limit
        }) %>
    <% } %>
</section>
</div>

<div class="tn-modal ca-doan-modal" id="ca-doan-modal" aria-hidden="true">
    <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="ca-doan-modal-title">
        <div class="modal-header">
            <div>
                <span>Quản lý thành viên</span>
                <h2 id="ca-doan-modal-title">Chọn thiếu nhi thuộc ca đoàn</h2>
            </div>
            <button type="button" class="modal-close-ca-doan" aria-label="Đóng">×</button>
        </div>
        <div class="modal-body">
            <div class="ca-doan-tabs" role="tablist" aria-label="Danh sách ca đoàn">
                <button type="button" class="ca-doan-tab is-active" id="ca-doan-tab-select" role="tab" aria-selected="true" aria-controls="ca-doan-panel-select" data-ca-doan-tab="select">
                    Chọn thành viên
                </button>
                <button type="button" class="ca-doan-tab" id="ca-doan-tab-members" role="tab" aria-selected="false" aria-controls="ca-doan-panel-members" data-ca-doan-tab="members">
                    Danh sách ca đoàn
                </button>
            </div>
            <div class="ca-doan-filters">
                <label class="field-group ca-doan-search">
                    <span>Tìm theo tên hoặc mã thiếu nhi</span>
                    <input type="search" id="ca-doan-search" placeholder="Nhập tên, thánh danh hoặc mã số...">
                </label>
                <label class="field-group ca-doan-class-filter">
                    <span>Lớp</span>
                    <select id="ca-doan-lop">
                        <option value="">Tất cả lớp</option>
                        <% lopList.forEach(lop => { %>
                            <option value="<%= lop.id_lop %>" data-khoi="<%= lop.id_khoi %>"><%= lop.ten_khoi %> - <%= lop.ten_lop %></option>
                        <% }) %>
                    </select>
                </label>
                <button type="button" class="ca-doan-filter-toggle" id="ca-doan-filter-toggle" aria-expanded="false" aria-controls="ca-doan-advanced-filters">
                    Mở rộng bộ lọc
                </button>
                <div class="ca-doan-advanced-filters" id="ca-doan-advanced-filters">
                    <label class="field-group">
                        <span>Khối</span>
                        <select id="ca-doan-khoi">
                            <option value="">Tất cả khối</option>
                            <% khoiList.forEach(khoi => { %>
                                <option value="<%= khoi.id_khoi %>"><%= khoi.ten_khoi %></option>
                            <% }) %>
                        </select>
                    </label>
                    <label class="field-group">
                        <span>Giới tính</span>
                        <select id="ca-doan-gioi-tinh">
                            <option value="">Tất cả</option>
                            <option value="Nam">Nam</option>
                            <option value="Nữ">Nữ</option>
                        </select>
                    </label>
                    <label class="field-group ca-doan-status-filter">
                        <span>Thành viên</span>
                        <select id="ca-doan-trang-thai">
                            <option value="">Tất cả</option>
                            <option value="0">Chưa thuộc ca đoàn</option>
                            <option value="1">Đã thuộc ca đoàn</option>
                        </select>
                    </label>
                </div>
            </div>
            <div id="ca-doan-panel-select" role="tabpanel" aria-labelledby="ca-doan-tab-select">
            <div class="ca-doan-selection-tools">
                <label><input type="checkbox" id="ca-doan-select-page"> Chọn tất cả trên trang này</label>
                <span id="ca-doan-change-count" aria-live="polite">Chưa có thay đổi</span>
            </div>
            <div class="ca-doan-results" id="ca-doan-results" aria-live="polite">
                <p class="empty-state">Đang tải danh sách...</p>
            </div>
            </div>
            <div id="ca-doan-panel-members" role="tabpanel" aria-labelledby="ca-doan-tab-members" hidden>
                <div class="ca-doan-members-results" id="ca-doan-members-results" aria-live="polite">
                    <p class="empty-state">Mở tab để tải danh sách thành viên.</p>
                </div>
            </div>
            <div class="ca-doan-pagination">
                <button type="button" class="btn btn-view" id="ca-doan-prev" disabled>Trước</button>
                <span id="ca-doan-page-info">Trang 1</span>
                <button type="button" class="btn btn-view" id="ca-doan-next" disabled>Sau</button>
            </div>
            <p class="ca-doan-message" id="ca-doan-message" role="status"></p>
        </div>
        <div class="modal-footer ca-doan-footer">
            <button type="button" class="btn btn-secondary modal-close-ca-doan">Đóng</button>
            <button type="button" class="btn btn-primary" id="ca-doan-save" disabled>Lưu thay đổi</button>
        </div>
    </div>
</div>

<%- include('../partials/student-profile-modal', {
    modalClass: 'tn-modal',
    modalId: 'student-modal',
    bodyId: 'student-detail',
    titleId: 'student-modal-title',
    showHistory: true,
    allowEdit: true,
    closeClass: 'btn btn-secondary',
    cancelId: 'student-modal-cancel'
}) %>

<!-- Modal Import Excel -->
<div class="tn-modal" id="import-modal" aria-hidden="true">
    <div class="modal-dialog" role="dialog" aria-modal="true">
        <div class="modal-header">
            <div>
                <span>Hệ thống</span>
                <h2>Import danh sách thiếu nhi</h2>
            </div>
            <button type="button" class="modal-close-import">×</button>
        </div>
        <form id="formImportExcel" enctype="multipart/form-data">
            <div class="modal-body">
                <div class="field-group" style="margin-bottom: 15px; width: 100%;">
                    <label for="import-year" style="display: block; margin-bottom: 5px; font-weight: 600;">Chọn niên khóa</label>
                    <select name="nien_khoa" id="import-year" required class="form-control" style="width: 100%;">
                        <option value="">Chọn niên khóa</option>
                        <% years.forEach(year => { %>
                            <option value="<%= year.id_cau_hinh_nam_hoc %>" <%= year.id_cau_hinh_nam_hoc === selectedYearId ? 'selected' : '' %>><%= year.nien_khoa %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="field-group" style="margin-bottom: 15px; width: 100%;">
                    <label for="import-lop" style="display: block; margin-bottom: 5px; font-weight: 600;">Chọn lớp</label>
                    <select name="id_lop" id="import-lop" required class="form-control" style="width: 100%;">
                        <option value="">Chọn lớp</option>
                        <% lopList.forEach(lop => { %>
                            <option value="<%= lop.id_lop %>"><%= lop.ten_khoi %> - <%= lop.ten_lop %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="field-group" style="margin-bottom: 15px; width: 100%;">
                    <label style="display: block; margin-bottom: 5px; font-weight: 600;">Chọn file Excel (.xlsx, .xls)</label>
                    <input type="file" name="file" id="fileExcel" accept=".xlsx, .xls" required class="form-control" style="width: 100%;">
                </div>
                <div style="font-size: 0.85rem; color: #666; line-height: 1.5;">
                    <p><strong>Cấu trúc mỗi dòng:</strong> 1 thiếu nhi, từ 1 đến 2 phụ huynh và từ 0 đến 3 bí tích.</p>
                    <p><strong>Cột bắt buộc:</strong> TÊN THÁNH, HỌ VÀ TÊN LÓT, TÊN, GIỚI TÍNH (Nam/Nữ), NGÀY SINH, TÊN PHỤ HUYNH 1, SĐT PHỤ HUYNH 1.</p>
                    <p>Niên khóa và lớp được lấy từ lựa chọn phía trên, không cần tạo cột <strong>ID_LOP</strong> trong Excel.</p>
                    <p><strong>Cột tùy chọn:</strong> TÊN THÁNH, HỌ VÀ TÊN LÓT, ĐỊA CHỈ. Cột <strong>TÊN PHỤ HUYNH 1</strong> có thể nhập gõ liền cả tên thánh (Ví dụ: <em>Gioan Nguyễn Văn B</em>); phụ huynh 2 dùng hậu tố 2.</p>
                    <p><strong>Bí tích:</strong> NGÀY RỬA TỘI, NGÀY XƯNG TỘI RƯỚC LỄ, NGÀY THÊM SỨC. Ngày dùng dạng <strong>dd/mm/yyyy</strong> hoặc ô ngày Excel.</p>
                </div>
            </div>
            <div class="modal-footer" style="display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" class="btn btn-secondary modal-close-import">Hủy</button>
                <button type="submit" class="btn btn-primary" id="btnSubmitImport">Tải lên</button>
            </div>
        </form>
    </div>
</div>

<script src="/js/bdh/bdh-thieu-nhi.js" defer></script>