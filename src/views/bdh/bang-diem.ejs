<link rel="stylesheet" href="/css/reset.css">
<link rel="stylesheet" href="/css/bdh/bdh-bang-diem.css">

<div class="bang-diem-page">
    <div class="bang-diem-header">
        <div>
            <p class="eyebrow">Tổng kết cuối năm</p>
            <h1><i class="fa-solid fa-file-lines"></i> Bảng điểm tổng kết</h1>
            <p class="page-description">Danh sách điểm chi tiết được sắp xếp theo khối, lớp và tên thiếu nhi.</p>
        </div>
        <form method="GET" action="/bdh/bang-diem" class="year-filter">
            <label for="nien-khoa">Niên khóa</label>
            <select id="nien-khoa" name="nien_khoa" onchange="this.form.submit()">
                <% if (academicYears.length === 0) { %>
                    <option>Chưa có niên khóa</option>
                <% } %>
                <% academicYears.forEach(year => { %>
                    <option value="<%= year.id_cau_hinh_nam_hoc %>" <%= String(year.id_cau_hinh_nam_hoc) === String(selectedYearId) ? 'selected' : '' %>>
                        <%= year.nien_khoa %>
                    </option>
                <% }) %>
            </select>
        </form>
    </div>

    <% if (!selectedYear) { %>
        <div class="empty-state">Chưa có niên khóa để hiển thị.</div>
    <% } else { %>
        <!-- NÚT TỔNG KẾT: Luôn hiển thị ở mọi niên khóa đã chọn để bạn có thể bấm -->
        <div class="summary-meta" style="background: #fff; padding: 16px; border: 1px solid var(--score-line); border-radius: 8px; margin-bottom: 20px;">
            <div>
                <span><i class="fa-solid fa-calendar-check"></i> Niên khóa <strong><%= selectedYear.nien_khoa %></strong></span>
                <span style="margin-left: 16px;"><i class="fa-solid fa-users"></i> <strong><%= studentCount %></strong> Thiếu nhi</span>
            </div>
            
            <div style="display: flex; gap: 10px; align-items: center;">
                <!-- Form gọi hàm tổng kết điểm -->
                <form action="/bdh/bang-diem/tong-ket" method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn tổng kết điểm cho toàn bộ niên khóa này không?');">
                    <input type="hidden" name="nien_khoa" value="<%= selectedYearId %>">
                    <button type="submit" class="export-score-button" style="background-color: var(--score-red); color: white; border: none; cursor: pointer;">
                        <i class="fa-solid fa-calculator"></i> Tổng kết điểm năm học
                    </button>
                </form>

                <!-- Nút in bảng điểm -->
                <% if (summary && summary.length > 0) { %>
                    <button class="export-score-button print-score-button" type="button" id="print-score-button">
                        <i class="fa-solid fa-print"></i> In bảng điểm A4
                    </button>
                <% } %>
            </div>
        </div>

        <% if (!summary || summary.length === 0) { %>
            <div class="empty-state">
                <i class="fa-solid fa-inbox"></i>
                <strong>Chưa có dữ liệu tổng kết</strong>
                <span>Niên khóa <%= selectedYear.nien_khoa %> chưa có dữ liệu điểm. Hãy bấm nút <strong>"Tổng kết điểm năm học"</strong> ở phía trên để hệ thống tiến hành tính toán.</span>
            </div>
        <% } else { %>
            <% let currentKhoi = null; let currentLop = null; let classStudentNumber = 0; %>
            <% summary.forEach((student, index) => { %>
                <% if (currentKhoi !== student.id_khoi) { %>
                    <% if (currentKhoi !== null) { %></tbody></table></div></section></section><% } %>
                    <% currentKhoi = student.id_khoi; currentLop = null; %>
                    <section class="khoi-section">
                        <div class="khoi-heading">
                            <span class="khoi-marker"><i class="fa-solid fa-layer-group"></i></span>
                            <h2><%= student.ten_khoi %></h2>
                        </div>
                <% } %>
                <% if (currentLop !== student.id_lop) { %>
                    <% if (currentLop !== null) { %></tbody></table></div></section><% } %>
                    <% currentLop = student.id_lop; classStudentNumber = 0; %>
                    <section class="lop-section">
                        <h3><i class="fa-solid fa-school"></i> Lớp <%= student.ten_lop %></h3>
                        <div class="table-scroll">
                            <table class="score-table">
                                <thead>
                                    <tr>
                                        <th>STT</th><th>MSTN</th><th>Họ và tên</th>
                                        <th>Học tập</th><th>Chuyên cần</th><th>Kỷ luật</th>
                                        <th>Điểm tổng</th><th>Xếp loại</th><th>Tình trạng</th>
                                    </tr>
                                </thead>
                                <tbody>
                <% } %>
                <% classStudentNumber += 1; %>
                                    <tr>
                                        <td data-label="STT"><%= classStudentNumber %></td>
                                        <td data-label="MSTN"><%= student.mstn || '-' %></td>
                                        <td data-label="Họ và tên" class="student-name"><%= [student.ten_thanh, student.ho_va_ten_lot, student.ten].filter(Boolean).join(' ') %></td>
                                        <td data-label="Học tập"><%= student.diem_hoc_tap ?? '-' %></td>
                                        <td data-label="Chuyên cần"><%= student.diem_chuyen_can ?? '-' %></td>
                                        <td data-label="Kỷ luật"><%= student.diem_ky_luat ?? '-' %></td>
                                        <td data-label="Điểm tổng" class="total-score"><%= student.diem_tong ?? '-' %></td>
                                        <td data-label="Xếp loại"><span class="classification"><%= student.ten_xep_loai || '-' %></span></td>
                                        <td data-label="Tình trạng"><span class="status status-<%= student.tinh_trang === 'Lên lớp' ? 'pass' : 'other' %>"><%= student.tinh_trang || '-' %></span></td>
                                    </tr>
                <% if (index === summary.length - 1) { %></tbody></table></div></section></section><% } %>
            <% }) %>
        <% } %>
    <% } %>

    <% if (selectedYear && summary && summary.length > 0) { %>
        <% const printGroups = []; %>
        <% summary.forEach(student => { %>
            <% let group = printGroups.find(item => item.idLop === student.id_lop); %>
            <% if (!group) { %>
                <% group = { idLop: student.id_lop, tenLop: student.ten_lop, tenKhoi: student.ten_khoi, students: [] }; %>
                <% printGroups.push(group); %>
            <% } %>
            <% group.students.push(student); %>
        <% }) %>

        <div class="score-print-document">
            <img class="score-print-watermark" src="/imgs/Logo.png" alt="" aria-hidden="true">
            <% printGroups.forEach(group => { %>
                <section class="score-print-class">
                    <p class="score-print-parish">GIÁO XỨ TÂN THÁI SƠN<br>Xứ đoàn Don Bosco<br>Niên khóa: <%= selectedYear.nien_khoa %></p>
                    <h1>BẢNG ĐIỂM TỔNG KẾT NĂM HỌC</h1>
                    <h2>Khối: <%= group.tenKhoi %> - Lớp: <%= group.tenLop %></h2>
                    <table class="score-print-table">
                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>MSTN</th>
                                <th>Tên thánh</th>
                                <th>Họ và tên lót</th>
                                <th>Tên</th>
                                <th>Học tập</th>
                                <th>Chuyên cần</th>
                                <th>Kỷ luật</th>
                                <th>Tổng</th>
                                <th>Xếp loại</th>
                                <th>Tình trạng</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% group.students.forEach((student, index) => { %>
                                <tr>
                                    <td><%= index + 1 %></td>
                                    <td><%= student.mstn || '' %></td>
                                    <td><%= student.ten_thanh || '' %></td>
                                    <td><%= student.ho_va_ten_lot || '' %></td>
                                    <td><%= student.ten || '' %></td>
                                    <td><%= student.diem_hoc_tap ?? '' %></td>
                                    <td><%= student.diem_chuyen_can ?? '' %></td>
                                    <td><%= student.diem_ky_luat ?? '' %></td>
                                    <td><%= student.diem_tong ?? '' %></td>
                                    <td><%= student.ten_xep_loai || '' %></td>
                                    <td><%= student.trang_thai_tn === 'Đang học' ? (student.tinh_trang || '') : (student.trang_thai_tn || '') %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                    <p class="score-print-count">Tổng số: <%= group.students.length %> thiếu nhi</p>
                </section>
            <% }) %>
        </div>
    <% } %>
</div>

<script src="/js/bdh/bdh-bang-diem.js" defer></script>