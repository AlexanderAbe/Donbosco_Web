<link rel="stylesheet" href="/css/reset.css">
<link rel="stylesheet" href="/css/bdh/bdh-chuyen-giao.css">

<div class="transfer-page">
	<div class="transfer-header">
		<p class="eyebrow">Tổng kết và chuyển lớp</p>
		<h1><i class="fa-solid fa-arrow-right-arrow-left"></i> Chuyển giao niên khóa</h1>
		<p>Khóa niên khóa, in bằng khen và chuyển thiếu nhi lên lớp hoặc ở lại lớp sang niên khóa mới.</p>
	</div>

	<section class="transfer-card">
		<div class="card-heading"><span class="step-number">1</span><div><h2>Niên khóa đã tổng kết</h2><p>Chọn năm học để chuyển dữ liệu sang năm sau.</p></div></div>
		<form method="GET" action="/bdh/chuyen-giao" class="year-form">
			<select name="nien_khoa_cu" onchange="this.form.submit()" required>
				<% academicYears.forEach(year => { %>
					<option value="<%= year.id_cau_hinh_nam_hoc %>" <%= year.id_cau_hinh_nam_hoc === selectedOldId ? 'selected' : '' %>><%= year.nien_khoa %><%= year.is_locked ? ' - Đã khóa' : '' %></option>
				<% }) %>
			</select>
			<% if (oldYear) { %><small class="year-config-hint">Khối kết thúc: <strong><%= oldYear.stt_khoi_ket_thuc || 11 %></strong></small><% } %>
		</form>

		<% if (!oldYear) { %>
			<div class="notice notice-warning">Chưa chọn được niên khóa.</div>
		<% } else if (!hasSummary) { %>
			<div class="notice notice-warning"><i class="fa-solid fa-triangle-exclamation"></i> Niên khóa này chưa có dữ liệu tổng kết. Hãy tổng kết điểm trước.</div>
		<% } else { %>
			<div class="action-grid">
				<% if (oldYear.is_locked) { %>
					<div class="notice notice-success"><i class="fa-solid fa-lock"></i> Niên khóa <strong><%= oldYear.nien_khoa %></strong> đã được khóa.</div>
				<% } else { %>
					<form method="POST" action="/bdh/chuyen-giao/lock" id="lock-form" data-year-name="<%= oldYear.nien_khoa %>">
						<input type="hidden" name="nien_khoa_cu" value="<%= selectedOldId %>">
						<button class="action-button danger" type="submit"><i class="fa-solid fa-lock"></i> Khóa niên khóa</button>
					</form>
				<% } %>
				<a class="action-button secondary" href="/bdh/chuyen-giao/export-awards?nien_khoa_cu=<%= selectedOldId %>" target="_blank"><i class="fa-solid fa-award"></i> In bằng khen</a>
			</div>
		<% } %>
	</section>

	<section class="transfer-card">
			<div class="card-heading"><span class="step-number">2</span><div><h2>Chuyển thiếu nhi sang niên khóa mới</h2><p>Thiếu nhi lên lớp sẽ lên khối kế tiếp; thiếu nhi ở lại lớp sẽ học lại khối.</p></div></div>
		<form method="POST" action="/bdh/chuyen-giao/transfer" class="transfer-form" id="transfer-form" data-can-transfer="<%= hasSummary && Boolean(oldYear?.is_locked) %>" data-old-year="<%= oldYear?.nien_khoa || '' %>">
			<input type="hidden" name="nien_khoa_cu" value="<%= selectedOldId || '' %>">
			<label for="nien-khoa-moi">Niên khóa mới</label>
			<select id="nien-khoa-moi" name="nien_khoa_moi" required>
				<option value="">-- Chọn niên khóa mới --</option>
				<% academicYears.forEach(year => { %>
					<% if (year.id_cau_hinh_nam_hoc !== selectedOldId && !year.is_locked) { %><option value="<%= year.id_cau_hinh_nam_hoc %>" <%= year.id_cau_hinh_nam_hoc === selectedNewId ? 'selected' : '' %>><%= year.nien_khoa %></option><% } %>
				<% }) %>
			</select>
			<button class="action-button primary" id="transfer-button" type="submit" <%= !hasSummary || !oldYear?.is_locked || !selectedNewId ? 'disabled' : '' %>><i class="fa-solid fa-arrow-right"></i> Chuyển giao thiếu nhi</button>
			<% if (hasSummary && !oldYear?.is_locked) { %><small class="transfer-hint">Hãy khóa niên khóa cũ trước khi chuyển giao.</small><% } %>
		</form>
	</section>
</div>

<dialog class="confirmation-modal" id="confirmation-modal">
	<div class="modal-content">
		<button class="modal-close" type="button" id="modal-close" aria-label="Đóng">&times;</button>
		<div class="modal-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
		<h2 id="modal-title">Xác nhận thao tác</h2>
		<p id="modal-message"></p>
		<div class="modal-actions">
			<button class="action-button secondary" type="button" id="modal-cancel">Hủy</button>
			<button class="action-button danger" type="button" id="modal-confirm">Xác nhận</button>
		</div>
	</div>
</dialog>

<script src="/js/bdh/bdh-chuyen-giao.js" defer></script>
