<link rel="stylesheet" href="/css/reset.css">
<link rel="stylesheet" href="/css/bdh/bdh-phan-cong.css">

<div class="phan-cong-page">
	<div class="page-toolbar">
		<div class="page-heading">
			<h1>Phân công nhân sự</h1>
			<p>Phân giáo lý viên vào lớp và chỉ định Trưởng khối theo niên khóa.</p>
		</div>
		<form method="GET" action="/bdh/phan-cong" class="field-group">
			<label for="year-filter">Niên khóa</label>
			<select id="year-filter" name="nien_khoa" onchange="this.form.submit()" <%= years.length ? '' : 'disabled' %>>
				<% if (years.length) { %>
					<% years.forEach(year => { %>
						<option value="<%= year.id_cau_hinh_nam_hoc %>" <%= year.id_cau_hinh_nam_hoc === selectedYearId ? 'selected' : '' %>>
							<%= year.nien_khoa %>
						</option>
					<% }) %>
				<% } else { %>
					<option>Chưa có niên khóa</option>
				<% } %>
			</select>
		</form>
	</div>

	<% if (error) { %><div class="alert"><%= error %></div><% } %>
	<% if (message) { %><div class="alert success"><%= message %></div><% } %>

	<section class="section-card">
		<div class="section-header">
			<h2>Phân công GLV vào lớp</h2>
			<span><%= classes.length %> lớp</span>
		</div>
		<% if (selectedYearId && classes.length && glvList.length) { %>
			<form method="POST" action="/bdh/phan-cong/glv/bulk" class="bulk-assignment-form">
				<div class="field-group">
					<label for="bulk-class">Chọn lớp</label>
					<select id="bulk-class" name="id_lop" required>
						<option value="">Chọn lớp cần phân công</option>
						<% classes.forEach(lop => { %>
							<option value="<%= lop.id_lop %>"><%= lop.ten_khoi || 'Chưa phân khối' %> - <%= lop.ten_lop %></option>
						<% }) %>
					</select>
				</div>
				<input type="hidden" name="id_cau_hinh_nam_hoc" value="<%= selectedYearId %>">
				<div class="bulk-glv-list">
					<div class="bulk-label-wrapper" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
						<span class="bulk-label">Chọn GLV (Chưa phân công)</span>
						<span style="font-size: 11px; color: #64748b;">(Có thể chọn nhiều)</span>
					</div>
					
					<!-- Ô tìm kiếm nhanh GLV -->
					<div style="margin-bottom: 8px; position: relative;">
						<span style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #94a3b8; pointer-events: none;">
							<i class="fa-solid fa-magnifying-glass"></i>
						</span>
						<input type="text" id="search-glv-input" placeholder="Gõ tên GLV để tìm nhanh..." style="width: 100%; padding: 8px 10px 8px 36px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px; box-sizing: border-box;">
					</div>

					<!-- Khung chứa danh sách GLV chưa phân công -->
					<div class="checkbox-grid" id="glv-checkbox-grid">
						<% if (typeof availableGlvList !== 'undefined' && availableGlvList.length > 0) { %>
							<% availableGlvList.forEach(glv => { %>
								<label class="checkbox-item" data-name="<%= (glv.ho_ten || `GLV #${glv.id_glv}`).toLowerCase() %>">
									<input type="checkbox" name="id_glv" value="<%= glv.id_glv %>">
									<span><%= glv.ho_ten || `GLV #${glv.id_glv}` %></span>
								</label>
							<% }) %>
						<% } else { %>
							<div style="grid-column: 1 / -1; text-align: center; color: #64748b; font-size: 13px; padding: 12px;">
								Tất cả GLV đều đã được phân công trong niên khóa này.
							</div>
						<% } %>
					</div>
				</div>
				<button type="submit" class="btn btn-primary">Phân công đã chọn</button>
			</form>
		<% } %>
		<% if (!selectedYearId || !classes.length) { %>
			<div class="empty-state">Niên khóa này chưa có lớp để phân công.</div>
		<% } else { %>
			<div class="table-wrap">
				<table>
					<thead>
						<tr>
							<th>Lớp</th>
							<th>Khối</th>
							<th>GLV đang phụ trách</th>
						</tr>
					</thead>
					<tbody>
						<% classes.forEach(lop => { %>
							<% const assignedGlv = classAssignments.filter(item => item.id_lop === lop.id_lop); %>
							<tr>
								<td><strong><%= lop.ten_lop %></strong></td>
								<td><%= lop.ten_khoi || 'Chưa phân khối' %></td>
								<td>
									<% if (assignedGlv.length) { %>
										<div class="assignment-list">
											<% assignedGlv.forEach(item => { %>
												<span class="assignment-item">
													<%= item.ho_ten || `GLV #${item.id_glv}` %>
													<form method="POST" action="/bdh/phan-cong/glv/remove">
														<input type="hidden" name="id_phan_cong_glv" value="<%= item.id_phan_cong_glv %>">
														<input type="hidden" name="id_cau_hinh_nam_hoc" value="<%= selectedYearId %>">
														<button type="submit" class="btn btn-remove" title="Gỡ phân công">×</button>
													</form>
												</span>
											<% }) %>
										</div>
									<% } else { %>
										<span>Chưa phân công</span>
									<% } %>
								</td>
							</tr>
						<% }) %>
					</tbody>
				</table>
			</div>
		<% } %>
	</section>

	<section class="section-card">
        <div class="section-header">
            <h2>Phân công Trưởng khối</h2>
            <span>Tối đa 3 Trưởng khối mỗi khối</span>
        </div>
        <% if (!selectedYearId || !truongKhoiList.length) { %>
            <div class="empty-state">Niên khóa này chưa có khối để phân công.</div>
        <% } else { %>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th style="width: 20%;">Khối</th>
                            <th style="width: 45%;">Trưởng khối hiện tại</th>
                            <th style="width: 35%;">Thêm Trưởng khối</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% 
                            // Gom nhóm danh sách trưởng khối theo từng id_khoi vì 1 khối có thể xuất hiện nhiều dòng
                            const groupedTruongKhoi = {};
                            truongKhoiList.forEach(item => {
                                if (!groupedTruongKhoi[item.id_khoi]) {
                                    groupedTruongKhoi[item.id_khoi] = {
                                        id_khoi: item.id_khoi,
                                        stt: item.stt,
                                        ten_khoi: item.ten_khoi,
                                        leaders: []
                                    };
                                }
                                if (item.id_phan_cong_truong) {
                                    groupedTruongKhoi[item.id_khoi].leaders.push({
                                        id_phan_cong_truong: item.id_phan_cong_truong,
                                        id_glv: item.id_glv,
                                        ho_ten: item.ho_ten
                                    });
                                }
                            });
                        %>

                        <% Object.values(groupedTruongKhoi).forEach(khoi => { %>
                            <tr>
                                <td><strong><%= khoi.ten_khoi %></strong></td>
                                <td>
                                    <% if (khoi.leaders.length > 0) { %>
                                        <div class="assignment-list" style="display: flex; flex-direction: column; gap: 6px;">
                                            <% khoi.leaders.forEach(leader => { %>
                                                <div class="assignment-item" style="display: flex; justify-content: space-between; align-items: center; background: #f8fafc; padding: 4px 8px; border-radius: 4px; border: 1px solid #e2e8f0;">
                                                    <span><%= leader.ho_ten || `GLV #${leader.id_glv}` %></span>
                                                    <form method="POST" action="/bdh/phan-cong/truorg-khoi/remove" style="margin: 0;">
                                                        <input type="hidden" name="id_phan_cong_truong" value="<%= leader.id_phan_cong_truong %>">
                                                        <input type="hidden" name="id_cau_hinh_nam_hoc" value="<%= selectedYearId %>">
                                                        <button type="submit" class="btn btn-remove" title="Gỡ trưởng khối" style="border: none; background: transparent; color: #ef4444; cursor: pointer; font-weight: bold;">×</button>
                                                    </form>
                                                </div>
                                            <% }) %>
                                        </div>
                                    <% } else { %>
                                        <span style="color: #94a3b8; font-style: italic;">Chưa có trưởng khối</span>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (khoi.leaders.length < 3) { %>
                                        <form method="POST" action="/bdh/phan-cong/truong-khoi" class="inline-form" style="display: flex; gap: 8px; align-items: center;">
                                            <input type="hidden" name="id_khoi" value="<%= khoi.id_khoi %>">
                                            <input type="hidden" name="id_cau_hinh_nam_hoc" value="<%= selectedYearId %>">
                                            <select name="id_glv" required style="flex: 1; padding: 6px; border: 1px solid #cbd5e1; border-radius: 4px; font-size: 13px;">
                                                <option value="">Chọn GLV làm trưởng khối</option>
                                                <% glvList.forEach(glv => { %>
                                                    <option value="<%= glv.id_glv %>">
                                                        <%= glv.ho_ten || `GLV #${glv.id_glv}` %>
                                                    </option>
                                                <% }) %>
                                            </select>
                                            <button type="submit" class="btn btn-primary" style="padding: 6px 12px; font-size: 13px;">Thêm</button>
                                        </form>
                                    <% } else { %>
                                        <span style="color: #2563eb; font-size: 12px; font-weight: 500;">Đã đủ tối đa 3 Trưởng khối</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </section>
</div>

<!-- Script lọc tên GLV ngay lập tức khi gõ -->
<script>
    const searchInput = document.getElementById('search-glv-input');
    if (searchInput) {
        searchInput.addEventListener('input', function(e) {
            const keyword = e.target.value.toLowerCase().trim();
            const items = document.querySelectorAll('#glv-checkbox-grid .checkbox-item');
            
            items.forEach(item => {
                const name = item.getAttribute('data-name');
                if (name && name.includes(keyword)) {
                    item.style.display = 'flex';
                } else {
                    item.style.display = 'none';
                }
            });
        });
    }
</script>