<%
   const currentIsGlv = typeof isGlv !== 'undefined' ? isGlv : false;
   const activeRole = String(session.user.active_role || '').toLowerCase();
   const availableRoleCount = [
       session.user.id_glv,
       session.user.is_truong_khoi,
       session.user.is_bdh,
       session.user.is_admin,
       session.user.is_ca_doan_manager
   ].filter(Boolean).length;
   const showSwitcher = availableRoleCount > 1;
%>

<% if (showSwitcher) { %>
    <div class="header-right">
        
        <!-- 1. GIAO DIỆN MÁY TÍNH (Các nút ngang truyền thống) -->
        <div class="desktop-switch-buttons" data-active-role="<%= activeRole %>" role="group" aria-label="Chuyển đổi vai trò">
            <% if (session.user.id_glv) { %>
            <a href="/auth/switch-role/glv" class="switch-btn <%= activeRole === 'glv' ? 'is-current' : '' %>"
                title="<%= activeRole === 'glv' ? 'Đang ở giao diện GLV' : 'Về giao diện GLV' %>"
                <% if (activeRole === 'glv') { %>aria-current="page"<% } %>>
                <i class="fa-solid fa-house"></i> GLV
            </a>
            <% } %>
            <% if (session.user.is_truong_khoi) { %>
                <a href="/auth/switch-role/truong-khoi" class="switch-btn <%= activeRole === 'truong-khoi' ? 'is-current' : '' %>"
                    title="Chuyển sang Trưởng Khối" <% if (activeRole === 'truong-khoi') { %>aria-current="page"<% } %>>
                    <i class="fa-solid fa-user-tie"></i> Trưởng/Phó Khối
                </a>
            <% } %>
            <% if (session.user.is_bdh) { %>
                <a href="/auth/switch-role/bdh" class="switch-btn <%= activeRole === 'bdh' ? 'is-current' : '' %>"
                    title="Chuyển sang Ban Điều Hành" <% if (activeRole === 'bdh') { %>aria-current="page"<% } %>>
                    <i class="fa-solid fa-users-gear"></i> BDH
                </a>
            <% } %>
            <% if (session.user.is_admin) { %>
                <a href="/auth/switch-role/admin" class="switch-btn <%= activeRole === 'admin' ? 'is-current' : '' %>"
                    title="Chuyển sang Quản trị" <% if (activeRole === 'admin') { %>aria-current="page"<% } %>>
                    <i class="fa-solid fa-shield-halved"></i> Admin
                </a>
            <% } %>
            <% if (session.user.is_ca_doan_manager) { %>
                <a href="/auth/switch-role/ca-doan" class="switch-btn <%= activeRole === 'ca-doan' ? 'is-current' : '' %>"
                    title="Chuyển sang Điểm danh ca đoàn" <% if (activeRole === 'ca-doan') { %>aria-current="page"<% } %>>
                    <i class="fa-solid fa-music"></i> Ca đoàn
                </a>
            <% } %>
        </div>

        <!-- 2. GIAO DIỆN ĐIỆN THOẠI / TABLET (Nút tròn icon xổ xuống) -->
        <div class="mobile-switch-container">
            <button type="button" class="mobile-switch-icon-btn" id="mobileSwitchBtn" title="Chuyển đổi vai trò">
                <i class="fa-solid fa-rotate"></i>
            </button>
            <div class="mobile-switch-dropdown-menu" id="mobileSwitchDropdown">
                <% if (!currentIsGlv && session.user.id_glv) { %>
                    <a href="/auth/switch-role/glv" class="mobile-switch-item">
                        <i class="fa-solid fa-house"></i> Về giao diện GLV
                    </a>
                <% } %>
                <% if (session.user.is_truong_khoi) { %>
                    <a href="/auth/switch-role/truong-khoi" class="mobile-switch-item">
                        <i class="fa-solid fa-user-tie"></i> Chuyển sang Trưởng/Phó Khối
                    </a>
                <% } %>
                <% if (session.user.is_bdh) { %>
                    <a href="/auth/switch-role/bdh" class="mobile-switch-item">
                        <i class="fa-solid fa-users-gear"></i> Chuyển sang BDH
                    </a>
                <% } %>
                <% if (session.user.is_admin) { %>
                    <a href="/auth/switch-role/admin" class="mobile-switch-item">
                        <i class="fa-solid fa-shield-halved"></i> Chuyển sang Admin
                    </a>
                <% } %>
                <% if (session.user.is_ca_doan_manager) { %>
                    <a href="/auth/switch-role/ca-doan" class="mobile-switch-item">
                        <i class="fa-solid fa-music"></i> Điểm danh ca đoàn
                    </a>
                <% } %>
            </div>
        </div>

    </div>

    <!-- Script nhỏ để xử lý bấm mở/đóng menu trên mobile -->
    <script src="/js/partials/role-switcher.js" defer></script>
<% } %>