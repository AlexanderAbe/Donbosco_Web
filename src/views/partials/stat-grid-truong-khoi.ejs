<% const values = stats || { total_thieu_nhi: 0, total_nam: 0, total_nu: 0, total_glv: 0 }; %>
<div class="tk-stats-grid">
    <div class="tk-stat-card children-stat">
        <div class="tk-stat-icon"><i class="fa-solid fa-children"></i></div>
        <div><span>Thiếu nhi trong khối</span><strong><%= values.total_thieu_nhi %></strong></div>
    </div>
    <div class="tk-stat-card boys-stat">
        <div class="tk-stat-icon"><i class="fa-solid fa-child"></i></div>
        <div><span>Thiếu nhi nam</span><strong><%= values.total_nam %></strong></div>
    </div>
    <div class="tk-stat-card girls-stat">
        <div class="tk-stat-icon"><i class="fa-solid fa-child-dress"></i></div>
        <div><span>Thiếu nhi nữ</span><strong><%= values.total_nu %></strong></div>
    </div>
    <div class="tk-stat-card glv-stat">
        <div class="tk-stat-icon"><i class="fa-solid fa-chalkboard-user"></i></div>
        <div><span>GLV trong khối</span><strong><%= values.total_glv %></strong></div>
    </div>
</div>
