<%
    const dateParts = String(selectedDate || '').split('-');
    const displayDate = dateParts.length === 3
        ? `${dateParts[2]}/${dateParts[1]}/${dateParts[0]}`
        : selectedDate;
    const sessionDateLabel = `${sessionType || 'Điểm danh'} • ${displayDate}`;
%>
<section class="choir-attendance" data-year-id="<%= selectedYearId || '' %>" data-date="<%= selectedDate %>" data-session="<%= sessionType %>">
    <% if (message) { %>
        <div class="choir-feedback" role="status"><%= message %></div>
    <% } %>

    <header class="attendance-topbar">
        <form class="attendance-date-form" id="attendance-filters" action="/ca-doan/diem-danh" method="GET">
            <% if (selectedYearId) { %>
                <input type="hidden" name="nien_khoa" value="<%= selectedYearId %>">
            <% } %>
            <label for="attendance-date">Ngày điểm danh</label>
            <strong class="attendance-date-display"><%= sessionDateLabel %></strong>
            <input id="attendance-date" type="date" name="ngay_diem_danh" value="<%= selectedDate %>" max="<%= todayKey %>" required>
        </form>
        <div class="attendance-member-count" aria-label="<%= students.length %> ca viên">
            <i class="fa-solid fa-music" aria-hidden="true"></i>
            <span><strong><%= students.length %></strong> ca viên</span>
        </div>
    </header>

    <% if (futureDate) { %>
        <div class="choir-empty"><i class="fa-solid fa-calendar-xmark"></i><span>Không thể điểm danh cho ngày chưa tới.</span></div>
    <% } else if (!sessionType) { %>
        <div class="choir-empty"><i class="fa-solid fa-calendar-xmark"></i><span>Chỉ có thể điểm danh lễ Thứ 3, lễ Thứ 5 hoặc lễ Chúa Nhật.</span></div>
    <% } else if (!selectedYearId) { %>
        <div class="choir-empty"><i class="fa-solid fa-calendar-xmark"></i><span>Chưa có niên khóa để tải danh sách ca viên.</span></div>
    <% } else { %>
        <section class="attendance-scanner" aria-label="Quét mã ca đoàn">
            <div class="attendance-scanner-heading">
                <h2><i class="fa-solid fa-qrcode" aria-hidden="true"></i> Quét mã ca đoàn</h2>
                <button class="attendance-scanner-toggle" id="scanner-toggle" type="button" aria-controls="scanner-panel" aria-expanded="true">
                    <i class="fa-solid fa-chevron-up" aria-hidden="true"></i>
                    <span>Thu gọn</span>
                </button>
            </div>
            <div id="scanner-panel" class="attendance-scanner-panel">
                <div class="attendance-camera-frame">
                    <div id="choir-qr-reader"></div>
                    <button class="attendance-flash-button" id="scanner-flash" type="button" aria-pressed="false" aria-label="Bật đèn flash" disabled>
                        <i class="fa-solid fa-bolt" aria-hidden="true"></i>
                        <span>Flash</span>
                    </button>
                </div>
                <div class="choir-scan-status" id="scan-status" role="status" aria-live="polite"></div>
            </div>
        </section>

        <section class="choir-roster attendance-roster" aria-labelledby="attendance-list-title">
            <div class="attendance-roster-title">
                <div>
                    <h2 id="attendance-list-title"><%= sessionDateLabel %></h2>
                    <p>Danh sách ca viên trong niên khóa</p>
                </div>
            </div>

            <% if (students.length) { %>
                <div class="attendance-sticky-tools">
                    <label class="attendance-search" for="attendance-search">
                        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                        <input id="attendance-search" type="search" placeholder="Tìm tên hoặc mã số..." autocomplete="off">
                    </label>
                    <nav class="attendance-status-filters" aria-label="Lọc danh sách theo trạng thái">
                        <button type="button" class="attendance-filter is-active" data-attendance-filter="all" aria-pressed="true">
                            Tất cả <span data-filter-count="all"><%= students.length %></span>
                        </button>
                        <button type="button" class="attendance-filter" data-attendance-filter="pending" aria-pressed="false">
                            Chưa ĐD <span data-filter-count="pending">0</span>
                        </button>
                        <button type="button" class="attendance-filter" data-attendance-filter="present" aria-pressed="false">
                            Có mặt <span data-filter-count="present">0</span>
                        </button>
                        <button type="button" class="attendance-filter" data-attendance-filter="permission" aria-pressed="false">
                            Phép <span data-filter-count="permission">0</span>
                        </button>
                        <button type="button" class="attendance-filter" data-attendance-filter="absent" aria-pressed="false">
                            Vắng <span data-filter-count="absent">0</span>
                        </button>
                    </nav>
                </div>

                <p class="attendance-result-count" aria-live="polite">
                    Đang hiển thị <strong id="attendance-visible-count"><%= students.length %></strong>/<%= students.length %> ca viên
                </p>

                <div class="attendance-list" id="attendance-list">
                    <% students.forEach((student, index) => {
                        const savedStatus = student.trang_thai_diem_danh || '';
                        const rowState = savedStatus === 'Vắng phép'
                            ? 'permission'
                            : savedStatus === 'Vắng không phép'
                                ? 'absent'
                                : savedStatus
                                    ? 'present'
                                    : 'pending';
                        const statusLabel = savedStatus || 'Chưa điểm danh';
                    %>
                        <article class="attendance-row"
                            data-attendance-row
                            data-student-id="<%= student.id_tn %>"
                            data-class-id="<%= student.id_lop %>"
                            data-search="<%= `${student.mstn || ''} ${student.ho_ten || ''}`.toLowerCase() %>"
                            data-status="<%= rowState %>"
                            data-server-status="<%= rowState %>"
                            data-status-copy="<%= statusLabel %>"
                            data-persisted="<%= student.da_diem_danh ? 'true' : 'false' %>">
                            <div class="attendance-student">
                                <div class="attendance-student-meta">
                                    <span class="attendance-index"><%= index + 1 %></span>
                                    <span>Mã: <strong><%= student.mstn || '-' %></strong></span>
                                </div>
                                <strong class="attendance-student-name"><%= student.ho_ten %></strong>
                                <span class="attendance-student-status" data-status-copy><%= statusLabel %></span>
                            </div>
                            <div class="attendance-actions" role="group" aria-label="Điểm danh <%= student.ho_ten %>">
                                <label class="attendance-check" title="Đánh dấu có mặt">
                                    <input type="checkbox" data-attendance-present
                                        aria-label="Đánh dấu <%= student.ho_ten %> có mặt"
                                        <%= rowState === 'present' ? 'checked' : '' %>>
                                    <i class="fa-solid fa-check" aria-hidden="true"></i>
                                </label>
                            </div>
                        </article>
                    <% }); %>
                </div>
                <div class="attendance-no-results" id="attendance-search-empty" hidden>Không tìm thấy ca viên phù hợp.</div>
                <%- include('../partials/pagination', {
                    mode: 'client',
                    currentPage: 1,
                    totalPages: Math.max(Math.ceil(students.length / 25), 1),
                    totalItems: students.length,
                    pageSize: 25,
                    rows: '[data-attendance-row]'
                }) %>
            <% } else { %>
                <div class="attendance-no-students"><i class="fa-solid fa-user-group" aria-hidden="true"></i>Chưa có ca viên được phân lớp trong niên khóa này.</div>
            <% } %>
        </section>
    <% } %>

    <div class="choir-toast" id="choir-toast" role="status" aria-live="polite"></div>
</section>

<% if (!futureDate && sessionType && selectedYearId) { %>
    <script src="/vendor/html5-qrcode/html5-qrcode.min.js"></script>
<% } %>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/ca-doan/attendance.js" defer></script>
