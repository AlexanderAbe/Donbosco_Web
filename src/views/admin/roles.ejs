<link rel="stylesheet" href="/css/reset.css">
<link rel="stylesheet" href="/css/admin/admin-role.css">

<div class="dashboard-container">
    <div class="page-header">
        <h1>Quản lý Phân quyền Hệ thống</h1>
        <p>Phân chia quyền Quản trị viên và Ban Điều Hành cho các Giáo lý viên</p>
    </div>

    <%- include('../partials/toast') %>

    <!-- Ô TÌM KIẾM -->
    <div class="search-section">
        <form action="/admin/roles" method="GET" class="search-form">
            <div class="search-input-wrapper">
                <input type="text" 
                       name="search" 
                       value="<%= searchQuery || '' %>" 
                       placeholder="Tìm theo tên hoặc username...">
                <i class="fa-solid fa-magnifying-glass"></i>
            </div>
            <button type="submit" class="btn-search">Tìm</button>
            <% if (searchQuery && searchQuery.trim() !== '') { %>
                <a href="/admin/roles" class="btn-reset" title="Xóa tìm kiếm">
                    <i class="fa-solid fa-rotate-left"></i>
                </a>
            <% } %>
        </form>
    </div>

    <div class="section-card">
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>ID GLV</th>
                        <th>Họ và tên</th>
                        <th>Tình trạng</th>
                        <th>Tên đăng nhập / SĐT</th>
                        <th class="text-center">Quản trị viên (Admin)</th>
                        <th class="text-center">Ban Điều Hành (BDH)</th>
                        <th class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (users && users.length > 0) { %>
                        <% users.forEach(user => { %>
                            <form action="/admin/roles/update/<%= user.id_glv %>" method="POST">
                                <tr>
                                    <td data-label="ID GLV">#<%= user.id_glv %></td>
                                    <td data-label="Họ và tên"><b><%= user.ho_ten || (user.ho_va_ten_lot + ' ' + user.ten) %></b></td>
                                    <td data-label="Tình trạng"><%= user.trang_thai || 'Đang hoạt động' %></td>
                                    <td data-label="Tên đăng nhập / SĐT"><%= user.username || 'Chưa có tài khoản' %></td>
                                    
                                    <!-- Checkbox Quản trị viên -->
                                    <td data-label="Quản trị viên (Admin)" class="text-center">
                                        <input type="checkbox" name="is_admin" value="true" <%= user.is_admin ? 'checked' : '' %> <%= user.id_tk ? '' : 'disabled' %> class="role-checkbox">
                                        <% if (!user.id_tk) { %><small class="text-muted">Chưa có tài khoản</small><% } %>
                                    </td>

                                    <!-- Checkbox Ban Điều Hành -->
                                    <td data-label="Ban Điều Hành (BDH)" class="text-center">
                                        <input type="checkbox" name="is_bdh" value="true" <%= user.is_bdh ? 'checked' : '' %> <%= user.id_tk ? '' : 'disabled' %> class="role-checkbox">
                                        <% if (!user.id_tk) { %><small class="text-muted">Chưa có tài khoản</small><% } %>
                                    </td>

                                    <!-- Nút Lưu -->
                                    <td data-label="Hành động" class="text-center">
                                        <button type="submit" class="btn-save">
                                            <i class="fa-solid fa-floppy-disk"></i> Lưu
                                        </button>
                                    </td>
                                </tr>
                            </form>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">Không tìm thấy giáo lý viên nào phù hợp.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>