<link rel="stylesheet" href="/css/reset.css">
<link rel="stylesheet" href="/css/admin/admin-users.css">

<div class="dashboard-container">
    <!-- Tiêu đề trang -->
    <div class="page-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; margin-bottom: 24px;">
        <div>
            <h1>Quản lý người dùng</h1>
            <p>Quản lý tài khoản Giáo lý viên, phân quyền và trạng thái truy cập hệ thống</p>
        </div>
    </div>
    <% if (caDoanAccountMessage) { %>
        <div class="section-card" role="status" style="margin-bottom: 20px; padding: 14px; color: #166534; background: #f0fdf4;">
            <%= caDoanAccountMessage %>
        </div>
    <% } %>
    <section class="section-card" style="margin-bottom: 32px; padding: 20px;">
        <h2 style="margin-bottom: 12px;">Tạo tài khoản quản lý ca đoàn</h2>
        <p style="margin-bottom: 16px;">Tài khoản này không cần liên kết với hồ sơ giáo lý viên.</p>
        <form action="/admin/users/create-ca-doan-manager" method="POST" style="display: flex; flex-wrap: wrap; align-items: end; gap: 12px;">
            <label style="display: grid; gap: 6px;">
                Tên đăng nhập
                <input name="username" type="text" minlength="3" maxlength="50" autocomplete="username" required>
            </label>
            <label style="display: grid; gap: 6px;">
                Mật khẩu ban đầu
                <input name="password" type="password" minlength="8" maxlength="72" autocomplete="new-password" required>
            </label>
            <button type="submit" class="action-btn">Tạo tài khoản</button>
        </form>
    </section>
    <!-- 1. BẢNG TÀI KHOẢN ĐANG HOẠT ĐỘNG -->
    <%- include('../partials/user-table-section', {
        users: activeUsers,
        type: 'active',
        title: 'Tài khoản đang hoạt động',
        titleColor: '#166534',
        iconClass: 'fa-solid fa-user-check',
        cardStyle: 'margin-bottom: 32px;',
        showSearch: true,
        emptyMessage: 'Không có tài khoản nào đang hoạt động.'
    }) %>

    <!-- 2. BẢNG TÀI KHOẢN ĐÃ BỊ KHÓA -->
    <%- include('../partials/user-table-section', {
        users: lockedUsers,
        type: 'locked',
        title: 'Tài khoản đã bị khóa',
        titleColor: '#991b1b',
        iconClass: 'fa-solid fa-user-lock',
        cardStyle: '',
        showSearch: false,
        emptyMessage: 'Không có tài khoản nào đang bị khóa. Tuyệt vời!'
    }) %>
</div>