<link rel="stylesheet" href="/css/reset.css">
<link rel="stylesheet" href="/css/truong-khoi/truong-khoi-phan-cong-glv.css">

<main class="tk-class-page">
    <header class="tk-class-header">
        <div><p class="eyebrow"><i class="fa-solid fa-people-group"></i> Phân công GLV</p></div>
    </header>
    <% if (error) { %><div class="tk-alert"><i class="fa-solid fa-circle-exclamation"></i> <%= error %></div><% } %>
    
    <% if (!glvList || !glvList.length) { %>
        <div class="tk-empty"><i class="fa-solid fa-chalkboard"></i><h2>Chưa có danh sách GLV</h2></div>
    <% } else { %>
        <!-- Form bọc toàn bộ bảng để submit 1 lần -->
        <form method="POST" action="/truong-khoi/phan-cong-glv/save-all">
            <input type="hidden" name="yearId" value="<%= selectedYearId %>">
            
            <section class="class-panel">
                <div class="class-panel-header">
                    <div><h2><i class="fa-solid fa-users"></i> Danh sách Huynh trưởng / Giáo lý viên</h2></div>
                    <button type="submit" class="action-button assign-action" style="padding: 8px 16px;"><i class="fa-solid fa-floppy-disk"></i> Lưu tất cả thay đổi</button>
                </div>
                <div class="table-scroll">
                    <table>
                        <thead>
                            <tr>
                                <th>Họ và tên GLV</th>
                                <th>Số điện thoại</th>
                                <th>Tình trạng</th>
                                <th>Phân công lớp</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% glvList.forEach(glv => { %>
                                <tr>
                                    <td><strong><%= [glv.ten_thanh, glv.ho_va_ten_lot, glv.ten].filter(Boolean).join(' ') %></strong></td>
                                    <td><%= glv.sdt || '-' %></td>
                                    <td><span class="status <%= glv.trang_thai === 'Đang hoạt động' ? 'is-active' : 'is-inactive' %>"><%= glv.trang_thai %></span></td>
                                    <td>
                                        <!-- Dùng name là dạng mảng hoặc object key theo id_glv để nhận dữ liệu ở Controller -->
                                        <select name="assignments[<%= glv.id_glv %>]" aria-label="Chọn lớp cho GLV">
                                            <option value="">-- Chưa phân công --</option>
                                            <% classes.forEach(c => { %>
                                                <!-- Chỉ hiển thị tên lớp c.ten_lop -->
                                                <option value="<%= c.id_lop %>" <%= glv.assigned_class_id === c.id_lop ? 'selected' : '' %>><%= c.ten_lop %></option>
                                            <% }) %>
                                        </select>
                                    </td>
                                    <td>
                                        <button type="button" class="action-button detail-button" data-id="<%= glv.id_glv %>"><i class="fa-solid fa-eye"></i> Xem</button>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
                <div style="margin-top: 15px; text-align: right;">
                    <button type="submit" class="action-button assign-action" style="padding: 10px 20px;"><i class="fa-solid fa-floppy-disk"></i> Lưu tất cả thay đổi</button>
                </div>
            </section>
        </form>
    <% } %>
</main>

<dialog class="tk-modal" id="glv-detail-modal"><div class="modal-heading"><h2 id="glv-detail-title">Chi tiết GLV</h2><button type="button" class="close-button" id="close-glv-detail">&times;</button></div><div class="modal-content" id="glv-detail-content">Đang tải dữ liệu...</div></dialog>

<script>
(() => {
    const yearId = '<%= selectedYearId || "" %>';
    const modal = document.getElementById('glv-detail-modal');
    const content = document.getElementById('glv-detail-content');
    const esc = value => String(value ?? '').replace(/[&<>'"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[c]));
    
    document.getElementById('close-glv-detail')?.addEventListener('click', () => modal.close());
    
    document.querySelectorAll('.detail-button').forEach(button => button.addEventListener('click', async () => {
        modal.showModal(); 
        content.textContent = 'Đang tải dữ liệu...';
        
        try { 
            const response = await fetch(`/truong-khoi/phan-cong-glv/${button.dataset.id}/detail?nien_khoa=${yearId}`); 
            const data = await response.json(); 
            if (!response.ok) throw new Error(data.error); 
            
            document.getElementById('glv-detail-title').textContent = [data.ten_thanh, data.ho_va_ten_lot, data.ten].filter(Boolean).join(' '); 
            
            let formattedDob = '-';
            if (data.ngay_sinh) {
                const dateStr = String(data.ngay_sinh).slice(0, 10);
                const parts = dateStr.split('-');
                if (parts.length === 3) {
                    formattedDob = `${parts[2]}/${parts[1]}/${parts[0]}`;
                }
            }

            content.innerHTML = `
                <div class="detail-grid">
                    <div><span>Ngày sinh</span><strong>${esc(formattedDob)}</strong></div>
                    <div><span>Giới tính</span><strong>${esc(data.gioi_tinh || '-')}</strong></div>
                    <div><span>Số điện thoại</span><strong>${esc(data.sdt || '-')}</strong></div>
                    <div><span>Tình trạng</span><strong>${esc(data.trang_thai || '-')}</strong></div>
                    <div><span>Lớp đang dạy</span><strong>${esc(data.ten_lop ? `${data.ten_khoi} - ${data.ten_lop}` : 'Chưa phân công')}</strong></div>
                </div>`; 
        } catch (error) { 
            content.textContent = error.message || 'Không thể tải thông tin GLV.'; 
        }
    }));
})();
</script>