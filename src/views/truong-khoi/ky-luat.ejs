<link rel="stylesheet" href="/css/reset.css">
<link rel="stylesheet" href="/css/truong-khoi/truong-khoi-ky-luat.css">

<main class="tk-class-page">
    <header class="tk-class-header">
        <div>
            <p class="eyebrow"><i class="fa-solid fa-scale-balanced"></i> Theo dõi kỷ luật</p>
            <label for="discipline-search"><i class="fa-solid fa-magnifying-glass"></i> Tìm thiếu nhi</label>
            <input id="discipline-search" class="tk-search" type="search" placeholder="Nhập tên hoặc mã số..." autocomplete="off">
            <h1>Điểm kỷ luật toàn khối</h1>
        </div>
    </header>

    <% if (!hasData) { %>
        <div class="tk-empty">
            <i class="fa-solid fa-file-circle-question"></i>
            <h2>Chưa có điểm kỷ luật</h2>
            <p>Niên khóa này chưa có dữ liệu trong khối.</p>
        </div>
    <% } else { %>
        <form class="tk-filter" method="GET" action="/truong-khoi/ky-luat">
            <label for="month-filter"><i class="fa-solid fa-filter"></i> Tháng</label>
            <select id="month-filter" name="thang" onchange="this.form.submit()">
                <option value="">Tất cả tháng</option>
                <% for (let month = 1; month <= 12; month += 1) { %>
                    <option value="<%= month %>" <%= month === selectedMonth ? 'selected' : '' %>>Tháng <%= month %></option>
                <% } %>
            </select>
        </form>
        <% if (!discipline.length) { %>
            <div class="tk-empty">
                <i class="fa-solid fa-filter-circle-xmark"></i>
                <h2>Không có kết quả phù hợp</h2>
                <p>Tháng đang chọn chưa có dữ liệu điểm kỷ luật.</p>
            </div>
        <% } else { %>
            <div class="class-panel">
            <div class="table-scroll">
                <table>
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th>Mã số</th>
                            <th>Họ và tên</th>
                            <th>Lớp</th>
                            <th>Tháng</th>
                            <th>Điểm kỷ luật</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% discipline.forEach((item, index) => { %>
                            <tr data-discipline-row data-search="<%= `${item._fullName || ''} ${item.mstn || ''}`.toLowerCase() %>">
                                <td><%= index + 1 %></td>
                                <td><%= item.mstn || '-' %></td>
                                <td>
                                    <strong><%= item._fullName %></strong>
                                </td>
                                <td><%= item.ten_lop || '-' %></td>
                                <td>Tháng <%= item.thang %></td>
                                <td>
                                    <strong><%= item.diem ?? '-' %></strong>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            </div>
            <div class="tk-no-results" id="discipline-no-results" hidden>
                <i class="fa-solid fa-user-slash"></i>
                Không tìm thấy thiếu nhi phù hợp.
            </div>
        <% } %>
    <% } %>
</main>

<script>
(() => {
    const search = document.getElementById('discipline-search');
    const rows = document.querySelectorAll('[data-discipline-row]');
    const empty = document.getElementById('discipline-no-results');
    const normalize = value => String(value || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');

    search?.addEventListener('input', () => {
        const keyword = normalize(search.value.trim());
        let visibleCount = 0;
        rows.forEach(row => {
            const visible = !keyword || normalize(row.dataset.search).includes(keyword);
            row.hidden = !visible;
            if (visible) visibleCount += 1;
        });
        if (empty) empty.hidden = visibleCount > 0;
    });
})();
</script>