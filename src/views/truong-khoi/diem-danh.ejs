<link rel="stylesheet" href="/css/reset.css">
<link rel="stylesheet" href="/css/truong-khoi/truong-khoi-diem-danh.css">

<main class="tk-class-page">
    <header class="tk-class-header">
        <div>
            <p class="eyebrow"><i class="fa-solid fa-calendar-check"></i> Theo dõi chuyên cần</p>
            <h1>Chi tiết điểm danh toàn khối</h1>
            <p>Tổng hợp dữ liệu điểm danh của tất cả thiếu nhi trong toàn khối.</p>
        </div>
    </header>

    <% if (!attendance || !attendance.length) { %>
        <div class="tk-empty">
            <i class="fa-solid fa-calendar-xmark"></i>
            <h2>Chưa có dữ liệu điểm danh</h2>
            <p>Niên khóa này chưa có buổi điểm danh trong khối.</p>
        </div>
    <% } else { %>
        <%
            const statusMeta = {
                'Đi sớm': { label: 'Đi sớm', className: 'is-early', icon: 'fa-circle-check' },
                'Có mặt': { label: 'Có mặt', className: 'is-present', icon: 'fa-circle' },
                'Vắng có phép': { label: 'Vắng có phép', className: 'is-excused', icon: 'fa-circle-exclamation' },
                'Vắng không phép': { label: 'Vắng không phép', className: 'is-absent', icon: 'fa-circle-xmark' }
            };
        %>

        <section class="attendance-summary-wrap">
            <div class="tk-search-wrap">
                <label for="attendance-search"><i class="fa-solid fa-magnifying-glass"></i> Tìm thiếu nhi</label>
                <input id="attendance-search" class="tk-search" type="search" placeholder="Nhập tên hoặc mã số..." autocomplete="off">
            </div>
            <div class="date-filter-bar" aria-label="Bộ lọc ngày điểm danh">
                <% dateGroups.forEach((group) => { %>
                    <button class="date-filter" data-filter="<%= group.filterKey %>" type="button">
                        <%= group.label %> · <%= group.sessionType || 'Buổi học' %>
                    </button>
                <% }) %>
            </div>
        </section>

        <section class="attendance-shell">
            <div class="list-panel">
                <% dateGroups.forEach((group) => { %>
                    <section class="session-group" data-pagination-group data-pagination-visible="true" data-filter-key="<%= group.filterKey %>" data-date="<%= group.dateKey %>" data-session="<%= group.sessionType || 'Buổi học' %>">
                        <header class="session-group-header">
                            <div>
                                <p class="session-date"><%= group.label %></p>
                                <p class="session-meta"><%= group.items.length %> thiếu nhi</p>
                            </div>
                            <span class="session-tag"><%= group.sessionType || group.items[0]?.loai_buoi || 'Buổi học' %></span>
                        </header>

                        <div class="attendance-card-list">
                            <% group.items.forEach((item) => {
                                const badge = statusMeta[item._status] || { label: item._status || 'Chưa xác định', className: 'is-unknown', icon: 'fa-circle-question' };
                            %>
                                <article class="attendance-card" data-attendance-card data-search="<%= `${item._fullName || ''} ${item.mstn || ''}`.toLowerCase() %>">
                                    <div class="card-top">
                                        <div class="student-head">
                                            <p class="student-name"><%= item._fullName %></p>
                                            <p class="student-sub"><%= item.ten_lop || 'Chưa có lớp' %> · Mã <%= item.mstn || '-' %></p>
                                        </div>
                                        <span class="status-badge <%= badge.className %>">
                                            <i class="fa-solid <%= badge.icon %>"></i>
                                            <%= badge.label %>
                                        </span>
                                    </div>

                                    <div class="card-bottom">
                                        <span><i class="fa-regular fa-calendar"></i> <%= item._dateLabel %></span>
                                        <span><i class="fa-solid fa-people-roof"></i> <%= item.loai_buoi || 'Chưa xác định' %></span>
                                    </div>
                                </article>
                            <% }) %>
                        </div>
                    </section>
                <% }) %>
            </div>

        </section>
        <%- include('../partials/pagination', {
            mode: 'client',
            currentPage: 1,
            totalPages: Math.max(Math.ceil(attendance.length / 25), 1),
            totalItems: attendance.length,
            pageSize: 25,
            rows: '[data-attendance-card]',
            groups: '[data-pagination-group]'
        }) %>
        <div class="tk-no-results" id="attendance-no-results" hidden>
            <i class="fa-solid fa-user-slash"></i>
            Không tìm thấy thiếu nhi phù hợp.
        </div>
    <% } %>
</main>

<script src="/js/truong-khoi/truong-khoi-diem-danh.js" defer></script>