<link rel="stylesheet" href="/css/reset.css">
<link rel="stylesheet" href="/css/truong-khoi/truong-khoi-diem-danh.css">

<main class="tk-class-page">
    <header class="tk-class-header">
        <div>
            <p class="eyebrow"><i class="fa-solid fa-calendar-check"></i> Theo dõi chuyên cần</p>
            <h1>Chi tiết điểm danh toàn khối</h1>
            <p>Tổng hợp dữ liệu điểm danh của tất cả thiếu nhi trong toàn khối.</p>
        </div>
    </header>

    <% if (!attendance || !attendance.length) { %>
        <div class="tk-empty">
            <i class="fa-solid fa-calendar-xmark"></i>
            <h2>Chưa có dữ liệu điểm danh</h2>
            <p>Niên khóa này chưa có buổi điểm danh trong khối.</p>
        </div>
    <% } else { %>
        <%
            const statusMeta = {
                'Đi sớm': { label: 'Đi sớm', className: 'is-early', icon: 'fa-circle-check' },
                'Có mặt': { label: 'Có mặt', className: 'is-present', icon: 'fa-circle' },
                'Vắng có phép': { label: 'Vắng có phép', className: 'is-excused', icon: 'fa-circle-exclamation' },
                'Vắng không phép': { label: 'Vắng không phép', className: 'is-absent', icon: 'fa-circle-xmark' }
            };
        %>

        <section class="attendance-summary-wrap">
            <div class="date-filter-bar" aria-label="Bộ lọc ngày điểm danh">
                <button class="date-filter is-active" data-filter="all" type="button">Tất cả</button>
                <% dateGroups.forEach((group) => { %>
                    <button class="date-filter" data-filter="<%= group.dateKey %>" type="button">
                        <%= group.label %>
                    </button>
                <% }) %>
            </div>

            <div class="summary-grid">
                <div class="summary-card summary-card--primary">
                    <span class="summary-label">Tổng lượt điểm danh</span>
                    <strong><%= attendanceStats.total %></strong>
                </div>
                <div class="summary-card summary-card--present">
                    <span class="summary-label">Có mặt</span>
                    <strong><%= attendanceStats.present %></strong>
                </div>
                <div class="summary-card summary-card--excused">
                    <span class="summary-label">Vắng có phép</span>
                    <strong><%= attendanceStats.excused %></strong>
                </div>
                <div class="summary-card summary-card--absent">
                    <span class="summary-label">Vắng không phép</span>
                    <strong><%= attendanceStats.absent %></strong>
                </div>
            </div>
        </section>

        <section class="attendance-shell">
            <div class="list-panel">
                <% dateGroups.forEach((group) => { %>
                    <section class="session-group" data-date="<%= group.dateKey %>">
                        <header class="session-group-header">
                            <div>
                                <p class="session-date"><%= group.label %></p>
                                <p class="session-meta"><%= group.items.length %> thiếu nhi</p>
                            </div>
                            <span class="session-tag"><%= group.items[0]?.loai_buoi || 'Buổi học' %></span>
                        </header>

                        <div class="attendance-card-list">
                            <% group.items.forEach((item) => {
                                const badge = statusMeta[item._status] || { label: item._status || 'Chưa xác định', className: 'is-unknown', icon: 'fa-circle-question' };
                            %>
                                <article class="attendance-card">
                                    <div class="card-top">
                                        <div class="student-head">
                                            <p class="student-name"><%= item._fullName %></p>
                                            <p class="student-sub"><%= item.ten_lop || 'Chưa có lớp' %> · Mã <%= item.mstn || '-' %></p>
                                        </div>
                                        <span class="status-badge <%= badge.className %>">
                                            <i class="fa-solid <%= badge.icon %>"></i>
                                            <%= badge.label %>
                                        </span>
                                    </div>

                                    <div class="card-bottom">
                                        <span><i class="fa-regular fa-calendar"></i> <%= item._dateLabel %></span>
                                        <span><i class="fa-solid fa-people-roof"></i> <%= item.loai_buoi || 'Chưa xác định' %></span>
                                    </div>
                                </article>
                            <% }) %>
                        </div>
                    </section>
                <% }) %>
            </div>

            <div class="desktop-panel">
                <div class="class-panel">
                    <div class="table-scroll">
                        <table>
                            <thead>
                                <tr>
                                    <th>Ngày</th>
                                    <th>Buổi</th>
                                    <th>Lớp</th>
                                    <th>Đi sớm</th>
                                    <th>Có mặt</th>
                                    <th>Vắng có phép</th>
                                    <th>Vắng không phép</th>
                                    <th>Tổng</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% attendanceSummary.forEach((row) => { %>
                                    <tr>
                                        <td><%= row.dateLabel %></td>
                                        <td><%= row.loai_buoi %></td>
                                        <td><%= row.ten_lop || '-' %></td>
                                        <td><span class="mini-pill is-early"><%= row['Đi sớm'] %></span></td>
                                        <td><span class="mini-pill is-present"><%= row['Có mặt'] %></span></td>
                                        <td><span class="mini-pill is-excused"><%= row['Vắng có phép'] %></span></td>
                                        <td><span class="mini-pill is-absent"><%= row['Vắng không phép'] %></span></td>
                                        <td><strong><%= row.total %></strong></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </section>
    <% } %>
</main>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const filterButtons = document.querySelectorAll('.date-filter');
        const groups = document.querySelectorAll('.session-group');

        const updateFilters = (selectedDate) => {
            filterButtons.forEach((button) => {
                button.classList.toggle('is-active', button.dataset.filter === selectedDate);
            });

            groups.forEach((group) => {
                const shouldShow = selectedDate === 'all' || group.dataset.date === selectedDate;
                group.style.display = shouldShow ? 'block' : 'none';
            });
        };

        filterButtons.forEach((button) => {
            button.addEventListener('click', function () {
                updateFilters(this.dataset.filter);
            });
        });
    });
</script>