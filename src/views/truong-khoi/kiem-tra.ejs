<link rel="stylesheet" href="/css/reset.css">
<link rel="stylesheet" href="/css/truong-khoi/truong-khoi-kiem-tra.css">

<main class="tk-class-page">
    <header class="tk-class-header">
        <div>
            <p class="eyebrow"><i class="fa-solid fa-clipboard-check"></i> Kết quả học tập</p>
            <h1>Điểm kiểm tra toàn khối</h1>
        </div>
    </header>

    <% if (!scores || !scores.length) { %>
        <div class="tk-empty">
            <i class="fa-solid fa-clipboard-question"></i>
            <h2>Chưa có điểm kiểm tra</h2>
            <p>Niên khóa này chưa có dữ liệu điểm trong khối.</p>
        </div>
    <% } else { %>
        <div class="class-panel">
            <div class="table-scroll">
                <table>
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th>Mã số</th>
                            <th>Họ và tên</th>
                            <th>Lớp</th>
                            <th>Bài kiểm tra</th>
                            <th>Điểm</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% scores.forEach((item, index) => { %>
                            <tr>
                                <td><%= index + 1 %></td>
                                <td><%= item.mstn || '-' %></td>
                                <td>
                                    <strong><%= item._fullName %></strong>
                                </td>
                                <td><%= item.ten_lop || '-' %></td>
                                <td>Bài <%= item.stt_bai_ktra %></td>
                                <td>
                                    <strong><%= item.diem_so ?? '-' %></strong>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    <% } %>
</main>