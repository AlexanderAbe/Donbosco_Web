<link rel="stylesheet" href="/css/reset.css">
<link rel="stylesheet" href="/css/truong-khoi/truong-khoi-kiem-tra.css">

<main class="tk-class-page">
    <header class="tk-class-header">
        <div>
            <p class="eyebrow"><i class="fa-solid fa-clipboard-check"></i> Kết quả học tập</p>
            <label for="score-search"><i class="fa-solid fa-magnifying-glass"></i> Tìm thiếu nhi</label>
            <input id="score-search" class="tk-search" type="search" placeholder="Nhập tên hoặc mã số..." autocomplete="off">
            <h1>Điểm kiểm tra toàn khối</h1>
        </div>
    </header>

    <% if (!hasData) { %>
        <div class="tk-empty">
            <i class="fa-solid fa-clipboard-question"></i>
            <h2>Chưa có điểm kiểm tra</h2>
            <p>Niên khóa này chưa có dữ liệu điểm trong khối.</p>
        </div>
    <% } else { %>
        <form class="tk-filter" method="GET" action="/truong-khoi/kiem-tra">
            <label for="exam-filter"><i class="fa-solid fa-filter"></i> Bài kiểm tra</label>
            <select id="exam-filter" name="bai_kiem_tra" onchange="this.form.submit()">
                <option value="">Tất cả bài kiểm tra</option>
                <% examNumbers.forEach(number => { %>
                    <option value="<%= number %>" <%= number === selectedExam ? 'selected' : '' %>>Bài kiểm tra <%= number %></option>
                <% }) %>
            </select>
        </form>
        <% if (!scores.length) { %>
            <div class="tk-empty">
                <i class="fa-solid fa-filter-circle-xmark"></i>
                <h2>Không có kết quả phù hợp</h2>
                <p>Bài kiểm tra đang chọn chưa có dữ liệu điểm.</p>
            </div>
        <% } else { %>
            <div class="class-panel">
            <div class="table-scroll">
                <table>
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th>Mã số</th>
                            <th>Họ và tên</th>
                            <th>Lớp</th>
                            <th>Bài kiểm tra</th>
                            <th>Điểm</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% scores.forEach((item, index) => { %>
                            <tr data-score-row data-search="<%= `${item._fullName || ''} ${item.mstn || ''}`.toLowerCase() %>">
                                <td><%= index + 1 %></td>
                                <td><%= item.mstn || '-' %></td>
                                <td>
                                    <strong><%= item._fullName %></strong>
                                </td>
                                <td><%= item.ten_lop || '-' %></td>
                                <td>Bài <%= item.stt_bai_ktra %></td>
                                <td>
                                    <strong><%= item.diem_so ?? '-' %></strong>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            </div>
            <div class="tk-no-results" id="score-no-results" hidden>
                <i class="fa-solid fa-user-slash"></i>
                Không tìm thấy thiếu nhi phù hợp.
            </div>
        <% } %>
    <% } %>
</main>

<script>
(() => {
    const search = document.getElementById('score-search');
    const rows = document.querySelectorAll('[data-score-row]');
    const empty = document.getElementById('score-no-results');
    const normalize = value => String(value || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');

    search?.addEventListener('input', () => {
        const keyword = normalize(search.value.trim());
        let visibleCount = 0;
        rows.forEach(row => {
            const visible = !keyword || normalize(row.dataset.search).includes(keyword);
            row.hidden = !visible;
            if (visible) visibleCount += 1;
        });
        if (empty) empty.hidden = visibleCount > 0;
    });
})();
</script>