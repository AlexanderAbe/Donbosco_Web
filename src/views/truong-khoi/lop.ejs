<link rel="stylesheet" href="/css/reset.css">
<link rel="stylesheet" href="/css/truong-khoi/truong-khoi-lop.css">
<link rel="stylesheet" href="/css/student-profile-modal.css">
<div class="tk-toast" id="tk-toast" role="status" aria-live="polite" hidden></div>
<div id="page-data" data-year="<%= selectedYearId || '' %>" data-classes='<%- JSON.stringify(classes.map(item => ({ id_lop: item.id_lop, ten_lop: item.ten_lop }))) %>' style="display:none;"></div>
<main class="tk-class-page">
    <header class="tk-class-header">
        <div>
            <p class="eyebrow"><i class="fa-solid fa-school"></i> Quản lý lớp học</p>
        </div>
        <button type="button" class="primary-button add-student-button" id="open-create-student" <%= selectedYearId && classes.length ? '' : 'disabled' %>><i class="fa-solid fa-user-plus"></i> Thêm thiếu nhi</button>
    </header>

    <% if (error) { %><div class="tk-alert"><i class="fa-solid fa-circle-exclamation"></i> <%= error %></div><% } %>
    <% if (!classes.length) { %>
        <div class="tk-empty"><i class="fa-solid fa-people-roof"></i><h2>Chưa có lớp trong khối</h2><p>Niên khóa này chưa có lớp hoặc bạn chưa được phân công khối.</p></div>
    <% } else { %>
        <div class="class-filter-bar">
            <div class="class-filter-field class-search-field">
                <label for="student-search"><i class="fa-solid fa-magnifying-glass"></i> Tìm thiếu nhi</label>
                <input id="student-search" type="search" placeholder="Nhập tên hoặc mã số..." autocomplete="off">
            </div>
            <div class="class-filter-field class-buttons-field">
                <span class="class-filter-label"><i class="fa-solid fa-filter"></i> Lọc theo lớp</span>
                <div class="class-filter-buttons" aria-label="Lọc theo lớp">
                    <button class="class-filter-button is-active" type="button" data-class-filter="all">Tất cả</button>
                    <% classes.forEach(classItem => { %>
                        <button class="class-filter-button" type="button" data-class-filter="<%= classItem.id_lop %>"><%= classItem.ten_lop %></button>
                    <% }) %>
                </div>
            </div>
        </div>
        <div class="class-filter-empty" id="class-filter-empty" hidden>
            <i class="fa-solid fa-user-slash"></i>
            Không tìm thấy thiếu nhi phù hợp.
        </div>
        <section class="class-panel all-students-panel" id="all-students-panel" data-pagination-group data-pagination-visible="true">
            <div class="class-panel-header">
                <div><p class="class-label">Danh sách toàn khối</p><h2><i class="fa-solid fa-users"></i> Tất cả thiếu nhi</h2></div>
                <span class="student-count"><%= allStudents.length %> thiếu nhi</span>
            </div>
            <div class="table-scroll">
                <table>
                    <thead><tr><th>STT</th><th>Mã số</th><th>Họ và tên</th><th>Lớp</th><th>Ngày sinh</th><th>Giới tính</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
                    <tbody>
                        <% allStudents.forEach((student, index) => { %>
                            <tr data-student-row data-search="<%= `${student._fullName || ''} ${student.mstn || ''}`.toLowerCase() %>">
                                <td><%= index + 1 %></td>
                                <td><%= student.mstn || '-' %></td>
                                <td><strong><%= student._fullName %></strong></td>
                                <td><%= student.ten_lop || '-' %></td>
                                <td><%= student._dobDisplay %></td>
                                <td><%= student.gioi_tinh || '-' %></td>
                                <td><span class="status <%= student.trang_thai === 'Đang học' ? 'is-active' : 'is-inactive' %>"><%= student.trang_thai %></span></td>
                                <td class="actions">
                                    <button type="button" class="action-button detail-button" data-id="<%= student.id_tn %>"><i class="fa-solid fa-eye"></i> Chi tiết</button>
                                    <button type="button" class="action-button status-button" data-id="<%= student.id_tn %>" data-status="<%= student.trang_thai %>"><i class="fa-solid fa-rotate"></i> Đổi trạng thái</button>
                                    <button type="button" class="action-button transfer-button" data-id="<%= student.id_tn %>" data-class="<%= student.id_lop %>"><i class="fa-solid fa-arrow-right-arrow-left"></i> Chuyển lớp</button>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </section>
        <div class="class-grid">
            <% classes.forEach(classItem => { %>
                <section class="class-panel" data-class-panel data-pagination-group data-pagination-visible="false" data-class-id="<%= classItem.id_lop %>">
                    <div class="class-panel-header">
                        <div><p class="class-label"><%= classItem.ten_khoi %></p><h2><i class="fa-solid fa-chalkboard"></i> <%= classItem.ten_lop %></h2></div>
                        <span class="student-count"><%= classItem.student_count %> thiếu nhi</span>
                    </div>
                    <% if (!classItem.students.length) { %>
                        <div class="table-empty">Lớp chưa có danh sách thiếu nhi.</div>
                    <% } else { %>
                        <div class="table-scroll">
                            <table>
                                <thead><tr><th>STT</th><th>Mã số</th><th>Họ và tên</th><th>Ngày sinh</th><th>Giới tính</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
                                <tbody>
                                    <% classItem.students.forEach((student, index) => { %>
                                        <tr data-student-row data-search="<%= `${student._fullName || ''} ${student.mstn || ''}`.toLowerCase() %>">
                                            <td><%= index + 1 %></td>
                                            <td><%= student.mstn || '-' %></td>
                                            <td><strong><%= student._fullName %></strong></td>
                                            <td><%= student._dobDisplay %></td>
                                            <td><%= student.gioi_tinh || '-' %></td>
                                            <td><span class="status <%= student.trang_thai === 'Đang học' ? 'is-active' : 'is-inactive' %>"><%= student.trang_thai %></span></td>
                                            <td class="actions">
                                                <button type="button" class="action-button detail-button" data-id="<%= student.id_tn %>"><i class="fa-solid fa-eye"></i> Chi tiết</button>
                                                <button type="button" class="action-button status-button" data-id="<%= student.id_tn %>" data-status="<%= student.trang_thai %>"><i class="fa-solid fa-rotate"></i> Đổi trạng thái</button>
                                                <button type="button" class="action-button transfer-button" data-id="<%= student.id_tn %>" data-class="<%= classItem.id_lop %>"><i class="fa-solid fa-arrow-right-arrow-left"></i> Chuyển lớp</button>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } %>
                </section>
            <% }) %>
        </div>
        <%- include('../partials/pagination', {
            mode: 'client',
            currentPage: 1,
            totalPages: Math.max(Math.ceil(allStudents.length / 25), 1),
            totalItems: allStudents.length,
            pageSize: 25,
            rows: '[data-student-row]',
            groups: '[data-pagination-group]'
        }) %>
    <% } %>
</main>

<%- include('../partials/student-profile-modal', {
    modalClass: 'tk-modal',
    modalId: 'detail-modal',
    bodyId: 'detail-content',
    titleId: 'detail-title',
    modalElement: 'dialog',
    showHistory: false,
    allowEdit: true,
    closeClass: 'secondary-button'
}) %>

<dialog class="tk-modal create-student-modal" id="create-student-modal">
    <form id="create-student-form">
        <div class="modal-heading"><h2>Thêm thiếu nhi mới</h2><button type="button" class="close-button" data-close="create-student-modal">&times;</button></div>
        <div class="modal-content create-form-content">
            <input type="hidden" name="yearId" value="<%= selectedYearId || '' %>">
            <section class="form-section"><h3>Thông tin thiếu nhi</h3><div class="form-grid">
                <label>Tên thánh<input name="ten_thanh" maxlength="50"></label><label>Họ và tên lót<input name="ho_va_ten_lot" maxlength="100" required></label><label>Tên<input name="ten" maxlength="50" required></label><label>Giới tính<select name="gioi_tinh" required><option value="">Chọn giới tính</option><option>Nam</option><option>Nữ</option></select></label><label>Ngày sinh<input name="ngay_sinh" type="date" required></label><label>Mã số thiếu nhi<input name="mstn" maxlength="20" placeholder="Để trống để tự tạo"></label><label class="wide-field">Địa chỉ<input name="dia_chi" maxlength="255" required></label><label class="wide-field">Lớp<select name="id_lop" required><option value="">Chọn lớp</option><% classes.forEach(item => { %><option value="<%= item.id_lop %>"><%= item.ten_khoi %> - <%= item.ten_lop %></option><% }) %></select></label>
            </div></section>
            <section class="form-section"><h3>Thông tin phụ huynh <small>(ít nhất 1 người)</small></h3><div class="repeat-form-grid">
                <% [1, 2].forEach(index => { %><div class="repeat-form-row"><strong>Phụ huynh <%= index %></strong><input data-parent="<%= index %>" data-field="ten_ph" placeholder="Họ tên" <%= index === 1 ? 'required' : '' %>><select data-parent="<%= index %>" data-field="moi_quan_he"><option>Cha</option><option>Mẹ</option><option>Ông</option><option>Bà</option><option>Cô</option><option>Chú</option><option>Bác</option><option>Người giám hộ</option></select><input data-parent="<%= index %>" data-field="sdt" placeholder="Số điện thoại" pattern="[0-9]{9,15}" <%= index === 1 ? 'required' : '' %>></div><% }) %>
            </div></section>
            <section class="form-section"><h3>Bí tích <small>(nếu đã lãnh nhận)</small></h3><div class="repeat-form-grid">
                <% [1, 2, 3].forEach(index => { %><div class="repeat-form-row"><strong>Bí tích <%= index %></strong><select data-sacrament="<%= index %>" data-field="loai_bi_tich"><option value="">Chưa nhập</option><option>Rửa tội</option><option>Xưng tội & Rước lễ</option><option>Thêm sức</option></select><input data-sacrament="<%= index %>" data-field="ngay_lanh_nhan" type="date"></div><% }) %>
            </div></section><p class="modal-error" id="create-student-error"></p>
        </div><div class="modal-actions"><button type="button" class="secondary-button" data-close="create-student-modal">Hủy</button><button type="submit" class="primary-button"><i class="fa-solid fa-floppy-disk"></i> Lưu thiếu nhi</button></div>
    </form>
</dialog>

<dialog class="tk-modal" id="status-modal">
    <div class="modal-heading"><h2>Đổi trạng thái học</h2><button type="button" class="close-button" data-close="status-modal">&times;</button></div>
    <div class="modal-content"><label for="status-value">Trạng thái mới</label><select id="status-value"><option>Đang học</option><option>Chuyển xứ</option><option>Nghỉ học</option></select><p class="modal-error" id="status-error"></p></div>
    <div class="modal-actions"><button type="button" class="secondary-button" data-close="status-modal">Hủy</button><button type="button" class="primary-button" id="save-status">Lưu trạng thái</button></div>
</dialog>

<dialog class="tk-modal" id="transfer-modal">
    <div class="modal-heading"><h2>Chuyển thiếu nhi sang lớp</h2><button type="button" class="close-button" data-close="transfer-modal">&times;</button></div>
    <div class="modal-content"><label for="target-class">Lớp mới</label><select id="target-class"></select><p class="modal-error" id="transfer-error"></p></div>
    <div class="modal-actions"><button type="button" class="secondary-button" data-close="transfer-modal">Hủy</button><button type="button" class="primary-button" id="save-transfer">Chuyển lớp</button></div>
</dialog>

<script src="/js/truong-khoi/truong-khoi-lop.js" defer></script>