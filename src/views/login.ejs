<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng Nhập - Quản Lý Thiếu Nhi</title>
    <link rel="icon" type="image/png" href="/imgs/Logo.png">

    <!-- Lưu ý: Trong Express, file tĩnh đặt trong thư mục public nên đường dẫn bắt đầu bằng dấu / -->
    <link rel="stylesheet" href="/css/login.css" />
    <link rel="stylesheet" href="/css/reset.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
</head>
<body class="login-page">
    <div class="login-card">
        <!-- Logo Khối tròn -->
        <div class="logo-wrapper">
            <img
                src="/imgs/Logo.png"
                alt="Logo Don Bosco"
                onerror="this.src='https://via.placeholder.com/90'"
            />
        </div>

        <!-- Form action đổi thành POST /login để xử lý ở Backend -->
        <form class="login-form" action="/auth/login" method="POST">

            <!-- Đoạn code hiển thị lỗi (nếu có) -->
            <% if (locals.error) { %>
                <div style="background-color: #f8d7da; color: #721c24; padding: 10px; border-radius: 5px; margin-bottom: 15px; font-size: 14px; text-align: center;">
                    <i class="fa-solid fa-triangle-exclamation"></i> <%= error %>
                </div>
            <% } %>

            <!-- Số điện thoại -->
            <div class="form-group">
                <label for="phone">Số điện thoại</label>
                <div class="input-wrapper">
                    <i class="fa-solid fa-phone input-icon"></i>
                    <input
                        type="tel"
                        id="phone"
                        name="phone"
                        placeholder="Nhập số điện thoại"
                        required
                    />
                </div>
            </div>

            <!-- Mật khẩu -->
            <div class="form-group">
                <label for="password">Mật khẩu</label>
                <div class="input-wrapper">
                    <i class="fa-solid fa-lock input-icon"></i>
                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Nhập mật khẩu"
                        required
                    />
                </div>
            </div>

            <!-- Nút Đăng nhập -->
            <button type="submit" class="btn-login">Đăng nhập</button>
            
            <!-- Quên mật khẩu -->
            <div class="forgot-pass-container">
                <a href="/auth/forgot-password" class="forgot-link">Quên mật khẩu?</a>
            </div>
        </form>
    </div>
</body>
</html>