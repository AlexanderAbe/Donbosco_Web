<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đổi mật khẩu - Hệ thống Xứ Đoàn Don Bosco</title>
    <link rel="icon" type="image/png" href="/imgs/Logo.png">
    <!-- Liên kết file CSS riêng biệt cho trang đổi mật khẩu -->
    <link rel="stylesheet" href="/css/change-password.css">
    <!-- FontAwesome cho Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>

    <!-- Toast thông báo hệ thống (nếu có) -->
    <%- include('partials/toast') %>

    <!-- Container bọc ngoài quản lý căn giữa bố cục -->
    <div class="auth-page-wrapper">
        <main class="auth-card">
            
            <!-- Header trang kèm Icon nhận diện -->
            <header class="auth-header">
                <div class="auth-icon-box">
                    <i class="fa-solid fa-key"></i>
                </div>
                <h1>Đổi mật khẩu</h1>
                <p>Vui lòng nhập mật khẩu hiện tại để bảo mật tài khoản.</p>
            </header>

            <!-- Form Đổi mật khẩu -->
            <form action="/auth/change-password" method="POST" class="auth-form">
                
                <!-- Mật khẩu hiện tại -->
                <div class="form-group">
                    <label for="currentPassword">Mật khẩu hiện tại</label>
                    <div class="input-wrapper">
                        <input type="password" id="currentPassword" name="currentPassword" placeholder="••••••••" required />
                        <button type="button" class="toggle-password" data-target="currentPassword" aria-label="Hiện/Ẩn mật khẩu">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                    </div>
                </div>

                <!-- Mật khẩu mới -->
                <div class="form-group">
                    <label for="newPassword">Mật khẩu mới</label>
                    <div class="input-wrapper">
                        <input type="password" id="newPassword" name="newPassword" placeholder="••••••••" required />
                        <button type="button" class="toggle-password" data-target="newPassword" aria-label="Hiện/Ẩn mật khẩu">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                    </div>
                    <span class="input-hint">Mật khẩu tối thiểu 8 ký tự, bao gồm chữ và số.</span>
                </div>

                <!-- Xác nhận mật khẩu mới -->
                <div class="form-group">
                    <label for="confirmPassword">Xác nhận mật khẩu mới</label>
                    <div class="input-wrapper">
                        <input type="password" id="confirmPassword" name="confirmPassword" placeholder="••••••••" required />
                        <button type="button" class="toggle-password" data-target="confirmPassword" aria-label="Hiện/Ẩn mật khẩu">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                    </div>
                </div>

                <!-- Nút xác nhận (CTA Button) -->
                <button type="submit" class="btn-submit">
                    <i class="fa-solid fa-check"></i> Xác nhận đổi mật khẩu
                </button>
                
                <!-- Quay lại -->
                <div class="form-footer-action">
                    <a href="javascript:history.back()" class="btn-back">
                        <i class="fa-solid fa-arrow-left"></i> Quay lại trang trước
                    </a>
                </div>
            </form>

            <!-- Chân trang nhận diện -->
            <footer class="auth-footer">
                <p>Hệ thống quản lý nội bộ • Xứ Đoàn Don Bosco</p>
            </footer>

        </main>
    </div>

    <!-- Script xử lý ẩn/hiện mật khẩu thông minh (Tự động ẩn sau 3 giây) -->
    <script src="/js/change-password.js" defer></script>
</body>
</html>