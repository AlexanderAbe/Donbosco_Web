<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title != 'undefined' ? title : 'Quản lý điểm - Xứ Đoàn Don Bosco' %></title>
    <!-- File CSS chung của bạn -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <!-- HEADER CHÍNH CỦA BẠN -->
    <header class="header">
        <div class="header-left">
          <div class="logo-circle">
            <img src="./imgs/Logo.png" alt="Logo" onerror="this.src='https://via.placeholder.com/42'">
          </div>
          <div class="church-info">
            <h2>Xứ Đoàn Don Bosco</h2>
            <p>Giáo xứ Tân Thái Sơn</p>
          </div>
        </div>

        <div class="header-center">
          <div class="mode-switch-group">
            <button class="mode-btn" data-mode="manage">Quản lý Thiếu Nhi</button>
            <button class="mode-btn active" data-mode="input">Nhập điểm</button>
            <button class="mode-btn" data-mode="export">Xuất file</button>
          </div>
        </div>

        <div class="header-right">
          <button class="switch-btn">switch</button>
        </div>
    </header>

    <!-- NƠI NỘI DUNG CÁC TRANG CON (Nhập điểm, Xuất file, Quản lý...) SẼ ĐỔ VÀO ĐÂY -->
    <main class="main-container">
        <%- body %>
    </main>

    <!-- FOOTER CHUNG (Tùy chọn) -->
    <footer class="footer" style="text-align: center; padding: 15px; background: #f4f4f4; margin-top: 20px;">
        <p>&copy; 2026 - Xứ Đoàn Don Bosco | Giáo xứ Tân Thái Sơn</p>
    </footer>

    <!-- File JS frontend -->
    <script src="/js/main.js"></script>
</body>
</html>