<!-- Font Awesome CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<link rel="stylesheet" href="/css/reset.css">
<link rel="stylesheet" href="/css/glv/glv-diem-danh.css">

<main class="attendance-page">
    <header class="class-header">
        <span class="class-eyebrow"><i class="fa-solid fa-layer-group"></i> Quản lý lớp học</span>
        <h1>Điểm danh thiếu nhi</h1>
    </header>

    <% if (message) { %><div class="attendance-notice success"><i class="fa-solid fa-circle-check"></i> <%= message %></div><% } %>
    <% if (error) { %><div class="attendance-notice error"><i class="fa-solid fa-circle-exclamation"></i> <%= error %></div><% } %>

    <% if (!classes.length) { %>
        <div class="attendance-empty"><i class="fa-solid fa-triangle-exclamation"></i> Bạn chưa được phân công lớp trong niên khóa này.</div>
    <% } else { %>
        <form class="attendance-toolbar" method="GET" action="/glv/diem-danh" id="attendance-filter">
            <div class="attendance-field">
                <label for="attendance-search"><i class="fa-solid fa-magnifying-glass"></i> Tìm kiếm thiếu nhi</label>
                <input id="attendance-search" type="search" placeholder="Tên hoặc mã số..." autocomplete="off">
            </div>
            <div class="attendance-field">
                <label for="attendance-type"><i class="fa-solid fa-clock"></i> Loại buổi</label>
                <select id="attendance-type" name="loai_buoi" required>
                    <% if (!sessionTypes.length) { %>
                        <option value="">Ngày không khớp lịch</option>
                    <% } %>
                    <% sessionTypes.forEach(type => { %>
                        <option value="<%= type %>" <%= type === sessionType ? 'selected' : '' %>><%= type %></option>
                    <% }) %>
                </select>
            </div>
            <div class="attendance-field">
                <label for="attendance-date"><i class="fa-solid fa-calendar-day"></i> Ngày điểm danh</label>
                <input id="attendance-date" type="date" name="ngay_diem_danh" value="<%= selectedDate %>" required>
            </div>
            <button class="attendance-save-button" type="submit"><i class="fa-solid fa-filter"></i> Xem danh sách</button>
        </form>

        <form method="POST" action="/glv/diem-danh/save">
            <input type="hidden" name="nien_khoa" value="<%= selectedYearId %>">
            <input type="hidden" name="id_lop" value="<%= selectedClassId %>">
            <input type="hidden" name="loai_buoi" value="<%= sessionType %>">
            <input type="hidden" name="ngay_diem_danh" value="<%= selectedDate %>">
            
            <div class="attendance-summary">
                <span><i class="fa-solid fa-circle-info"></i> <strong><%= classes.find(item => item.id_lop === selectedClassId)?.ten_lop %></strong> · <%= sessionType || 'Chưa chọn loại buổi' %> · <strong><%= selectedDate %></strong></span>
                <button class="attendance-save-button" type="submit" <%= !sessionType ? 'disabled' : '' %>><i class="fa-solid fa-floppy-disk"></i> Lưu điểm danh</button>
            </div>

            <% if (!students.length) { %>
                <div class="attendance-empty"><i class="fa-solid fa-user-slash"></i> Lớp chưa có thiếu nhi đang học.</div>
            <% } else { %>
                <div class="attendance-table-wrap">
                    <table class="attendance-table">
                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Mã TN</th>
                                <th>Tên Thánh & Họ Tên</th>
                                <th>Trạng thái</th>
                                <th>Điểm danh</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% students.forEach((student, index) => { %>
                                <tr data-attendance-row data-search="<%= `${student.mstn || ''} ${student.ten_thanh || ''} ${student.ho_va_ten_lot || ''} ${student.ten || ''}`.toLowerCase() %>">
                                    <td><%= index + 1 %></td>
                                    <td><%= student.mstn || '-' %></td>
                                    <td><strong><%= [student.ten_thanh, student.ho_va_ten_lot, student.ten].filter(Boolean).join(' ') %></strong></td>
                                    <td class="attendance-status <%= student.trang_thai === 'Đang học' ? '' : 'inactive' %>"><%= student.trang_thai %></td>
                                    <td>
                                        <fieldset class="attendance-options">
                                            <legend class="visually-hidden">Trạng thái điểm danh</legend>
                                            <label><input type="radio" name="attendance[<%= index %>][trang_thai]" value="Có mặt" <%= student.da_luu && student.trang_thai_diem_danh === 'Có mặt' ? 'checked' : '' %>><span>Có mặt</span></label>
                                            <label><input type="radio" name="attendance[<%= index %>][trang_thai]" value="Đi sớm" <%= student.da_luu && student.trang_thai_diem_danh === 'Đi sớm' ? 'checked' : '' %>><span>Đi sớm</span></label>
                                            <label><input type="radio" name="attendance[<%= index %>][trang_thai]" value="Vắng phép" <%= student.da_luu && student.trang_thai_diem_danh === 'Vắng phép' ? 'checked' : '' %>><span>Vắng phép</span></label>
                                            <label><input type="radio" name="attendance[<%= index %>][trang_thai]" value="Vắng không phép" <%= student.da_luu && student.trang_thai_diem_danh === 'Vắng không phép' ? 'checked' : '' %>><span>Vắng không phép</span></label>
                                        </fieldset>
                                        <input type="hidden" name="attendance[<%= index %>][id_tn]" value="<%= student.id_tn %>">
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </form>
    <% } %>
</main>

<script>
(() => {
    const search = document.getElementById('attendance-search');
    const type = document.getElementById('attendance-type');
    const date = document.getElementById('attendance-date');
    const filter = document.getElementById('attendance-filter');
    const targetDays = { 'Lễ Thứ 3': 2, 'Lễ Thứ 5': 4, 'Lễ Chúa Nhật': 0, 'Học Giáo Lý': 0 };
    const smartDate = sessionType => { const current = new Date(); current.setDate(current.getDate() - ((current.getDay() - targetDays[sessionType] + 7) % 7)); return `${current.getFullYear()}-${String(current.getMonth() + 1).padStart(2, '0')}-${String(current.getDate()).padStart(2, '0')}`; };
    type?.addEventListener('change', () => { date.value = smartDate(type.value); filter.submit(); });
    date?.addEventListener('change', () => { filter.submit(); });
    search?.addEventListener('input', () => { const keyword = search.value.trim().toLowerCase(); document.querySelectorAll('[data-attendance-row]').forEach(row => { row.hidden = keyword && !row.dataset.search.includes(keyword); }); });
})();
</script>