<% 
    const s = (typeof stats !== 'undefined' && stats) ? stats : { totalGlv: 0, glvDangDay: 0, glvChuaPhanCong: 0, totalThieuNhi: 0 };
%>

<div class="stats-grid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 25px;">
    
    <!-- 1. Tổng GLV -->
    <div class="card p-3 shadow-sm d-flex align-items-center flex-row">
        <div class="stat-icon p-3 bg-light rounded" style="font-size: 1.5rem; color: #3498db;">
            <i class="fa-solid fa-chalkboard-user"></i>
        </div>
        <div class="stat-info ms-3">
            <h6 class="text-muted mb-0">Tổng GLV</h6>
            <h4 class="mb-0"><%= s.totalGlv %></h4>
        </div>
    </div>

    <!-- 2. GLV Đang giảng dạy -->
    <div class="card p-3 shadow-sm d-flex align-items-center flex-row">
        <div class="stat-icon p-3 bg-light rounded" style="font-size: 1.5rem; color: #2ecc71;">
            <i class="fa-solid fa-user-check"></i>
        </div>
        <div class="stat-info ms-3">
            <h6 class="text-muted mb-0">GLV Đang dạy</h6>
            <h4 class="mb-0"><%= s.glvDangDay %></h4>
        </div>
    </div>

    <!-- 3. GLV Chưa phân công -->
    <div class="card p-3 shadow-sm d-flex align-items-center flex-row">
        <div class="stat-icon p-3 bg-light rounded" style="font-size: 1.5rem; color: #e74c3c;">
            <i class="fa-solid fa-user-clock"></i>
        </div>
        <div class="stat-info ms-3">
            <h6 class="text-muted mb-0">Chưa phân công</h6>
            <h4 class="mb-0 <%= s.glvChuaPhanCong > 0 ? 'text-danger' : 'text-success' %>">
                <%= s.glvChuaPhanCong %>
            </h4>
        </div>
    </div>

    <!-- 4. Tổng Thiếu nhi -->
    <div class="card p-3 shadow-sm d-flex align-items-center flex-row">
        <div class="stat-icon p-3 bg-light rounded" style="font-size: 1.5rem; color: #f1c40f;">
            <i class="fa-solid fa-child-reaching"></i>
        </div>
        <div class="stat-info ms-3">
            <h6 class="text-muted mb-0">Tổng Thiếu nhi</h6>
            <h4 class="mb-0"><%= s.totalThieuNhi %></h4>
        </div>
    </div>
</div>
