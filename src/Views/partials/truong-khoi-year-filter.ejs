<form method="GET" action="<%= action %>" class="year-filter"><label for="truong-khoi-year">Niên khóa</label><select id="truong-khoi-year" name="nien_khoa" onchange="this.form.submit()"><% years.forEach(year => { %><option value="<%= year.id_cau_hinh_nam_hoc %>" <%= year.id_cau_hinh_nam_hoc === selectedYearId ? 'selected' : '' %>><%= year.nien_khoa %></option><% }) %></select></form>