<% 
    // Hỗ trợ linh hoạt tên biến: nhận 'logs' hoặc 'recentLogs' từ Controller truyền vào
    const logList = typeof logs !== 'undefined' ? logs : (typeof recentLogs !== 'undefined' ? recentLogs : []);
%>

<div class="table-responsive">
    <table class="data-table">
        <thead>
            <tr>
                <th>Thời gian</th>
                <th>Người thực hiện</th>
                <th>Hành động chi tiết</th>
                <th>Trạng thái</th>
            </tr>
        </thead>
        <tbody>
            <% if (logList && logList.length > 0) { %>
                <% logList.forEach(log => { %>
                    <tr>
                        <td data-label="Thời gian"><%= new Date(log.created_at).toLocaleString('vi-VN') %></td>
                        <td data-label="Người thực hiện">
                            <b>
                                <!-- Tận dụng cột ho_ten gộp sẵn từ view vw_tai_khoan_glv -->
                                <%= log.ho_ten || 'Hệ thống / Vãng lai' %>
                            </b>
                            <% if (log.username) { %>
                                <br><small style="color: var(--text-muted, #718096);">(@<%= log.username %>)</small>
                            <% } %>
                        </td>
                        <td data-label="Hành động chi tiết"><%= log.action %></td>
                        <td data-label="Trạng thái">
                            <span class="badge <%= log.status === 'Thành công' ? 'success' : 'error' %>">
                                <%= log.status %>
                            </span>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="4" style="text-align: center; color: var(--text-muted, #718096); padding: 20px;">
                        Chưa có nhật ký hoạt động nào gần đây.
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>