<link rel="stylesheet" href="/css/admin-logs.css">
<link rel="stylesheet" href="/css/reset.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="container-fluid py-4">
    <div class="section-card">
        <!-- Phần tiêu đề và nút quay lại -->
        <div class="card-header-flex">
            <div>
                <h2>Toàn bộ Nhật ký hoạt động hệ thống</h2>
                <p style="color: #718096; font-size: 13px; margin-top: 4px;">
                    Hiển thị lịch sử thao tác (Trang <%= currentPage %> / <%= totalPages %>)
                </p>
            </div>
            <a href="/admin" class="view-all-link">
                <i class="fa-solid fa-arrow-left"></i> Quay lại Dashboard
            </a>
        </div>

        <!-- FORM LỌC -->
        <form method="GET" action="" class="filter-form">
            <input type="hidden" name="limit" value="<%= limit %>">

            <div class="filter-group">
                <label for="log-search"><i class="fa-solid fa-user"></i> Tên hoặc số điện thoại:</label>
                <input id="log-search" type="search" name="search" value="<%= search %>" class="form-control" placeholder="Nhập tên hoặc số điện thoại">
            </div>
            
            <div class="filter-group">
                <label><i class="fa-regular fa-calendar-days"></i> Từ ngày:</label>
                <input type="date" name="from" value="<%= fromDate %>" class="form-control">
            </div>
            
            <div class="filter-group">
                <label><i class="fa-regular fa-calendar-check"></i> Đến ngày:</label>
                <input type="date" name="to" value="<%= toDate %>" class="form-control">
            </div>
            
            <div class="filter-actions">
                <button type="submit" class="btn-filter">
                    <i class="fa-solid fa-filter"></i> Lọc dữ liệu
                </button>
                <% if (fromDate || toDate || search) { %>
                    <a href="?limit=<%= limit %>" class="btn-reset">
                        <i class="fa-solid fa-rotate-left"></i> Xóa lọc
                    </a>
                <% } %>
            </div>
        </form>

        <!-- BẢNG DỮ LIỆU -->
        <%- include('../partials/audit-logs-table', { logs: logs }) %>

        <!-- THANH PHÂN TRANG -->
        <div class="pagination-container">
            <div class="pagination-info">
                Tổng cộng có <b><%= totalPages %></b> trang hiển thị.
            </div>
            <div class="pagination-nav">
                <% if (currentPage > 1) { %>
                    <a href="?page=<%= currentPage - 1 %>&limit=<%= limit %>&from=<%= fromDate %>&to=<%= toDate %>&search=<%= encodeURIComponent(search) %>" class="page-btn">
                        <i class="fa-solid fa-chevron-left"></i> Trước
                    </a>
                <% } %>

                <span class="page-current"><%= currentPage %></span>

                <% if (currentPage < totalPages) { %>
                    <a href="?page=<%= currentPage + 1 %>&limit=<%= limit %>&from=<%= fromDate %>&to=<%= toDate %>&search=<%= encodeURIComponent(search) %>" class="page-btn">
                        Sau <i class="fa-solid fa-chevron-right"></i>
                    </a>
                <% } %>
            </div>
        </div>
    </div>
</div>