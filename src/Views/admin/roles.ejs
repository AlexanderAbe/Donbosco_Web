<link rel="stylesheet" href="/css/reset.css">
<link rel="stylesheet" href="/css/admin/admin-role.css">

<div class="dashboard-container">
    <div class="page-header" style="margin-bottom: 24px;">
        <h1>Quản lý Phân quyền Hệ thống</h1>
        <p>Phân chia quyền Quản trị viên và Ban Điều Hành cho các Giáo lý viên</p>
    </div>
    <%- include('../partials/toast') %>
    <div class="section-card">
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>ID GLV</th>
                        <th>Họ và tên</th>
                        <th>Tình trạng</th>
                        <th>Tên đăng nhập / SĐT</th>
                        <th style="text-align: center;">Quản trị viên (Admin)</th>
                        <th style="text-align: center;">Ban Điều Hành (BDH)</th>
                        <th style="text-align: center;">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (users && users.length > 0) { %>
                        <% users.forEach(user => { %>
                            <form action="/admin/roles/update/<%= user.id_glv %>" method="POST">
                                <tr>
                                    <td data-label="ID GLV">#<%= user.id_glv %></td>
                                    <td data-label="Họ và tên"><b><%= user.ho_ten || (user.ho_va_ten_lot + ' ' + user.ten) %></b></td>
                                    <td data-label="Tình trạng"><%= user.trang_thai || 'Đang hoạt động' %></td>
                                    <td data-label="Tên đăng nhập / SĐT"><%= user.username || 'Chưa có tài khoản' %></td>
                                    
                                    <!-- Checkbox Quản trị viên -->
                                    <td data-label="Quản trị viên (Admin)" style="text-align: center;">
                                        <input type="checkbox" name="is_admin" value="true" <%= user.is_admin ? 'checked' : '' %> <%= user.id_tk ? '' : 'disabled' %> style="width: 18px; height: 18px; cursor: pointer;">
                                        <% if (!user.id_tk) { %><small style="display: block; color: #718096;">Chưa có tài khoản</small><% } %>
                                    </td>

                                    <!-- Checkbox Ban Điều Hành -->
                                    <td data-label="Ban Điều Hành (BDH)" style="text-align: center;">
                                        <input type="checkbox" name="is_bdh" value="true" <%= user.is_bdh ? 'checked' : '' %> <%= user.id_tk ? '' : 'disabled' %> style="width: 18px; height: 18px; cursor: pointer;">
                                        <% if (!user.id_tk) { %><small style="display: block; color: #718096;">Chưa có tài khoản</small><% } %>
                                    </td>

                                    <!-- Nút Lưu -->
                                    <td data-label="Hành động" style="text-align: center;">
                                        <button type="submit" style="background: #10b981; color: white; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer; font-weight: 500;">
                                            <i class="fa-solid fa-floppy-disk"></i> Lưu
                                        </button>
                                    </td>
                                </tr>
                            </form>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="7" style="text-align: center; padding: 24px; color: #718096;">Không có dữ liệu giáo lý viên nào.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>