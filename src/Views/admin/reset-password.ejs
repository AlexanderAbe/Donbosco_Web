<div class="dashboard-container" style="max-width: 500px; margin: 40px auto;">
    <div class="section-card">
        <h2>Đổi mật khẩu tài khoản</h2>
        <p style="color: #64748b; margin-bottom: 20px;">
            Đang đổi mật khẩu cho tài khoản: <b><%= targetUser.username %></b> (<%= targetUser.ho_ten || 'Chưa cập nhật tên' %>)
        </p>
        
        <form action="/admin/users/reset-password/<%= targetUser.id_tk %>" method="POST">
            <div style="margin-bottom: 16px;">
                <label style="display: block; margin-bottom: 6px; font-weight: 500;">Mật khẩu mới:</label>
                <input type="password" name="newPassword" required placeholder="Nhập mật khẩu mới..."
                       style="width: 100%; padding: 10px 12px; border: 1px solid #cbd5e1; border-radius: 8px; outline: none;">
            </div>
            
            <div style="display: flex; gap: 12px; align-items: center;">
                <button type="submit" class="action-btn" style="background-color: #2563eb; color: white; border: none; padding: 10px 18px; border-radius: 8px; cursor: pointer; font-weight: 600;">
                    Xác nhận đổi
                </button>
                <a href="/admin/users" style="padding: 10px 18px; background-color: #e2e8f0; color: #334155; text-decoration: none; border-radius: 8px; font-weight: 500;">
                    Hủy bỏ
                </a>
            </div>
        </form>
    </div>
</div>