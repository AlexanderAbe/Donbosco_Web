<link rel="stylesheet" href="/css/reset.css">
<link rel="stylesheet" href="/css/truong-khoi/truong-khoi-kiem-tra.css">

<main class="tk-class-page">
    <header class="tk-class-header">
        <div>
            <p class="eyebrow"><i class="fa-solid fa-clipboard-check"></i> Kết quả học tập</p>
            <h1>Điểm kiểm tra toàn khối</h1>
        </div>
    </header>

    <% if (!scores || !scores.length) { %>
        <div class="tk-empty">
            <i class="fa-solid fa-clipboard-question"></i>
            <h2>Chưa có điểm kiểm tra</h2>
            <p>Niên khóa này chưa có dữ liệu điểm trong khối.</p>
        </div>
    <% } else { %>
        <% 
            // Sắp xếp mảng scores theo tên thiếu nhi (A-Z)
            const sortedScores = [...scores].sort((a, b) => {
                const nameA = (a.ten || '').trim().toLowerCase();
                const nameB = (b.ten || '').trim().toLowerCase();
                if (nameA !== nameB) {
                    return nameA.localeCompare(nameB, 'vi');
                }
                const hoA = (a.ho_va_ten_lot || '').trim().toLowerCase();
                const hoB = (b.ho_va_ten_lot || '').trim().toLowerCase();
                return hoA.localeCompare(hoB, 'vi');
            });
        %>

        <div class="class-panel">
            <div class="table-scroll">
                <table>
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th>Mã số</th>
                            <th>Họ và tên</th>
                            <th>Lớp</th>
                            <th>Bài kiểm tra</th>
                            <th>Điểm</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% sortedScores.forEach((item, index) => { %>
                            <tr>
                                <td><%= index + 1 %></td>
                                <td><%= item.mstn || '-' %></td>
                                <td>
                                    <strong><%= [item.ten_thanh, item.ho_va_ten_lot, item.ten].filter(Boolean).join(' ') %></strong>
                                </td>
                                <td><%= item.ten_lop || '-' %></td>
                                <td>Bài <%= item.stt_bai_ktra %></td>
                                <td>
                                    <strong><%= item.diem_so ?? '-' %></strong>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    <% } %>
</main>