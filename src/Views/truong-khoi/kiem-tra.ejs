<link rel="stylesheet" href="/css/reset.css">
<link rel="stylesheet" href="/css/truong-khoi/truong-khoi-lop.css">

<main class="tk-class-page"><header class="tk-class-header"><div><p class="eyebrow"><i class="fa-solid fa-clipboard-check"></i> Kết quả học tập</p><h1>Điểm kiểm tra</h1><p>Chỉ xem điểm kiểm tra của thiếu nhi trong khối.</p></div></header>
<% if (!scores.length) { %><div class="tk-empty"><i class="fa-solid fa-clipboard-question"></i><h2>Chưa có điểm kiểm tra</h2><p>Niên khóa này chưa có dữ liệu điểm trong khối.</p></div><% } else { const classes = []; scores.forEach(item => { let group = classes.find(value => value.id_lop === item.id_lop); if (!group) { group = { id_lop: item.id_lop, ten_lop: item.ten_lop, ten_khoi: item.ten_khoi, rows: [] }; classes.push(group); } group.rows.push(item); }); %><div class="class-grid"><% classes.forEach(classItem => { %><section class="class-panel"><div class="class-panel-header"><div><p class="class-label"><%= classItem.ten_khoi %></p><h2><i class="fa-solid fa-school"></i> <%= classItem.ten_lop %></h2></div></div><div class="table-scroll"><table><thead><tr><th>STT</th><th>Mã số</th><th>Họ và tên</th><th>Bài kiểm tra</th><th>Điểm</th></tr></thead><tbody><% classItem.rows.forEach((item, index) => { %><tr><td><%= index + 1 %></td><td><%= item.mstn || '-' %></td><td><strong><%= [item.ten_thanh, item.ho_va_ten_lot, item.ten].filter(Boolean).join(' ') %></strong></td><td>Bài <%= item.stt_bai_ktra %></td><td><strong><%= item.diem_so ?? '-' %></strong></td></tr><% }) %></tbody></table></div></section><% }) %></div><% } %></main>
