<link rel="stylesheet" href="/css/reset.css">
<link rel="stylesheet" href="/css/truong-khoi/truong-khoi-diem-danh.css">

<main class="tk-class-page">
    <header class="tk-class-header">
        <div>
            <p class="eyebrow"><i class="fa-solid fa-calendar-check"></i> Theo dõi chuyên cần</p>
            <h1>Chi tiết điểm danh toàn khối</h1>
            <p>Tổng hợp dữ liệu điểm danh của tất cả thiếu nhi trong toàn khối.</p>
        </div>
    </header>

    <% if (!attendance || !attendance.length) { %>
        <div class="tk-empty">
            <i class="fa-solid fa-calendar-xmark"></i>
            <h2>Chưa có dữ liệu điểm danh</h2>
            <p>Niên khóa này chưa có buổi điểm danh trong khối.</p>
        </div>
    <% } else { %>
        <% 
            // Sắp xếp mảng attendance theo tên thiếu nhi (A-Z)
            const sortedAttendance = [...attendance].sort((a, b) => {
                const nameA = (a.ten || '').trim().toLowerCase();
                const nameB = (b.ten || '').trim().toLowerCase();
                if (nameA !== nameB) {
                    return nameA.localeCompare(nameB, 'vi');
                }
                const hoA = (a.ho_va_ten_lot || '').trim().toLowerCase();
                const hoB = (b.ho_va_ten_lot || '').trim().toLowerCase();
                return hoA.localeCompare(hoB, 'vi');
            });
        %>

        <div class="class-panel">
            <div class="table-scroll">
                <table>
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th>Mã số</th>
                            <th>Họ và tên</th>
                            <th>Lớp</th>
                            <th>Buổi điểm danh</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% sortedAttendance.forEach((item, index) => { %>
                            <tr>
                                <td><%= index + 1 %></td>
                                <td><%= item.mstn || '-' %></td>
                                <td>
                                    <strong><%= [item.ten_thanh, item.ho_va_ten_lot, item.ten].filter(Boolean).join(' ') %></strong>
                                </td>
                                <td><%= item.ten_lop || '-' %></td>
                                <td>
                                    <%= item.loai_buoi %> · <%= item.ngay_diem_danh ? new Date(item.ngay_diem_danh).toLocaleDateString('vi-VN') : '-' %>
                                </td>
                                <td>
                                    <span class="status <%= ['Có mặt', 'Đi sớm'].includes(item.trang_thai) ? 'is-active' : 'is-inactive' %>">
                                        <%= item.trang_thai %>
                                    </span>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    <% } %>
</main>